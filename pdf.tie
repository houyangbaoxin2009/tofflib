type tie<class>
// pdf.tie —— PDF 1.4 生成器（tofflib 模块，纯 tie）
// ============================================================
// 职责：把「文档树」渲染为**可直接打开的 PDF 字节流**，纯 tie 实现、零外部依赖
// （除语言底座原语与本库内的 TTF 解析模块）。
//
// 设计要点
// ---------
// * **全 ASCII 输出**：PDF 的一切语法（对象/流/xref/trailer）本身就是 ASCII；
//   正文文本一律以**十六进制字符串**（`<....>`）写入内容流——于是除嵌入的字体
//   二进制外，整份 PDF 都是 ASCII。这带来两个好处：
//     1) 生成期的字节偏移可用 `str_len` 直接算（ASCII 下码点数==字节数）；
//     2) 文本无需任何转义（PDF 字符串转义规则完全绕开）。
// * **字节偏移显式累进**：xref 要求每个对象的**精确字节偏移**。本模块用一个
//   显式计数器 `g_off` 累进（ASCII 段加 `str_len`，二进制字体段加已知字节数），
//   不依赖对整份文档做扫描。
// * **分文件**：本文件 = 核心装配（对象/页/内容流/xref）；字体与 TTF 解析在
//   `pdf_ttf.tie`（CIDFontType2 + Identity-H，嵌入完整 TTF，故渲染不依赖阅读器
//   是否装有 CJK 字体）。

import "./pdf_ttf.tie"

// ---------- 文档状态（顶层 var 由本文件持有；分文件同 namespace 共享）----------

var g_off: i64 = 0;          // 当前字节偏移（累进）
var g_dry: i64 = 0;          // 干跑开关（1 = 抑制内容输出，页面仍推进）
var g_objs: table<string>;   // 对象体（下标 0 起 = 对象 1）
var g_pages: table<string>;  // 每页内容流
var g_w: i64 = 595;          // A4 宽（pt）
var g_h: i64 = 842;          // A4 高（pt）

// ---------- 数字 → ASCII ----------
// 整数转十进制（PDF 只接受 ASCII 数字，不依赖 locale）。

namespace pdf {

pub func i2s(v: i64) -> string {
    if v == 0 {
        return "0"
    }
    var neg = false
    var x = v
    if x < 0 {
        neg = true
        x = 0 - x
    }
    var s = ""
    while x > 0 {
        s = str_from_code(48 + (x % 10)) + s
        x = x / 10
    }
    if neg {
        return "-" + s
    }
    return s
}

// 定点小数（PDF 坐标用，1/100 pt 精度）。
pub func f2s(v: i64) -> string {
    var ip = v / 100
    var fp = v % 100
    if fp < 0 {
        fp = 0 - fp
    }
    if fp < 10 {
        return i2s(ip) + ".0" + i2s(fp)
    }
    return i2s(ip) + "." + i2s(fp)
}

// ---------- 十六进制 ----------
func hexd(v: i64) -> string {
    var d = v & 15
    if d < 10 {
        return str_from_code(48 + d)
    }
    return str_from_code(97 + d - 10)
}

// 字节 → 两位十六进制
pub func hex2(b: i64) -> string {
    return hexd((b / 16) & 15) + hexd(b & 15)
}

// 字节表 → 十六进制串（内容流里的文本用；每元素 1 字节 = 2 位十六进制）
pub func hex_bytes(bs: table<i64>) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < len(bs) {
        sb_append(sb, hex2(bs[i]))
        i = i + 1
    }
    return sb_build(sb)
}

// GID 表 → 十六进制串。**每个 GID 必须是 2 字节大端**（Identity-H 的编码单位），
// 即 4 位十六进制。
//
// RCA（2026-09-27，本模块最严重的一处缺陷）：最初这里复用了 hex_bytes，结果每个
// GID 只写出 1 字节（低字节），既丢高位又让字节流错位——文本全部指向错误字形，
// 产物是**完全空白的白纸**，而 xref 结构自检一路通过（它只验结构不验内容）。
// 教训有两层：
//   1) Identity-H 下「字符数 × 2 = 字节数」是硬约束，写 1 字节必错；
//   2) 结构自检不足以证明「看得见」，必须另有一条**内容自检**（见 pdf_asm 的
//      verify：逐 GID 校验其存在性）。
// ---------- 对象与内容流 ----------
// 登记一个对象（返回其编号 = 下标+1）。
func add_obj(body: string) -> i64 {
    table_push(g_objs, body)
    return len(g_objs)
}

// 转义（对象体不用，但路径/元数据里偶尔需要，保留完整实现防误用）
pub func esc(s: string) -> string {
    var sb = string_builder()
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        if c == "\\" || c == "(" || c == ")" {
            sb_append(sb, "\\")
        }
        sb_append(sb, c)
        i = i + 1
    }
    return sb_build(sb)
}

// ---------- 页面 ----------
pub func begin_doc(w: i64, h: i64) {
    g_w = w
    g_h = h
    g_off = 0
    g_objs = table_new_string()
    g_pages = table_new_string()
}

// 取指定页的内容流文本（自检/调试用）
pub func page_raw(i: i64) -> string {
    if i < 0 || i >= len(g_pages) {
        return ""
    }
    return g_pages[i]
}

// 新增一页，返回页序号（0 起）。内容流由调用方用 text_at 追加。
pub func add_page() -> i64 {
    table_push(g_pages, "")
    return len(g_pages) - 1
}

// 在当前页的内容流尾部追加原始命令（内部用；调用方一般用 text_at/line_at）。
// 在当前页的内容流尾部追加原始命令。干跑模式下丢弃。
pub func raw(page: i64, cmd: string) {
    if g_dry == 1 {
        return
    }
    g_pages[page] = g_pages[page] + cmd
}

// 干跑开关：抑制内容输出但页面照常推进（目录页码预扫用）
pub func dry_on() { g_dry = 1 }
pub func dry_off() { g_dry = 0 }

// 在 (x,y) 处以字号 size 写出**整形后的文本**（可跨多款字体）。
//
// 整形结果 sh 的格式见 pdf_ttf.shape：若干 (槽, GID 数, GID...) 段。
// 每一段切入对应字体对象并写一个 Tj——同一行里因此可以混排等宽与中文。
//
// 颜色必须显式设置：fill_rect 设置的是非描边色且会持续生效，近白底纹若留在
// 状态里，其后正文就会用近白色绘制（看起来就是白纸）。故此处一律显式置黑。
// 黑色文本（正文默认）
pub func text_shaped(page: i64, x: i64, y: i64, size_pt_x100: i64, sh: table<i64>) -> i64 {
    return text_shaped_c(page, x, y, size_pt_x100, sh, 0, 0, 0)
}

// 带颜色的整形文本输出。颜色分量 0-255（书写直觉），内部换算到 PDF 的 0-1。
// 语法高亮即靠逐词元调用本函数着色。
pub func text_shaped_c(page: i64, x: i64, y: i64, size_pt_x100: i64, sh: table<i64>, cr: i64, cg: i64, cb: i64) -> i64 {
    // Tf 需要「字体名 + 字号」两个操作数，故字体名在首段一并给出
    var cmd = f2s(cr * 100 / 255) + " " + f2s(cg * 100 / 255) + " " + f2s(cb * 100 / 255) + " rg BT\n"
    var i: i64 = 0
    var first = true
    while i + 1 < len(sh) {
        var slot = sh[i]
        var cnt = sh[i + 1]
        var sb = string_builder()
        var k: i64 = 0
        while k < cnt {
            var g = sh[i + 2 + k]
            if g < 0 {
                g = 0
            }
            // 记录该槽实际用到的字形（供按槽生成宽度数组）
            note_gid(slot, g)
            sb_append(sb, hex2((g / 256) & 255))
            sb_append(sb, hex2(g & 255))
            k = k + 1
        }
        // 第一段用 Td 定位，后续段用 Td 推进（简化：每段各自绝对定位由调用方保证）
        if first {
            cmd = cmd + "/F" + i2s(slot + 1) + " " + f2s(size_pt_x100) + " Tf " + i2s(x) + " " + i2s(y) +
                " Td <" + sb_build(sb) + "> Tj"
            first = false
        } else {
            // 切换字体不重置文本矩阵，故后续段自然接在上一段之后
            cmd = cmd + " /F" + i2s(slot + 1) + " " + f2s(size_pt_x100) + " Tf <" + sb_build(sb) + "> Tj"
        }
        i = i + 2 + cnt
    }
    cmd = cmd + " ET\n"
    raw(page, cmd)
    return 0
}

// 便捷入口：纯单字体文本（不整形；仅用于自检/调试）
pub func text_at(page: i64, x: i64, y: i64, size: i64, gids: table<i64>) -> i64 {
    return text_shaped(page, x, y, size * 100, gidgroups(0, gids))
}

// 把 GID 表包成单段整形结构（内部用）
func gidgroups(slot: i64, gids: table<i64>) -> table<i64> {
    var out = table_new_i64()
    table_push(out, slot)
    table_push(out, len(gids))
    var i: i64 = 0
    while i < len(gids) {
        table_push(out, gids[i])
        i = i + 1
    }
    return out
}

// 画一条水平线。线宽 w 以 **1/100 pt** 传入（如 80 = 0.8pt）——
// 与 f2s 的尺度一致；直接写 pt 整数会得到 "1.00" 与 "0.00"，后者线宽为零不可见。
pub func hline(page: i64, x1: i64, y: i64, x2: i64, w: i64) {
    raw(page, f2s(w) + " w " + i2s(x1) + " " + i2s(y) + " m " + i2s(x2) + " " + i2s(y) + " l S\n")
}

// 填充矩形（代码块/提示框底纹用）。
// 颜色分量按 **0-255** 传入（书写直觉），内部换算为 PDF 要求的 0-1：
// `v * 100 / 255` → 两位小数（如 244 → "0.95"）。曾直接写 `v * 100`，
// 得到 "244.00" 这种超出 [0,1] 的分量——阅读器会忽略该填充，底纹消失。
pub func fill_rect(page: i64, x: i64, y: i64, w: i64, h: i64, r: i64, g: i64, b: i64) {
    raw(page, f2s(r * 100 / 255) + " " + f2s(g * 100 / 255) + " " + f2s(b * 100 / 255) + " rg " +
        i2s(x) + " " + i2s(y) + " " + i2s(w) + " " + i2s(h) + " re f\n")
}

}

import "./pdf_asm.tie"
