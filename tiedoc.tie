type tie<class>
// ============================================================================
// tiedoc.tie：tofflib——tie 办公表达格式（tdoc）块协议构建库（class → tiedoc.a）
//
// tdoc = 一份用 tie 语言表达的办公文档源（自定义角色，见 roles.data.tie）：
//   文档即 tie 源码（可被 tiec 编译校验），内容为「块行」序列；
//   each 块 = table<string>（首个元素为 kind，即块类型，后随参数）。
//   本模块提供块构建函数（td.h1/td.p/td.tbl/…），渲染见同一模块的
//   render_docx/render_xlsx（C3 起）或直接消费 blocks 二次加工。
//
// 块协议 v1（kind 由构建函数产出）：
//   ["h1".."h9", text]  标题（对应 Word Heading1..9）
//   ["p", text]         段落
//   ["b", text]         加粗段落
//   ["center", text]    居中段落
//   ["ul", item, ...]   无序列表（多参=多条目）
//   ["ol", item, ...]   有序列表
//   ["tbl", header_csv, row_csv, ...]  表格（CSV 行；首行为表头）
//   ["page"]            分页
//   ["sec"]             分节（新节 + 换页）
//   ["link", text, url] 超链接
//   ["raw", xml]        OOXML 片段透传（高级）
//
// 文档文件写法（完全符合 tie 语法）：
//   type tie<tdoc>
//   namespace report {
//       pub func blocks() -> table<table<string>> {
//           var r0: table<string> = td.h1("周报")
//           var r1: table<string> = td.p("你好")
//           return [r0, r1]        // §表内表字面量受编译器限制，块行用变量/调用结果引用
//       }
//   }
//
// 纯函数、零 unsafe；依赖文档块协议与格式后端（docx/xlsx/…）——本文件只产块行。
// 命名空间：tiedoc。import "./tiedoc.tie" as td
// ============================================================================

import "./docx.tie" as dx
import "./ooxml.tie" as ox

namespace tiedoc {

// 标题：level 1..9（越界钳位），对应 Heading1..9。
pub func h(level: i64, txt: string) -> table<string> {
    var lv: i64 = level
    if lv < 1 {
        lv = 1
    }
    if lv > 9 {
        lv = 9
    }
    var row = table_new_string()
    table_push(row, "h" + i2s(lv))
    table_push(row, txt)
    return row
}

pub func h1(txt: string) -> table<string> { return h(1, txt) }
pub func h2(txt: string) -> table<string> { return h(2, txt) }
pub func h3(txt: string) -> table<string> { return h(3, txt) }
pub func h4(txt: string) -> table<string> { return h(4, txt) }
pub func h5(txt: string) -> table<string> { return h(5, txt) }
pub func h6(txt: string) -> table<string> { return h(6, txt) }
pub func h7(txt: string) -> table<string> { return h(7, txt) }
pub func h8(txt: string) -> table<string> { return h(8, txt) }
pub func h9(txt: string) -> table<string> { return h(9, txt) }

// 段落。
pub func p(txt: string) -> table<string> {
    return ["p", txt]
}

// 加粗段落。
pub func b(txt: string) -> table<string> {
    return ["b", txt]
}

// 居中段落。
pub func center(txt: string) -> table<string> {
    return ["center", txt]
}

// 无序列表（多条目）。
pub func ul(items: table<string>) -> table<string> {
    return list_blk("ul", items)
}

// 有序列表（多条目）。
pub func ol(items: table<string>) -> table<string> {
    return list_blk("ol", items)
}

// 表格：header_csv 为表头行（CSV），row_csvs 为后续数据行（CSV，可空表）。
pub func tbl(header_csv: string, row_csvs: table<string>) -> table<string> {
    var row = table_new_string()
    table_push(row, "tbl")
    table_push(row, header_csv)
    var i: i64 = 0
    while i < len(row_csvs) {
        table_push(row, row_csvs[i])
        i = i + 1
    }
    return row
}

// 分页。
pub func page() -> table<string> {
    return ["page"]
}

// 分节（新节并换页）。
pub func sec() -> table<string> {
    return ["sec"]
}

// 超链接。
pub func link(txt: string, url: string) -> table<string> {
    return ["link", txt, url]
}

// OOXML 片段透传（高级：直接给 Word 级 XML）。
pub func raw(xml: string) -> table<string> {
    return ["raw", xml]
}

// 列表块通用构建（kind 为 ul/ol）。
func list_blk(kind: string, items: table<string>) -> table<string> {
    var row = table_new_string()
    table_push(row, kind)
    var i: i64 = 0
    while i < len(items) {
        table_push(row, items[i])
        i = i + 1
    }
    return row
}

// i64 → 十进制字符串（模块自包含）。
func i2s(v: i64) -> string {
    if v == 0 {
        return "0"
    }
    var sb = string_builder()
    var neg = false
    var x: i64 = v
    if x < 0 {
        neg = true
        x = 0 - x
    }
    var digs = table_new_i64()
    while x > 0 {
        table_push(digs, x % 10)
        x = x / 10
    }
    if neg {
        sb_append(sb, "-")
    }
    var i: i64 = len(digs) - 1
    while i >= 0 {
        sb_append_byte(sb, 48 + digs[i])
        i = i - 1
    }
    return sb_build(sb)
}

// ---- 渲染：tdoc 块协议 → docx ----

// CSV 行解析（RFC 4180 子集）：逗号分隔；字段可被双引号包围（内部 " 翻倍转义），
// 引号包围的字段可含逗号/换行。返回字段表。
pub func csv_split(line: string) -> table<string> {
    var out = table_new_string()
    var sb = string_builder()
    var n: i64 = str_len(line)
    var in_q = false
    var i: i64 = 0
    while i < n {
        var c = str_char(line, i)
        if in_q {
            if c == "\"" {
                if i + 1 < n && str_char(line, i + 1) == "\"" {
                    sb_append(sb, "\"")
                    i = i + 1
                } else {
                    in_q = false
                }
            } else {
                sb_append(sb, c)
            }
        } else {
            if c == "\"" {
                in_q = true
            } else if c == "," {
                table_push(out, sb_build(sb))
                sb = string_builder()
            } else {
                sb_append(sb, c)
            }
        }
        i = i + 1
    }
    table_push(out, sb_build(sb))
    return out
}

// 单块 → docx XML 片段（kind 路由）。
func block_docx(row: table<string>) -> string {
    var kind = row[0]
    if kind == "h1" || kind == "h2" || kind == "h3" ||
        kind == "h4" || kind == "h5" || kind == "h6" ||
        kind == "h7" || kind == "h8" || kind == "h9" {
        return dx.heading(row[1], hlvl(kind))
    }
    if kind == "p" {
        return dx.paragraph(row[1])
    }
    if kind == "b" {
        var rr = table_new_string()
        table_push(rr, dx.run_font(row[1], "", 0, true))
        return dx.paragraph_runs(rr)
    }
    if kind == "center" {
        var rr = table_new_string()
        table_push(rr, dx.run(row[1]))
        return dx.para_center(rr)
    }
    if kind == "ul" {
        return list_to_docx(row, 1)
    }
    if kind == "ol" {
        return list_to_docx(row, 2)
    }
    if kind == "tbl" {
        return tbl_to_docx(row)
    }
    if kind == "page" {
        return dx.page_break()
    }
    if kind == "sec" {
        return dx.sect_a4()
    }
    if kind == "link" {
        return dx.link(row[1], row[2], "")
    }
    if kind == "raw" {
        return row[1]
    }
    // 未知块宽容处理：按段落输出原始行文本。
    var sb = string_builder()
    var j: i64 = 0
    while j < len(row) {
        if j > 0 {
            sb_append(sb, " ")
        }
        sb_append(sb, row[j])
        j = j + 1
    }
    return dx.paragraph(sb_build(sb))
}

// 标题 kind "hN" → N。
func hlvl(kind: string) -> i64 {
    return char_code(str_char(kind, 1)) - 48
}

// 列表块：kind 已校验；num_id 1=bullet 2=decimal；从第 2 个参数起为条目。
func list_to_docx(row: table<string>, num_id: i64) -> string {
    var sb = string_builder()
    var i: i64 = 1
    while i < len(row) {
        if num_id == 1 {
            sb_append(sb, dx.bullet(row[i], 0))
        } else {
            sb_append(sb, dx.number(row[i], 0))
        }
        i = i + 1
    }
    return sb_build(sb)
}

// 表格块：row[1] 表头 CSV，row[2..] 数据行 CSV → dx.tbl。
func tbl_to_docx(row: table<string>) -> string {
    var header = csv_split(row[1])
    var rows2: table<table<string>> = []
    var i: i64 = 2
    while i < len(row) {
        table_push(rows2, csv_split(row[i]))
        i = i + 1
    }
    return dx.tbl(rows2, header, 5000)
}

// 渲染整份 docx：title 作为首行 H1，覆盖全部块；写盘 ox.write_docx（无页脚）。
pub func render_docx(path: string, title: string, blocks: table<table<string>>) -> bool {
    var body = dx.heading(title, 1)
    var i: i64 = 0
    while i < len(blocks) {
        body = body + block_docx(blocks[i])
        i = i + 1
    }
    return ox.write_docx(path, body, false)
}

// 渲染整份 xlsx（v1 单 sheet 映射）：
//   - 第 1 行 = title（加粗）
//   - tbl 块 → 表头行 + 数据行逐列展开
//   - 其余文本块（p/h/b/…）→ 单列单元格
// 结果可被 Excel / LibreOffice / WPS 打开。
pub func render_xlsx(path: string, title: string, blocks: table<table<string>>) -> bool {
    var sb = string_builder()
    sb_append(sb, "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>")
    sb_append(sb, "<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" ")
    sb_append(sb, "xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">")
    sb_append(sb, "<sheetViews><sheetView workbookViewId=\"0\"/></sheetViews>")
    sb_append(sb, "<sheetData>")
    var r_n: i64 = 1
    // title 行（首行加粗）
    sb_append(sb, "<row r=\"1\">")
    sb_append(sb, xcell(1, 1, title, true))
    sb_append(sb, "</row>")
    r_n = 2
    var i: i64 = 0
    while i < len(blocks) {
        var row = blocks[i]
        var kind = row[0]
        if kind == "tbl" {
            // 表头行
            var hdr = csv_split(row[1])
            sb_append(sb, "<row r=\"")
            sb_append(sb, i2s(r_n))
            sb_append(sb, "\">")
            var cc: i64 = 1
            var hc: i64 = 0
            while hc < len(hdr) {
                sb_append(sb, xcell(cc, r_n, hdr[hc], true))
                cc = cc + 1
                hc = hc + 1
            }
            sb_append(sb, "</row>")
            r_n = r_n + 1
            // 数据行
            var d: i64 = 2
            while d < len(row) {
                var cells = csv_split(row[d])
                sb_append(sb, "<row r=\"")
                sb_append(sb, i2s(r_n))
                sb_append(sb, "\">")
                cc = 1
                var k: i64 = 0
                while k < len(cells) {
                    sb_append(sb, xcell(cc, r_n, cells[k], false))
                    cc = cc + 1
                    k = k + 1
                }
                sb_append(sb, "</row>")
                r_n = r_n + 1
                d = d + 1
            }
        } else {
            // 其他文本块 → 单列
            var txt: string = ""
            if len(row) > 1 {
                txt = row[1]
            }
            sb_append(sb, "<row r=\"")
            sb_append(sb, i2s(r_n))
            sb_append(sb, "\">")
            sb_append(sb, xcell(1, r_n, txt, false))
            sb_append(sb, "</row>")
            r_n = r_n + 1
        }
        i = i + 1
    }
    sb_append(sb, "</sheetData></worksheet>")
    var sdoc = sb_build(sb)
    var snames = table_new_string()
    table_push(snames, "Sheet1")
    var sdocs = table_new_string()
    table_push(sdocs, sdoc)
    var (n2, d2) = xlsx_parts_of(sdocs, snames)
    return ox.write_zip(path, n2, d2)
}

// xlsx 单格（复用 xlsx 模块约定：inlineStr）。
func xcell(c: i64, r: i64, txt: string, bold: bool) -> string {
    var sb = string_builder()
    sb_append(sb, "<c r=\"")
    sb_append(sb, xlt(c) + i2s(r))
    sb_append(sb, "\" t=\"inlineStr\"><is>")
    if bold {
        sb_append(sb, "<r><rPr><b/></rPr>")
    } else {
        sb_append(sb, "<r>")
    }
    sb_append(sb, "<t>")
    sb_append(sb, esc(txt))
    sb_append(sb, "</t></r></is></c>")
    return sb_build(sb)
}

// 列号 → 列字母（1→A）。

func xlt(c: i64) -> string {
    var sb = string_builder()
    var x: i64 = c
    var letters = table_new_i64()
    while x > 0 {
        var m = (x - 1) % 26
        table_push(letters, 65 + m)
        x = (x - 1) / 26
    }
    var i: i64 = len(letters) - 1
    while i >= 0 {
        sb_append_byte(sb, letters[i])
        i = i - 1
    }
    if len(letters) == 0 {
        sb_append(sb, "A")
    }
    return sb_build(sb)
}

// 单 sheet 的 xlsx 包部件（复用 xlsx 格式：Content_Types/rels/workbook/sheet1）。
func xlsx_parts_of(sdocs: table<string>, snames: table<string>) -> (names: table<string>, datas: table<string>) {
    var names = table_new_string()
    var datas = table_new_string()
    table_push(names, "[Content_Types].xml")
    table_push(datas, xct(sdocs))
    table_push(names, "_rels/.rels")
    table_push(datas, xroot_rels())
    table_push(names, "xl/workbook.xml")
    table_push(datas, xwb(snames))
    table_push(names, "xl/_rels/workbook.xml.rels")
    table_push(datas, xwb_rels(sdocs))
    var i: i64 = 0
    while i < len(sdocs) {
        table_push(names, "xl/worksheets/sheet" + i2s(i + 1) + ".xml")
        table_push(datas, sdocs[i])
        i = i + 1
    }
    return (names, datas)
}

func xct(sdocs: table<string>) -> string {
    var sb = string_builder()
    sb_append(sb, "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>")
    sb_append(sb, "<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">")
    sb_append(sb, "<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>")
    sb_append(sb, "<Default Extension=\"xml\" ContentType=\"application/xml\"/>")
    sb_append(sb, "<Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>")
    var i: i64 = 0
    while i < len(sdocs) {
        sb_append(sb, "<Override PartName=\"/xl/worksheets/sheet")
        sb_append(sb, i2s(i + 1))
        sb_append(sb, ".xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>")
        i = i + 1
    }
    sb_append(sb, "</Types>")
    return sb_build(sb)
}

func xroot_rels() -> string {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
        "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" +
        "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/>" +
        "</Relationships>"
}

func xwb(snames: table<string>) -> string {
    var sb = string_builder()
    sb_append(sb, "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>")
    sb_append(sb, "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" ")
    sb_append(sb, "xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><sheets>")
    var i: i64 = 0
    while i < len(snames) {
        sb_append(sb, "<sheet name=\"")
        sb_append(sb, esc(snames[i]))
        sb_append(sb, "\" sheetId=\"")
        sb_append(sb, i2s(i + 1))
        sb_append(sb, "\" r:id=\"rId")
        sb_append(sb, i2s(i + 1))
        sb_append(sb, "\"/>")
        i = i + 1
    }
    sb_append(sb, "</sheets></workbook>")
    return sb_build(sb)
}

func xwb_rels(sdocs: table<string>) -> string {
    var sb = string_builder()
    sb_append(sb, "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>")
    sb_append(sb, "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">")
    var i: i64 = 0
    while i < len(sdocs) {
        sb_append(sb, "<Relationship Id=\"rId")
        sb_append(sb, i2s(i + 1))
        sb_append(sb, "\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet")
        sb_append(sb, i2s(i + 1))
        sb_append(sb, ".xml\"/>")
        i = i + 1
    }
    sb_append(sb, "</Relationships>")
    return sb_build(sb)
}

// XML 转义（& < >）。
func esc(txt: string) -> string {
    var sb = string_builder()
    var n: i64 = str_len(txt)
    var i: i64 = 0
    while i < n {
        var c = str_char(txt, i)
        if c == "&" {
            sb_append(sb, "&amp;")
        } else if c == "<" {
            sb_append(sb, "&lt;")
        } else if c == ">" {
            sb_append(sb, "&gt;")
        } else {
            sb_append(sb, c)
        }
        i = i + 1
    }
    return sb_build(sb)
}

}   // namespace tiedoc