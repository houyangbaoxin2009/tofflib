type tie<logic>
// ch10_conc.tie —— 规范正文 · 第 10 章 并发
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp

namespace ch10 {

pub func chapter() {
    dp.h1("第 10 章  并发")

    dp.p("并发在 tie 里由两类构造承担：actor 提供隔离的状态单元，任务图提供带依赖的并行调度。两者的共同前提是「默认不共享可变状态」——共享是通过显式通道或消息传递发生的，不是通过共享内存偶然发生的。")

    // ---------------- 10.1 ----------------
    dp.h2("10.1  并发的基本立场")
    dp.p("数据竞争通常来自两处：两个执行流访问同一块可写内存；或者一处持有指向另一处栈帧的引用。语言在设计上分别封堵：")
    dp.bullet(["共享可变状态通过消息传递表达，通道有明确的所有权归属", "可写借用不能被闭包捕获，因此不会随函数值逃逸到别的执行流", "跨线程传递的值按值复制，不建立隐式别名"])

    // ---------------- 10.2 ----------------
    dp.h2("10.2  状态单元")
    dp.p("actor 是并发的基本单位：它拥有自己的状态，只通过消息与外界交互。对它的状态的访问全部发生在它自己的执行流里，因此不需要锁。")
    dp.codeblock(dp.src(["actor Counter {", "    var n: i64 = 0", "", "    func inc(step: i64) {", "        n += step", "    }", "", "    func value() -> i64 {", "        return n", "    }", "}", "", "var c = Counter()", "c.inc(5)", "println(to_string(c.value()))"]))
    dp.p("调用 actor 方法即发送消息。消息在队列中排队，按到达顺序处理，因此状态变化的顺序是可预期的。")

    // ---------------- 10.3 ----------------
    dp.h2("10.3  消息与返回")
    dp.p("消息可以携带数据。需要结果时，调用等待回复并把结果作为表达式的值。带返回值的调用与普通调用写法相同，等待是隐式的。")
    dp.codeblock(dp.src(["var total = c.value()"]))
    dp.p("发送方与接收方之间传递的数据按值语义复制或转移，因此不存在双方同时持有同一块可写内存的情形。")

    // ---------------- 10.4 ----------------
    dp.h2("10.4  任务与依赖")
    dp.p("当工作之间存在依赖关系时，用任务图描述：节点是工作单元，边是依赖。调度器按依赖顺序推进，互不依赖的节点并行执行。")
    dp.codeblock(dp.src(["var g = graph()", "var a = g.add(fetch_a)", "var b = g.add(fetch_b)", "var c = g.add(merge, a, b)      // c 依赖 a 与 b", "g.run()"]))
    dp.p("任务图中传递的值遵循与 actor 相同的规则：跨节点传递即复制或转移。这使并行部分与串行部分可以自由混合，而不必为边界处的数据归属单独设计。")

    dp.note("并发构造的选择依据是「状态是否需要长期存在」。需要长期存在并被多方交互的状态放在 actor 里；一次性的并行计算用任务图。")

    // ---------------- 10.5 ----------------
    dp.h2("10.5  与闭包捕获的关系")
    dp.p("第 5 章的捕获面白名单在这里体现为一条直接的安全保证：由于可写借用不可被闭包捕获，任何函数值都不持有对他人栈帧的可写引用。把函数值交给别的执行流时，不可能带入一个可写别名。")
    dp.p("这条规则也解释了为什么跨线程传递闭包是安全的：闭包携带的全部是被捕获时刻的值快照，每个执行流拿到的是各自独立的副本。")
}

}
