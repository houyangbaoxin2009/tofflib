type tie<logic>
// ch03_expr.tie —— 规范正文 · 第 3 章 运算符与表达式
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp

namespace ch03 {

pub func chapter() {
    dp.h1("第 3 章  运算符与表达式")

    dp.p("表达式由运算符与操作数构成。本章按优先级自高到低说明各运算符的形态与语义，并单列 tie 特有的若干记号——它们的共同目标是让常见意图有专有的书写形式，而不是靠函数调用或状态变量绕行。")

    // ---------------- 3.1 ----------------
    dp.h2("3.1  优先级与结合性")
    dp.p("优先级自高到低如下表。同一行的运算符优先级相同，按结合性方向结合。括号可覆盖默认优先级。")

    var w = table_new_i64()
    table_push(w, 60)
    table_push(w, 200)
    table_push(w, 191)
    var h = table_new_string()
    table_push(h, "级")
    table_push(h, "运算符")
    table_push(h, "结合性")
    var r: table<table<string>> = []
    table_push(r, three("1", "() [] . :: ?.", "左"))
    table_push(r, three("2", "! ~ \\ 一元 -", "右"))
    table_push(r, three("3", "**  **?", "右"))
    table_push(r, three("4", "*  /  %", "左"))
    table_push(r, three("5", "+  -", "左"))
    table_push(r, three("6", "..  ..=", "左"))
    table_push(r, three("7", "<<  >>", "左"))
    table_push(r, three("8", "&", "左"))
    table_push(r, three("9", "^", "左"))
    table_push(r, three("10", "|", "左"))
    table_push(r, three("11", "==  !=  <  >  <=  >=  in  not in", "左"))
    table_push(r, three("12", "&&", "左"))
    table_push(r, three("13", "||", "左"))
    table_push(r, three("14", "?:", "右"))
    table_push(r, three("15", "->", "左"))
    table_push(r, three("16", "%%", "左"))
    dp.tbl(h, r, w)

    // ---------------- 3.2 ----------------
    dp.h2("3.2  算术运算")
    dp.p("算术运算符对整数与浮点生效，规则与通常预期一致。整数除零在运行期报错，语言不做静默截断。")
    dp.codeblock(dp.src(["var a = 7 + 3      // 10", "var b = 7 / 3      // 2     整数除法", "var c = 7.0 / 3.0  // 2.333 浮点除法", "var d = 7 % 3      // 1     取余"]))
    dp.p("一元负号改变符号。p.p. 溢出：整数运算在溢出时按位宽回绕，需要检测溢出的场合使用带检查的运算形式（见 3.12）。")

    // ---------------- 3.3 ----------------
    dp.h2("3.3  幂运算")
    dp.p("幂运算写作两个星号，右结合。它与乘法的优先级关系使得 2 ** 3 ** 2 解析为 2 ** (3 ** 2)。")
    dp.codeblock(dp.src(["var p = 2 ** 10        // 1024", "var q = 2 ** 3 ** 2    // 512   右结合"]))
    dp.p("带检查的幂写作 **?，在结果超出该类型的表示范围时报告错误，而不是回绕。数值敏感的计算应使用这一形式。")

    // ---------------- 3.4 ----------------
    dp.h2("3.4  比较运算")
    dp.p("比较运算符返回 bool。对文本按码点顺序比较；对元组与表按元素依次比较。")
    dp.codeblock(dp.src(["1 == 1        // true", "\"abc\" < \"abd\"  // true"]))
    dp.p("相等比较要求两侧类型相容。语言不为不同类型之间定义隐式相等——这避免了整数与浮点混比时的意外结果。")

    // ---------------- 3.5 ----------------
    dp.h2("3.5  逻辑运算与三值逻辑")
    dp.p("逻辑运算符对 bool 生效，并短路求值：与运算在左操作数为假时不再求右操作数，或运算在左操作数为真时不再求右操作数。")
    dp.p("当操作数是 trit 时，同一组运算符按三值逻辑解释：与取较小值、或取较大值、非运算取反。由于三值包含「未知」，与运算中只要有否即为否，或运算中只要有真即为真，未知只在无法决定时才保留。")
    dp.codeblock(dp.src(["var t: trit = unknown_result()", "if t && positive_signal() {", "    // 仅当两者皆正", "}"]))

    // ---------------- 3.6 ----------------
    dp.h2("3.6  位运算")
    dp.p("位运算符作用于整数，移位运算的右操作数是移位数。")
    dp.codeblock(dp.src(["var m = 0b1100 & 0b1010   // 0b1000", "var n = 1 << 4            // 16", "var x = ~0                // 按位取反"]))

    // ---------------- 3.7 ----------------
    dp.h2("3.7  成员判定")
    dp.p("成员判定用于回答「这个键在不在这个结构里」。它是布尔表达式的一部分，可直接用于条件。")
    dp.codeblock(dp.src(["if \"alice\" in age {", "    println(\"已知\")", "}", "if \"dave\" not in age {", "    println(\"未见\")", "}"]))
    dp.p("判定对象可以是映射（判键）、表（判元素）、文本（判子串）。取反形式 not in 是一个整体记号，不写成 !(x in y)——后者在长条件里容易读错。")

    // ---------------- 3.8 ----------------
    dp.h2("3.8  数据流管道")
    dp.p("管道把左侧的值作为右侧调用的输入，从而把嵌套调用写成自上而下的序列。")
    dp.codeblock(dp.src(["// 嵌套写法", "println(to_string(len(trim(input))))", "", "// 管道写法", "input -> trim -> len -> to_string -> println"]))
    dp.p("管道左侧必须是一个已声明的值，右侧是一个可调用目标。这一限制使管道与短闭包在语法上可以共存而不冲突：需要函数值时按下文所述的规则解释，需要求值时按管道解释。")

    // ---------------- 3.9 ----------------
    dp.h2("3.9  短闭包")
    dp.p("当上下文要求一个函数值时，形如 标识符 -> 表达式 的写法被解释为短闭包：标识符是参数名，表达式是函数体。参数类型与返回类型由上下文的函数类型给出。")
    dp.codeblock(dp.src(["var f: fn(i64) -> i64 = t -> t + 1", "var g: fn(i64) -> i64 = n -> n * n", "", "f = t -> t * 10        // 赋值位置同样适用"]))
    dp.p("判据是上下文而不是符号表：声明位置的标注已经给出了函数类型，赋值位置的目标类型在语义分析时已知。两种情形都能确定地解释为短闭包，其余位置保持管道的含义不变。")
    dp.note("如果确实要在函数值位置写管道，把中间结果先赋给变量再传递，或者用显式的函数名构造函数值。")

    // ---------------- 3.10 ----------------
    dp.h2("3.10  解引用")
    dp.p("反斜杠是解引用记号，作用于指针、引用与表句柄，取出其所指的值。它只在 unsafe 上下文中可用。")
    dp.codeblock(dp.src(["unsafe {", "    var p = alloc(8)", "    deref_write(p, as_u8(7))", "    var v = as_i64(deref(p))", "}"]))
    dp.p("这一记号把「此处发生了指针访问」写在表达式里，使得审计内存访问时可以在文本层面搜索，而不必追踪函数调用的实现。")

    // ---------------- 3.11 ----------------
    dp.h2("3.11  原地修改")
    dp.p("双百分号是原地修改记号：它表示在操作数的存储位置上更新值，而不是先取出副本再写回。")
    dp.codeblock(dp.src(["var total = 0", "total %% 1     // 等价于 total = total + 1", "total %% 10    // 等价于 total = total + 10"]))
    dp.p("这一记号的意义有两层。其一是书写简洁：对累加、计数、状态推进这类高频操作，它比复合赋值更短。其二是语义明确：编译器可以确定这是就地更新，无需先取副本，在表元素、结构字段这类位置上避免多余拷贝。")

    // ---------------- 3.12 ----------------
    dp.h2("3.12  存在判定与安全默认值")
    dp.p("问号后缀判定值是否存在；若存在则取出，否则走另一条路径。双问号是空值合并：左侧有值则取之，否则取右侧。")
    dp.codeblock(dp.src(["var port = config[\"port\"] ?: 8080", "", "if user? {", "    println(user.name)", "}"]))
    dp.p("安全默认值的右操作数只在左侧缺失时求值，因此可以写有副作用或开销较大的表达式。")

    // ---------------- 3.13 ----------------
    dp.h2("3.13  范围与切片")
    dp.p("范围用两个点表示，左闭右开；三个字符的形式包含右端点。范围用于循环与切片。")
    dp.codeblock(dp.src(["for i in 0..10 { }      // 0 到 9", "for i in 0..=10 { }     // 0 到 10", "var head = xs[0..3]      // 前三个元素"]))

    // ---------------- 3.14 ----------------
    dp.h2("3.14  类型判定")
    dp.p("类型判定用于询问一个动态类型值的实际类型，配合分支使用，使分支内的取用是安全的。")
    dp.codeblock(dp.src(["var v: any = 42", "if v is i64 {", "    var n = as_i64(v)", "}"]))
    dp.p("判定与转换分开书写，而不是在判定中隐式完成转换。这样每一处的类型假设都是显式的，阅读时不必回推。")
}

// 构造一行三列
func three(a: string, b: string, c: string) -> table<string> {
    var r = table_new_string()
    table_push(r, a)
    table_push(r, b)
    table_push(r, c)
    return r
}

}
