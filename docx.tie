type tie<class>
// ============================================================================
// docx.tie：tofflib——用 tie 办公的工具库 / Word 文档（docx/OOXML）骨架生成
//
// 本模块生成 WordprocessingML（OOXML）文档正文 XML 片段，供组装成
// word/document.xml：
//   - 文档根骨架：root_open() / root_close() 包裹 <w:document><w:body>…
//   - 段落：paragraph() / paragraph_runs()（含 run 属性 run() / run_font()）
//   - 标题/列表：heading()（Heading1..9）、bullet() / number()（编号项+整组便捷）
//   - 分页/页码：page_break()、page_field()（PAGE 域）+ para_center()/para_right()
//   - 页眉/页脚：header_para() / footer_para()（部件内容，供 ooxml 装配 header1/footer1）
//   - 页面设置与分节：sect_page() / sect_a4()（页宽高+边距，twips；正文中插即分节）
//   - 表格：tbl() 由嵌套字符串表组装 <w:tbl>/<w:tr>/<w:tc>，默认全单线边框
//     tbl_borders() 可自定义线宽/颜色
//   - 文本净化：escape() 转义 & < > 等 XML 特殊字符
//
// 命名空间：http://schemas.openxmlformats.org/wordprocessingml/2006/main（w:）
//            http://schemas.openxmlformats.org/officeDocument/2006/relationships（r:）
//
// 纯函数、零 unsafe、无外部依赖，只依赖底座原语（str_len/str_char/len/table
// + string_builder/sb_append/sb_build）。循环拼接统一用 StringBuilder（O(n)），
// 串联已知数量短串（片段拼装）用 "+" 无碍。
//
// 调用方式（class 库，编译为 docx.a）：
//   import "./docx.tie" as dx
//   var out = dx.root_open() + dx.paragraph("你好，tie 办公") + dx.root_close()
//
// 错误约定：escape 对非法/超界字符安静跳过（str_char 越界返回空串）。
// ============================================================================

namespace docx {

// XML 安全转义：把 & < > 替换为实体；单引号/双引号按注（属性用双引号则无须转义 *，
// 为保证 gb18030 文本安全仍对 " 无效——结构片段里属性值由本库构造时已安全）。
// 实现：逐码点扫描，把需转义字符改用对应实体，其余原样 sb_append。
pub func escape(txt: string) -> string {
    var sb = string_builder()
    var n: i64 = str_len(txt)
    var i: i64 = 0
    while i < n {
        var c = str_char(txt, i)
        if c == "&" {
            sb_append(sb, "&amp;")
        } else if c == "<" {
            sb_append(sb, "&lt;")
        } else if c == ">" {
            sb_append(sb, "&gt;")
        } else {
            sb_append(sb, c)
        }
        i = i + 1
    }
    return sb_build(sb)
}

// 单个 w:r run：文本已 escape 处理（内容安全）。
pub func run(txt: string) -> string {
    return "<w:r>" + run_text(txt) + "</w:r>"
}

// run 内联文本（w:t），xml:space=preserve 保空格。
func run_text(txt: string) -> string {
    return "<w:t xml:space=\"preserve\">" + escape(txt) + "</w:t>"
}

// 带格式 run：字号（半磅单位，word: 5→5 号约 21）、加粗、字体名。
// size_half_points：字号半磅值（如 11pt=22，5 号=21）；<=0 时不输出 <w:sz>。
// bold：true 输出 <w:b/>；font 非空输出 <w:rFonts w:ascii=… w:hAnsi=… w:eastAsia=…>。
pub func run_font(txt: string, font: string, size_half_points: i64, bold: bool) -> string {
    var sb = string_builder()
    sb_append(sb, "<w:r>")
    sb_append(sb, "<w:rPr>")
    if font != "" {
        sb_append(sb, "<w:rFonts w:ascii=\"")
        sb_append(sb, font)
        sb_append(sb, "\" w:hAnsi=\"")
        sb_append(sb, font)
        sb_append(sb, "\" w:eastAsia=\"")
        sb_append(sb, font)
        sb_append(sb, "\"/>")
    }
    if size_half_points > 0 {
        sb_append(sb, "<w:sz w:val=\"")
        sb_append(sb, i2s(size_half_points))
        sb_append(sb, "\"/>")
    }
    if bold {
        sb_append(sb, "<w:b/>")
    }
    sb_append(sb, "</w:rPr>")
    sb_append(sb, run_text(txt))
    sb_append(sb, "</w:r>")
    return sb_build(sb)
}

// 文本框段落：单 run 段落。
pub func paragraph(txt: string) -> string {
    return "<w:p>" + run(txt) + "</w:p>"
}

// 由多个 run 片段（已含 <w:r>…</w:r>）组装成一个段落。
pub func paragraph_runs(runs_table: table<string>) -> string {
    var sb = string_builder()
    sb_append(sb, "<w:p>")
    var i: i64 = 0
    while i < len(runs_table) {
        sb_append(sb, runs_table[i])
        i = i + 1
    }
    sb_append(sb, "</w:p>")
    return sb_build(sb)
}

// 文档根 XMl 声明 + <w:document> 打开 + <w:body> 打开（含命名空间）。
pub func root_open() -> string {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" +
        "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\" " +
        "xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">" +
        "<w:body>"
}

// 文档根关闭：</w:body></w:document>。
pub func root_close() -> string {
    return "</w:body></w:document>"
}

// ---- 标题 ----

// 标题段落：引用内置样式 Heading1..Heading9（level 1..9，越界回钳到 1/9）。
pub func heading(txt: string, level: i64) -> string {
    var lv: i64 = level
    if lv < 1 {
        lv = 1
    }
    if lv > 9 {
        lv = 9
    }
    return "<w:p><w:pPr><w:pStyle w:val=\"Heading" + i2s(lv) + "\"/></w:pPr>" + run(txt) + "</w:p>"
}

// ---- 列表 ----

// 无序列表项：numPr 引用 numId=1（bullet 编号定义在 numbering.xml，由打包装配器提供）。
pub func bullet(txt: string, level: i64) -> string {
    return list_item(txt, level, 1)
}

// 有序列表项：numPr 引用 numId=2（decimal 编号定义，同上）。
pub func number(txt: string, level: i64) -> string {
    return list_item(txt, level, 2)
}

// 整组无序列表（多行拼接，同 level）。
pub func bullets(txts: table<string>, level: i64) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < len(txts) {
        sb_append(sb, list_item(txts[i], level, 1))
        i = i + 1
    }
    return sb_build(sb)
}

// 整组有序列表（多行拼接，同 level）。
pub func numbers(txts: table<string>, level: i64) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < len(txts) {
        sb_append(sb, list_item(txts[i], level, 2))
        i = i + 1
    }
    return sb_build(sb)
}

// ---- 分页 / 页码 ----

// 分页符：独立段落内的 <w:br w:type="page"/>。
pub func page_break() -> string {
    return "<w:p><w:r><w:br w:type=\"page\"/></w:r></w:p>"
}

// 页码域 run 序列（PAGE 域，须放入页眉/页脚段落中才渲染出页码）。
pub func page_field() -> string {
    return "<w:r><w:fldChar w:fldCharType=\"begin\"/></w:r>" +
        "<w:r><w:instrText xml:space=\"preserve\"> PAGE </w:instrText></w:r>" +
        "<w:r><w:fldChar w:fldCharType=\"end\"/></w:r>"
}

// ---- 域：目录 / 题注 / 交叉引用 / 书签 ----

// 自动目录：fldSimple TOC 域（Word 打开后右键→更新域 或按 F9 刷新）。
// levels_from..levels_to 为目录收录的标题层级（对应 HeadingN，1..9，自动钳位）。
// 反斜杠以字节拼接（92），规避 tie 字符串转义歧义。
pub func toc(levels_from: i64, levels_to: i64, placeholder: string) -> string {
    var lo: i64 = levels_from
    var hi: i64 = levels_to
    if lo < 1 {
        lo = 1
    }
    if hi > 9 {
        hi = 9
    }
    if hi < lo {
        hi = lo
    }
    var p: string = placeholder
    if p == "" {
        p = "目录（在 Word 中右键→更新域）"
    }
    var sb = string_builder()
    sb_append(sb, "<w:p><w:fldSimple w:instr=\" TOC ")
    sb_append(sb, bs())
    sb_append(sb, "o &quot;")
    sb_append(sb, i2s(lo))
    sb_append(sb, "-")
    sb_append(sb, i2s(hi))
    sb_append(sb, "&quot; ")
    sb_append(sb, bs())
    sb_append(sb, "h ")
    sb_append(sb, bs())
    sb_append(sb, "z ")
    sb_append(sb, bs())
    sb_append(sb, "u \">")
    sb_append(sb, run_text(p))
    sb_append(sb, "</w:fldSimple></w:p>")
    return sb_build(sb)
}

// 题注：文本 + SEQ 自动编号域（seq_label 如 "图"/"表"/"式"，跨文档连续编号）。
pub func caption(txt: string, seq_label: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<w:p>")
    sb_append(sb, run_text(prefix_space(txt)))
    sb_append(sb, "<w:fldSimple w:instr=\" SEQ ")
    sb_append(sb, seq_label)
    sb_append(sb, " ")
    sb_append(sb, bs())
    sb_append(sb, "* ARABIC \"><w:r><w:t>1</w:t></w:r></w:fldSimple></w:p>")
    return sb_build(sb)
}

// 交叉引用域：引用书签（bookmark_start/end 锚定）指向的编号或文本，Word 打开后刷新。
pub func xref(bookmark_name: string, placeholder: string) -> string {
    return "<w:fldSimple w:instr=\" REF " + bookmark_name + " " + bs() +
        "h \"><w:r><w:t>" + escape(placeholder) + "</w:t></w:r></w:fldSimple>"
}

// 书签开始（name 供 REF 域引用；id 须与 bookmark_end 一致且文档内唯一）。
pub func bookmark_start(name: string, id: i64) -> string {
    return "<w:bookmarkStart w:id=\"" + i2s(id) + "\" w:name=\"" + name + "\"/>"
}

// 书签结束。
pub func bookmark_end(id: i64) -> string {
    return "<w:bookmarkEnd w:id=\"" + i2s(id) + "\"/>"
}

// 反斜杠字符（字节 92 构造，规避 tie 字符串转义歧义）。
func bs() -> string {
    var sb = string_builder()
    sb_append_byte(sb, 92)
    return sb_build(sb)
}

// 文本后加空格（题注惯用：内容与编号域之间留空）。
func prefix_space(txt: string) -> string {
    return txt + " "
}

// ---- 段落对齐 ----

// 居中对齐段落：children 为已组装的 run/结构片段（如页码域）。
pub func para_center(children: table<string>) -> string {
    return para_align(children, "center")
}

// 右对齐段落。
pub func para_right(children: table<string>) -> string {
    return para_align(children, "right")
}

// ---- 页面设置 ----

// 节属性：A4 纵向 + 常用边距（1cm≈567 twips）。
pub func sect_a4() -> string {
    return sect_page(11906, 16838, 1440, 1800, 1440, 1800)
}

// 节属性：自定义页面宽高与上下左右边距（单位 twips；宽高为 0 时回退 A4 默认）。
pub func sect_page(pg_w_twips: i64, pg_h_twips: i64, margin_top: i64, margin_right: i64, margin_bottom: i64, margin_left: i64) -> string {
    var w: i64 = pg_w_twips
    var h: i64 = pg_h_twips
    if w <= 0 {
        w = 11906
    }
    if h <= 0 {
        h = 16838
    }
    var sb = string_builder()
    sb_append(sb, "<w:sectPr>")
    sb_append(sb, "<w:pgSz w:w=\"")
    sb_append(sb, i2s(w))
    sb_append(sb, "\" w:h=\"")
    sb_append(sb, i2s(h))
    sb_append(sb, "\"/>")
    sb_append(sb, "<w:pgMar w:top=\"")
    sb_append(sb, i2s(margin_top))
    sb_append(sb, "\" w:right=\"")
    sb_append(sb, i2s(margin_right))
    sb_append(sb, "\" w:bottom=\"")
    sb_append(sb, i2s(margin_bottom))
    sb_append(sb, "\" w:left=\"")
    sb_append(sb, i2s(margin_left))
    sb_append(sb, "\" w:header=\"720\" w:footer=\"720\" w:gutter=\"0\"/>")
    sb_append(sb, "</w:sectPr>")
    return sb_build(sb)
}

// ---- 页眉 / 页脚 ----

// 页眉部件内容：<w:hdr> 包裹一个段落（children 为 run/结构片段，页眉常放文档标题）。
pub func header_para(children: table<string>) -> string {
    return hdr_footer_para(children, "hdr")
}

// 页脚部件内容：<w:ftr> 包裹一个段落（children 如 page_field() 页码域）。
pub func footer_para(children: table<string>) -> string {
    return hdr_footer_para(children, "ftr")
}

// 页眉/页脚部件通用组装：<w:hdr|ftr xmlns:w=…><w:p>children</w:p></w:hdr|ftr>。
func hdr_footer_para(children: table<string>, tag: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<w:")
    sb_append(sb, tag)
    sb_append(sb, " xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">")
    sb_append(sb, "<w:p>")
    var i: i64 = 0
    while i < len(children) {
        sb_append(sb, children[i])
        i = i + 1
    }
    sb_append(sb, "</w:p></w:")
    sb_append(sb, tag)
    sb_append(sb, ">")
    return sb_build(sb)
}

// ---- 表格 ----

// 通用列表项：ilvl 为嵌套层级，num_id 引用 numbering.xml 中的编号定义 id。
func list_item(txt: string, level: i64, num_id: i64) -> string {
    var lv: i64 = level
    if lv < 0 {
        lv = 0
    }
    var sb = string_builder()
    sb_append(sb, "<w:p><w:pPr><w:numPr><w:ilvl w:val=\"")
    sb_append(sb, i2s(lv))
    sb_append(sb, "\"/><w:numId w:val=\"")
    sb_append(sb, i2s(num_id))
    sb_append(sb, "\"/></w:numPr></w:pPr>")
    sb_append(sb, run(txt))
    sb_append(sb, "</w:p>")
    return sb_build(sb)
}

// 按对齐值组装段落（center/right；默认 left 无 pPr）。
func para_align(children: table<string>, align: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<w:p><w:pPr><w:jc w:val=\"")
    sb_append(sb, align)
    sb_append(sb, "\"/></w:pPr>")
    var i: i64 = 0
    while i < len(children) {
        sb_append(sb, children[i])
        i = i + 1
    }
    sb_append(sb, "</w:p>")
    return sb_build(sb)
}

// 表格边框定义（全部单线）：tbl() 默认 sz=4（0.5pt）/auto 色。
pub func tbl_borders(sz: i64, color: string) -> string {
    var s: i64 = sz
    if s <= 0 {
        s = 4
    }
    var c: string = color
    if c == "" {
        c = "auto"
    }
    return "<w:tblBorders>" +
        border_side("top", s, c) +
        border_side("left", s, c) +
        border_side("bottom", s, c) +
        border_side("right", s, c) +
        border_side("insideH", s, c) +
        border_side("insideV", s, c) +
        "</w:tblBorders>"
}

// 单条边框（side 为 top/left/bottom/right/insideH/insideV）。
func border_side(side: string, s: i64, c: string) -> string {
    return "<w:" + side + " w:val=\"single\" w:sz=\"" + i2s(s) + "\" w:space=\"0\" w:color=\"" + c + "\"/>"
}

// 组装表格 XML：rows 为二维字符串表（行内列）。
// 结构：<w:tbl><w:tblPr><w:tblW …/><w:tblBorders/></w:tblPr>
//       <w:tr><w:tc><w:p>…</w:p></w:tc></w:tr>…
// header 非空时插为第一行前的表头行（加粗）。
pub func tbl(rows: table<table<string>>, header: table<string>, col_width_twips: i64) -> string {
    var sb = string_builder()
    sb_append(sb, "<w:tbl>")
    sb_append(sb, "<w:tblPr>")
    var w: i64 = col_width_twips
    if w <= 0 {
        w = 9360
    }
    sb_append(sb, "<w:tblW w:w=\"")
    sb_append(sb, i2s(w))
    sb_append(sb, "\" w:type=\"dxa\"/>")
    sb_append(sb, tbl_borders(4, "auto"))
    sb_append(sb, "</w:tblPr>")
    if len(header) > 0 {
        table_append_row(sb, header, true)
    }
    var r: i64 = 0
    while r < len(rows) {
        table_append_row(sb, rows[r], false)
        r = r + 1
    }
    sb_append(sb, "</w:tbl>")
    return sb_build(sb)
}

// 追加一行表格（内存格 w:tc 内装一个带文本的段落，可加粗）
func table_append_row(sb: i64, cells: table<string>, bold: bool) -> void {
    sb_append(sb, "<w:tr>")
    var c: i64 = 0
    while c < len(cells) {
        sb_append(sb, "<w:tc>")
        sb_append(sb, "<w:p>")
        if bold {
            sb_append(sb, run_font(cells[c], "", 0, true))
        } else {
            sb_append(sb, run(cells[c]))
        }
        sb_append(sb, "</w:p>")
        sb_append(sb, "</w:tc>")
        c = c + 1
    }
    sb_append(sb, "</w:tr>")
}

// ---- 表格高级：tc / tchead / tc_w / tbl_full ----

// 单元格生成器：txt 为纯文本自动 run；span>1 → <w:gridSpan> 跨列合并；
// shade 非空 → <w:shd> 底纹填充色（如 "D9E2F3"）；align 非空（center/right…）→ 段落水平对齐。
pub func tc(txt: string, span: i64, shade: string, align: string) -> string {
    return tc2(txt, span, shade, align, false, 0)
}

// 加粗单元格（表头常用）：同 tc() 但文本加粗。
pub func tchead(txt: string, span: i64, shade: string, align: string) -> string {
    return tc2(txt, span, shade, align, true, 0)
}

// 定宽单元格：tcW 指定本格宽度（twips），配合 <w:tblGrid> 呈现精确列宽。
pub func tc_w(txt: string, w_twips: i64) -> string {
    return tc2(txt, 1, "", "", false, w_twips)
}

// 单元格通用实现（bold / w_twips 追加）。
func tc2(txt: string, span: i64, shade: string, align: string, bold: bool, w_twips: i64) -> string {
    var sb = string_builder()
    sb_append(sb, "<w:tc>")
    if span > 1 || shade != "" || w_twips > 0 {
        sb_append(sb, "<w:tcPr>")
        if span > 1 {
            sb_append(sb, "<w:gridSpan w:val=\"")
            sb_append(sb, i2s(span))
            sb_append(sb, "\"/>")
        }
        if w_twips > 0 {
            sb_append(sb, "<w:tcW w:w=\"")
            sb_append(sb, i2s(w_twips))
            sb_append(sb, "\" w:type=\"dxa\"/>")
        }
        if shade != "" {
            sb_append(sb, "<w:shd w:val=\"clear\" w:fill=\"")
            sb_append(sb, shade)
            sb_append(sb, "\"/>")
        }
        sb_append(sb, "</w:tcPr>")
    }
    sb_append(sb, "<w:p>")
    if align != "" {
        sb_append(sb, "<w:pPr><w:jc w:val=\"")
        sb_append(sb, align)
        sb_append(sb, "\"/></w:pPr>")
    }
    if bold {
        sb_append(sb, run_font(txt, "", 0, true))
    } else {
        sb_append(sb, run(txt))
    }
    sb_append(sb, "</w:p></w:tc>")
    return sb_build(sb)
}

// 完整表格（高级）：header/rows 的单元格须为 tc()/tchead()/tc_w() 生成的片段
// （可混合并/底纹/加粗/定宽）；header 非空 → 首行 <w:tblHeader/>（跨页重复）。
// grid_widths_twips 非空 → 输出 <w:tblGrid> 逐列宽 + 固定布局；
// 空则按 header/首行列数均分 tbl_width_twips。
pub func tbl_full(rows: table<table<string>>, header: table<string>, grid_widths_twips: table<i64>, tbl_width_twips: i64) -> string {
    var sb = string_builder()
    sb_append(sb, "<w:tbl>")
    var w: i64 = tbl_width_twips
    if w <= 0 {
        w = 9360
    }
    sb_append(sb, "<w:tblPr>")
    sb_append(sb, "<w:tblW w:w=\"")
    sb_append(sb, i2s(w))
    sb_append(sb, "\" w:type=\"dxa\"/>")
    sb_append(sb, tbl_borders(4, "auto"))
    sb_append(sb, "</w:tblPr>")
    // 列网格与固定布局
    var nc: i64 = len(grid_widths_twips)
    sb_append(sb, "<w:tblGrid>")
    var i: i64 = 0
    if nc > 0 {
        while i < nc {
            sb_append(sb, "<w:gridCol w:w=\"")
            sb_append(sb, i2s(grid_widths_twips[i]))
            sb_append(sb, "\"/>")
            i = i + 1
        }
    } else {
        var cols: i64 = len(header)
        if cols == 0 {
            if len(rows) > 0 {
                cols = len(rows[0])
            }
        }
        if cols <= 0 {
            cols = 1
        }
        var per: i64 = w / cols
        i = 0
        while i < cols {
            sb_append(sb, "<w:gridCol w:w=\"")
            sb_append(sb, i2s(per))
            sb_append(sb, "\"/>")
            i = i + 1
        }
    }
    sb_append(sb, "</w:tblGrid>")
    if len(header) > 0 {
        sb_append(sb, "<w:tr><w:trPr><w:tblHeader/></w:trPr>")
        append_cells(sb, header)
        sb_append(sb, "</w:tr>")
    }
    var r: i64 = 0
    while r < len(rows) {
        sb_append(sb, "<w:tr>")
        append_cells(sb, rows[r])
        sb_append(sb, "</w:tr>")
        r = r + 1
    }
    sb_append(sb, "</w:tbl>")
    return sb_build(sb)
}

// 按序追加已组装的单元格片段。
func append_cells(sb: i64, cells: table<string>) -> void {
    var c: i64 = 0
    while c < len(cells) {
        sb_append(sb, cells[c])
        c = c + 1
    }
}

// i64 → 十进制字符串（非负；负数前缀 '-'）。零返回 "0"。供字号/宽度等拼装。
func i2s(v: i64) -> string {
    if v == 0 {
        return "0"
    }
    var sb = string_builder()
    var neg = false
    var x: i64 = v
    if x < 0 {
        neg = true
        x = 0 - x
    }
    // 最多 20 位十进制；先收集到临时表再倒序（i64 槽，48+v 直接给 sb_append_byte）
    var digs = table_new_i64()
    while x > 0 {
        table_push(digs, x % 10)
        x = x / 10
    }
    if neg {
        sb_append(sb, "-")
    }
    var i: i64 = len(digs) - 1
    while i >= 0 {
        sb_append_byte(sb, 48 + digs[i])
        i = i - 1
    }
    return sb_build(sb)
}

}   // namespace docx