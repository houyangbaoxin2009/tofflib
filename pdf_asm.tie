type tie<class>
// pdf_asm.tie —— PDF 装配与落盘（多字体版；tofflib 内部模块，纯 tie）
// ============================================================
// 职责：把已登记的页与内容流装配成完整 PDF 字节串，写入文件，并做生成后自检。
//
// 对象编号规划（N = 已加载的字体槽数；每槽 **5** 个对象）
//   1                  = Catalog
//   2                  = Pages
//   3+5s .. 7+5s       = 槽 s：Type0 字体 / CIDFontType2 / FontDescriptor /
//                        FontFile2（**二进制流**）/ ToUnicode（**流**）
//   base+2i            = 第 i 页 Page
//   base+2i+1          = 第 i 页 Contents
//   base = 3 + 5N
//
// 为何每槽多一个 ToUnicode：Identity-H 只写 GID，不带 Unicode 信息，
// 没有 /ToUnicode 时**复制与搜索会得到错字**（视觉正常但文本提取错乱）。
//
// 输出模型：**段列表**
// 早先的实现假设「只有一处二进制段」（单一字体），用 head/tail 两段拼接；
// 多字体后二进制段有 N 处且与 ASCII 交织，故改为段列表：
//     g_seg_kind[i] = 0（ASCII 片段，内容在 g_seg_str[i]）
//                   = 1（字体字节，槽号在 g_seg_slot[i]）
// 按顺序累进偏移，每写一个对象前记录其起始偏移——这个模型对任意多个二进制段
// 都成立，且偏移计算与输出是同一遍遍历，不会失配。

import "./pdf_ttf.tie"

// 段列表（顶层 var）
var g_seg_kind: table<i64>;
var g_seg_str: table<string>;
var g_seg_slot: table<i64>;
var g_verify_entries: i64 = 0;
var g_verify_segs: i64 = 0;
var g_tounicode: table<string>;
var g_verify_objs: i64 = 0;
var g_verify_gids: i64 = 0;
var g_verify_notdef: i64 = 0;
var g_verify_checked: i64 = 0;
var g_verify_empty: i64 = 0;

namespace pdf {

// 字体名（PDF 里的 BaseFont 名）
// 带唯一前缀的原因：若与系统已装字体同名，部分阅读器会优先匹配**系统字体**而
// 不使用内嵌字体，于是 Identity-H 的 GID 被当作普通 Unicode 解释，文字显示为空。
const F_PREFIX: string = "TIETXT+"

// ---------- 段列表 ----------
// 清空段列表。**注意**：不可在此重置 g_tounicode——add_font_objs 在 seg_reset
// 之前生成 ToUnicode 内容，若此处清空则流为空、/Length 与实际不符（自检报 -57）。
func seg_reset() {
    g_seg_kind = table_new_i64()
    g_seg_str = table_new_string()
    g_seg_slot = table_new_i64()
}

func seg_ascii(t: string) {
    table_push(g_seg_kind, 0)
    table_push(g_seg_str, t)
    table_push(g_seg_slot, -1)
}

func seg_font(slot: i64) {
    table_push(g_seg_kind, 1)
    table_push(g_seg_str, "")
    table_push(g_seg_slot, slot)
}

// ---------- 字体资源名 ----------
// 槽 s 的字体在页面资源里的名字：/F1、/F2、……
pub func font_res(s: i64) -> string {
    return "/F" + i2s(s + 1)
}

// ---------- 宽度数组（/W）----------
// CIDFont 若不给 /W，阅读器对全部 CID 采用 /DW——每个字符都按 1em 前进，
// 而排版用的是真实字形宽（等宽字体约 0.6em、汉字 1.0em），于是渲染比排版宽出
// 一大截，整行越过栏宽。故按**该槽实际用到的字形**生成 /W。
func w_array(slot: i64) -> string {
    var used = used_of(slot)
    var sb = string_builder()
    sb_append(sb, "/W [ ")
    var i: i64 = 0
    while i < len(used) {
        if used[i] == 1 {
            sb_append(sb, i2s(i))
            sb_append(sb, " [")
            sb_append(sb, i2s(gid_w1000(slot, i)))
            sb_append(sb, "] ")
        }
        i = i + 1
    }
    sb_append(sb, "]")
    return sb_build(sb)
}

// ---------- 字体对象（4 个/槽）----------
func add_font_objs(slot: i64) {
    var bf = F_PREFIX + "Font" + i2s(slot)
    // Type0 复合字体（Identity-H：文本以 2 字节 GID 写入）
    add_obj("<< /Type /Font /Subtype /Type0 /BaseFont /" + bf +
        " /Encoding /Identity-H /DescendantFonts [" + i2s(4 + 5 * slot) + " 0 R] /ToUnicode " + i2s(7 + 5 * slot) + " 0 R >>")
    // CIDFontType2 后代字体（含 /W）
    add_obj("<< /Type /Font /Subtype /CIDFontType2 /BaseFont /" + bf +
        " /CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >>" +
        " /FontDescriptor " + i2s(5 + 5 * slot) + " 0 R /DW 1000 /CIDToGIDMap /Identity " +
        w_array(slot) + " >>")
    // FontDescriptor（指标缩放到 1000/em）
    add_obj("<< /Type /FontDescriptor /FontName /" + bf + " /Flags 4" +
        " /FontBBox [" + i2s(bxmin1000(slot)) + " " + i2s(bymin1000(slot)) + " " +
        i2s(bxmax1000(slot)) + " " + i2s(bymax1000(slot)) + "]" +
        " /ItalicAngle 0 /Ascent " + i2s(asc1000(slot)) + " /Descent " + i2s(desc1000(slot)) +
        " /CapHeight " + i2s(asc1000(slot)) + " /StemV 80 /FontFile2 " + i2s(6 + 5 * slot) + " 0 R >>")
    // FontFile2 二进制流（体在输出阶段单独插入）
    var fl = font_bytes_len(slot)
    add_obj("<< /Length " + i2s(fl) + " /Length1 " + i2s(fl) + " >>")
    // ToUnicode CMap（流）：把 GID 映回 Unicode，使文本可复制/可搜索
    var tu = tounicode_cmap(slot)
    add_obj("<< /Length " + i2s(str_len(tu)) + " >>")
    g_tounicode[slot] = tu
}

// 生成 ToUnicode CMap（流内容，ASCII）
//
// 结构：CIDInit 骨架 + 若干 bfchar 段（每段 100 个映射，PDF 惯例）。
// 目标码点用 UTF-16BE 十六进制（4 位）表示。
func tounicode_cmap(slot: i64) -> string {
    var gmap = gid_to_cp_map(slot)
    var n = len(gmap) / 2
    var sb = string_builder()
    sb_append(sb, "/CIDInit /ProcSet findresource begin\n")
    sb_append(sb, "12 dict begin\nbegincmap\n")
    sb_append(sb, "/CIDSystemInfo << /Registry (Adobe) /Ordering (UCS) /Supplement 0 >> def\n")
    sb_append(sb, "/CMapName /Adobe-Identity-UCS def\n/CMapType 2 def\n")
    sb_append(sb, "1 begincodespacerange\n<0000> <ffff>\nendcodespacerange\n")
    var i: i64 = 0
    while i < n {
        var cnt = n - i
        if cnt > 100 {
            cnt = 100
        }
        sb_append(sb, i2s(cnt) + " beginbfchar\n")
        var k: i64 = 0
        while k < cnt {
            var g = gmap[(i + k) * 2]
            var cp = gmap[(i + k) * 2 + 1]
            sb_append(sb, "<" + hex4(g) + "> <" + hex4(cp) + ">\n")
            k = k + 1
        }
        sb_append(sb, "endbfchar\n")
        i = i + cnt
    }
    sb_append(sb, "endcmap\nCMapName currentdict /CMap defineresource pop\nend\nend\n")
    return sb_build(sb)
}
// 4 位十六进制（GID 与 BMP 码点都是 16 位）
func hex4(v: i64) -> string {
    var x = v
    if x < 0 {
        x = 0
    }
    return hexd((x / 4096) & 15) + hexd((x / 256) & 15) + hexd((x / 16) & 15) + hexd(x & 15)
}

// ---------- 页与内容流对象 ----------
func add_page_objs() {
    var base = 3 + 5 * font_count()
    var i: i64 = 0
    while i < len(g_pages) {
        var pg = base + 2 * i
        var ct = base + 2 * i + 1
        // 页面字体资源：把本页**实际用到**的字体都列出（未用到的槽也列出无妨，
        // 但列出全部更简单且不影响渲染）
        var res = ""
        var s: i64 = 0
        while s < font_count() {
            res = res + font_res(s) + " " + i2s(3 + 5 * s) + " 0 R "
            s = s + 1
        }
        add_obj("<< /Type /Page /Parent 2 0 R /MediaBox [0 0 " + i2s(g_w) + " " + i2s(g_h) +
            "] /Resources << /Font << " + res + ">> >> /Contents " + i2s(ct) + " 0 R >>")
        add_obj("<< /Length " + i2s(str_len(g_pages[i])) + " >>")
        i = i + 1
    }
}

// ---------- Catalog / Pages ----------
func add_root_objs() {
    var base = 3 + 5 * font_count()
    var n = len(g_pages)
    var kids = "["
    var i: i64 = 0
    while i < n {
        if i > 0 {
            kids = kids + " "
        }
        kids = kids + i2s(base + 2 * i) + " 0 R"
        i = i + 1
    }
    kids = kids + "]"
    add_obj("<< /Type /Catalog /Pages 2 0 R >>")
    add_obj("<< /Type /Pages /Kids " + kids + " /Count " + i2s(n) + " >>")
}

// ---------- 序列化 ----------
func obj_text(oid: i64, body: string) -> string {
    return i2s(oid) + " 0 obj\n" + body + "\nendobj\n"
}

func stream_text(content: string) -> string {
    return "stream\n" + content + "endstream\nendobj\n"
}

// 落盘：登记根对象 → 字体对象 → 页对象，然后按编号顺序输出为段列表。
pub func save(path: string) -> bool {
    // 先备好 ToUnicode 槽位（add_font_objs 会往里写）
    g_tounicode = table_new_string()
    var tz: i64 = 0
    while tz < 4 {
        table_push(g_tounicode, "")
        tz = tz + 1
    }
    add_root_objs()
    var s: i64 = 0
    while s < font_count() {
        add_font_objs(s)
        s = s + 1
    }
    add_page_objs()

    var n = len(g_objs)
    var base = 3 + 5 * font_count()
    var offs = table_new_i64()
    seg_reset()
    seg_ascii("%PDF-1.4\n%tie\n")
    var off: i64 = str_len("%PDF-1.4\n%tie\n")

    var oid: i64 = 1
    while oid <= n {
        table_push(offs, off)
        var body = g_objs[oid - 1]
        // 该对象是否为字体文件流？（编号 6+4s）
        var font_slot: i64 = -1
        var is_tounicode: i64 = -1
        if oid >= 6 && (oid - 6) % 5 == 0 {
            font_slot = (oid - 6) / 5
            if font_slot >= font_count() {
                font_slot = -1
            }
        }
        // ToUnicode 流对象（编号 7+5s）
        var tu_slot: i64 = -1
        if oid >= 7 && (oid - 7) % 5 == 0 {
            var c = (oid - 7) / 5
            if c < font_count() {
                tu_slot = c
            }
        }
        if tu_slot >= 0 {
            var sbody = "stream\n" + g_tounicode[tu_slot] + "endstream\nendobj\n"
            var piece0 = i2s(oid) + " 0 obj\n" + body + "\n" + sbody
            seg_ascii(piece0)
            off = off + str_len(piece0)
            oid = oid + 1
            continue
        }
        if font_slot >= 0 {
            // 前缀 + 字体字节 + 后缀（三段都要计入偏移）
            var pre = i2s(oid) + " 0 obj\n" + body + "\nstream\n"
            var suf = "\nendstream\nendobj\n"
            seg_ascii(pre)
            seg_font(font_slot)
            seg_ascii(suf)
            off = off + str_len(pre) + font_bytes_len(font_slot) + str_len(suf)
        } else {
            var is_content = oid >= base + 1 && (oid - base) % 2 == 1
            var piece = ""
            if is_content {
                var pi = (oid - base) / 2
                piece = i2s(oid) + " 0 obj\n" + body + "\n" + stream_text(g_pages[pi])
            } else {
                piece = obj_text(oid, body)
            }
            seg_ascii(piece)
            off = off + str_len(piece)
        }
        oid = oid + 1
    }

    // 交叉引用表与尾部
    var n2 = len(offs)
    var x = "xref\n0 " + i2s(n2 + 1) + "\n0000000000 65535 f \n"
    var j: i64 = 0
    while j < n2 {
        x = x + pad10(offs[j]) + " 00000 n \n"
        j = j + 1
    }
    var bt = "trailer\n<< /Size " + i2s(n2 + 1) + " /Root 1 0 R >>\nstartxref\n" +
        i2s(off) + "\n%%EOF\n"
    seg_ascii(x + bt)
    return write_segs(path)
}

// 段列表 → 字节表 → 文件（一次写盘）
func write_segs(path: string) -> bool {
    var out = table_new_i64()
    var i: i64 = 0
    while i < len(g_seg_kind) {
        if g_seg_kind[i] == 0 {
            push_str(out, g_seg_str[i])
        } else {
            var f = font_bytes(g_seg_slot[i])
            var k: i64 = 0
            while k < len(f) {
                table_push(out, f[k])
                k = k + 1
            }
        }
        i = i + 1
    }
    return byte_write(path, out)
}

// ASCII 串 → 字节序列（ASCII 下 str_len == 字节数）
func push_str(t: ref table<i64>, s: string) {
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        table_push(t, str_byte(s, i))
        i = i + 1
    }
}

// ---------- 10 位零填充（xref 条目固定 10 位）----------
func pad10(v: i64) -> string {
    var s = i2s(v)
    while str_len(s) < 10 {
        s = "0" + s
    }
    return s
}

// ---------- 自检 ----------
// 取字节表第 i 字节（越界返回 -1）
func byte_at(t: table<i64>, i: i64) -> i64 {
    if i < 0 || i >= len(t) {
        return -1
    }
    return t[i]
}

func hexval(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 97 + 10
    }
    if c >= 65 && c <= 70 {
        return c - 65 + 10
    }
    return -1
}

// 从 b 起解析十进制（跳过空白）；失败 -1
func dec_at(d: table<i64>, b: i64) -> i64 {
    var i = b
    while i < len(d) && (d[i] == 10 || d[i] == 13 || d[i] == 32) {
        i = i + 1
    }
    var v: i64 = 0
    var got = false
    while i < len(d) && d[i] >= 48 && d[i] <= 57 {
        v = v * 10 + (d[i] - 48)
        i = i + 1
        got = true
    }
    if !got {
        return -1
    }
    return v
}

// 找最后一个 startxref 的位置；找不到 -1
func find_startxref(d: table<i64>) -> i64 {
    var n = len(d)
    var key = "startxref"
    var kl = str_len(key)
    var i = n - 12
    while i >= 0 {
        if byte_at(d, i) == 115 {
            var ok = true
            var j: i64 = 1
            while j < kl {
                if byte_at(d, i + j) != str_byte(key, j) {
                    ok = false
                    break
                }
                j = j + 1
            }
            if ok {
                return i
            }
        }
        i = i - 1
    }
    return -1
}

// 读回 xref 里的对象偏移表
func read_xref(path: string) -> table<i64> {
    var d = byte_read(path)
    var n = len(d)
    var pos = find_startxref(d)
    if pos < 0 {
        return table_new_i64()
    }
    var sx = dec_at(d, pos + 9)
    if sx < 0 || sx + 4 > n {
        return table_new_i64()
    }
    var q = sx + 4
    while q < n && byte_at(d, q) != 10 {
        q = q + 1
    }
    q = q + 1
    while q < n && byte_at(d, q) != 10 {
        q = q + 1
    }
    q = q + 1 + 20   // 跳过自由对象条目
    var offs = table_new_i64()
    while q + 20 <= n {
        if byte_at(d, q + 17) != 110 {
            break
        }
        var off: i64 = 0
        var z: i64 = 0
        while z < 10 {
            var c = byte_at(d, q + z)
            if c < 48 || c > 57 {
                return offs
            }
            off = off * 10 + (c - 48)
            z = z + 1
        }
        table_push(offs, off)
        q = q + 20
    }
    return offs
}

// ① 结构：startxref 指向 xref，且每个条目指向对象头
pub func verify(path: string) -> i64 {
    var d = byte_read(path)
    var n = len(d)
    if n < 32 {
        return -1
    }
    var pos = find_startxref(d)
    if pos < 0 {
        return -2
    }
    var sx = dec_at(d, pos + 9)
    if sx < 0 || sx + 4 > n {
        return -3
    }
    if byte_at(d, sx) != 120 || byte_at(d, sx + 1) != 114 || byte_at(d, sx + 2) != 101 || byte_at(d, sx + 3) != 102 {
        return -4
    }
    var offs = read_xref(path)
    if len(offs) == 0 {
        return -7
    }
    var i: i64 = 0
    while i < len(offs) {
        var o = offs[i]
        if o + 14 > n {
            return -6
        }
        var c0 = byte_at(d, o)
        if c0 < 48 || c0 > 57 {
            return -6
        }
        var tail_ok = false
        var s0: i64 = 0
        while s0 + 5 <= 14 {
            if byte_at(d, o + s0) == 32 && byte_at(d, o + s0 + 1) == 48 &&
               byte_at(d, o + s0 + 2) == 32 && byte_at(d, o + s0 + 3) == 111 &&
               byte_at(d, o + s0 + 4) == 98 {
                tail_ok = true
                break
            }
            s0 = s0 + 1
        }
        if !tail_ok {
            return -8
        }
        i = i + 1
    }
    g_verify_entries = len(offs)
    return 0
}

pub func verify_entries() -> i64 { return g_verify_entries }

// ② 对象成形性：每个对象有字典；流对象的 /Length 与实际字节数一致
pub func verify_objects(path: string) -> i64 {
    var d = byte_read(path)
    var n = len(d)
    var offs = read_xref(path)
    if len(offs) == 0 {
        return -52
    }
    var k: i64 = 0
    while k < len(offs) {
        var o = offs[k]
        var t = o
        while t < n && byte_at(d, t) != 10 {
            t = t + 1
        }
        t = t + 1
        if t + 1 >= n || byte_at(d, t) != 60 || byte_at(d, t + 1) != 60 {
            return -53
        }
        // 找 /Length
        var lend = t
        var lim = t + 4096
        if lim > n {
            lim = n
        }
        var lenpos: i64 = -1
        while lend + 8 < lim {
            if byte_at(d, lend) == 47 && byte_at(d, lend + 1) == 76 &&
               byte_at(d, lend + 2) == 101 && byte_at(d, lend + 3) == 110 &&
               byte_at(d, lend + 4) == 103 && byte_at(d, lend + 5) == 116 &&
               byte_at(d, lend + 6) == 104 {
                lenpos = lend + 7
                break
            }
            lend = lend + 1
        }
        if lenpos > 0 {
            var declared = dec_at(d, lenpos)
            if declared < 0 {
                return -54
            }
            var sp = t
            while sp + 6 < n && !(byte_at(d, sp) == 115 && byte_at(d, sp + 1) == 116 &&
                  byte_at(d, sp + 2) == 114 && byte_at(d, sp + 3) == 101 &&
                  byte_at(d, sp + 4) == 97 && byte_at(d, sp + 5) == 109) {
                sp = sp + 1
            }
            if sp + 7 >= n {
                return -55
            }
            var ds = sp + 7
            var es = ds
            while es + 9 < n && !(byte_at(d, es) == 101 && byte_at(d, es + 1) == 110 &&
                  byte_at(d, es + 2) == 100 && byte_at(d, es + 3) == 115 &&
                  byte_at(d, es + 4) == 116 && byte_at(d, es + 5) == 114 &&
                  byte_at(d, es + 6) == 101 && byte_at(d, es + 7) == 97 &&
                  byte_at(d, es + 8) == 109) {
                es = es + 1
            }
            if es + 9 >= n {
                return -56
            }
            var actual = es - ds
            if actual > 0 && byte_at(d, es - 1) == 10 {
                if declared != actual && declared != actual - 1 {
                    return -57
                }
            } else {
                if declared != actual {
                    return -57
                }
            }
        }
        k = k + 1
    }
    g_verify_objs = len(offs)
    return 0
}

pub func verify_objs() -> i64 { return g_verify_objs }

// ③ 内容：逐 GID 校验落在字体范围内（扫内存中的页内容）
pub func verify_content(path: string) -> i64 {
    var total: i64 = 0
    var bad: i64 = 0
    var nd: i64 = 0
    var pi: i64 = 0
    while pi < len(g_pages) {
        var t = g_pages[pi]
        var n = str_len(t)
        var i: i64 = 0
        while i < n {
            if str_byte(t, i) == 60 {
                var j = i + 1
                var hl: i64 = 0
                var allhex = true
                while j < n && str_byte(t, j) != 62 {
                    var c = str_byte(t, j)
                    if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)) {
                        allhex = false
                        break
                    }
                    hl = hl + 1
                    j = j + 1
                }
                if allhex && j < n && str_byte(t, j) == 62 && hl > 0 && hl % 4 == 0 {
                    var k: i64 = i + 1
                    while k < j {
                        var hi = hexval(str_byte(t, k)) * 16 + hexval(str_byte(t, k + 1))
                        var lo = hexval(str_byte(t, k + 2)) * 16 + hexval(str_byte(t, k + 3))
                        var g = hi * 256 + lo
                        total = total + 1
                        if g == 0 {
                            nd = nd + 1
                        }
                        k = k + 4
                    }
                    i = j
                }
            }
            i = i + 1
        }
        pi = pi + 1
    }
    if total == 0 {
        return -21
    }
    g_verify_gids = total
    g_verify_notdef = nd
    if nd * 20 > total {
        return -23
    }
    return 0
}

pub func verify_gids() -> i64 { return g_verify_gids }
pub func verify_notdef() -> i64 { return g_verify_notdef }

// ④ 版面：所有文本定位落在页面内（按 "Td" 反查 x、y，对行首前缀免疫）
pub func verify_layout(w: i64, h: i64) -> i64 {
    var pi: i64 = 0
    var segs: i64 = 0
    while pi < len(g_pages) {
        var lines = split_lines(g_pages[pi])
        var li: i64 = 0
        while li < len(lines) {
            var tk = split_spaces(lines[li])
            var ti: i64 = 0
            var tpos: i64 = -1
            while ti < len(tk) {
                if tk[ti] == "Td" {
                    tpos = ti
                    break
                }
                ti = ti + 1
            }
            if tpos >= 2 {
                var x = ascii_int(tk[tpos - 2])
                var y = ascii_int(tk[tpos - 1])
                if x < -20 || x > w + 20 || y < -20 || y > h + 20 {
                    return -30
                }
                segs = segs + 1
            }
            li = li + 1
        }
        pi = pi + 1
    }
    if segs == 0 {
        return -31
    }
    g_verify_segs = segs
    return 0
}

pub func verify_segs() -> i64 { return g_verify_segs }

// ⑤ 字形轮廓：用到的字形真有轮廓
pub func verify_outlines() -> i64 {
    var checked: i64 = 0
    var blank: i64 = 0
    var s: i64 = 0
    while s < font_count() {
        var (c, b) = used_outline_stats(s)
        checked = checked + c
        blank = blank + b
        s = s + 1
    }
    if checked == 0 {
        return -41
    }
    g_verify_checked = checked
    g_verify_empty = blank
    // 空字形占比过高说明 GID 指向了错误的字形（正常只有空格之类少数几个）
    if blank * 10 > checked {
        return -42
    }
    return 0
}

pub func verify_checked() -> i64 { return g_verify_checked }
pub func verify_empty() -> i64 { return g_verify_empty }

// 换行切分与占位符（供 verify_layout 用）
func split_lines(s: string) -> table<string> {
    var out = table_new_string()
    var n = str_len(s)
    var cur = ""
    var i: i64 = 0
    while i < n {
        if str_byte(s, i) == 10 {
            table_push(out, cur)
            cur = ""
        } else {
            cur = cur + str_from_code(str_byte(s, i))
        }
        i = i + 1
    }
    table_push(out, cur)
    return out
}

func split_spaces(s: string) -> table<string> {
    var out = table_new_string()
    var n = str_len(s)
    var cur = ""
    var i: i64 = 0
    while i < n {
        if str_byte(s, i) == 32 {
            if str_len(cur) > 0 {
                table_push(out, cur)
                cur = ""
            }
        } else {
            cur = cur + str_from_code(str_byte(s, i))
        }
        i = i + 1
    }
    if str_len(cur) > 0 {
        table_push(out, cur)
    }
    return out
}

func ascii_int(s: string) -> i64 {
    var n = str_len(s)
    if n == 0 {
        return -1
    }
    var v: i64 = 0
    var i: i64 = 0
    while i < n {
        var c = str_byte(s, i)
        if c < 48 || c > 57 {
            return -1
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

}
