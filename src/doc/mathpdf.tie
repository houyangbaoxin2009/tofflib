type tie<class>
// ============================================================================
// doc/mathpdf.tie —— tmath AST 的 PDF 排版（盒模型）
//
// 坐标约定：
//   * 横向 x 用 1/100 pt（与 pdf.shape_width 一致），纵向 y 用 pt；
//   * 每个节点的 y 是**基线**；measure 返回 (width, ascent, descent)，
//     ascent/descent 都是相对基线的 pt 数。
//   * 只依赖 pdf 原语（shape/text_shaped/hline），不碰 pdfdoc 的页面状态；
//     页面推进由调用方（pdfdoc.math）负责。
// ============================================================================

import "../pdf/pdf.tie" as pdf
import "./tmath.tie" as tmath

namespace mathpdf {

const SLOT: i64 = 0;

// SVG 输出模式：g_svg=1 时 dtext/dline 写入 SVG 缓冲，且 y 偏移方向翻转
// （PDF y 向上、SVG y 向下）。measure 与方向无关，两种产物共用同一份盒模型。
var g_svg: i64 = 0;
var g_svgparts: table<string>;
var g_ysign: i64 = 1;

func ysf(dy: i64) -> i64 {
    if g_svg == 1 {
        return 0 - dy
    }
    return dy
}

func xml_esc(t: string) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < len(t) {
        var b: i64 = str_byte(t, i)
        if b == 38 {
            sb_append(sb, "&amp;")
        } else if b == 60 {
            sb_append(sb, "&lt;")
        } else if b == 62 {
            sb_append(sb, "&gt;")
        } else {
            sb_append_byte(sb, b)
        }
        i = i + 1
    }
    return sb_build(sb)
}

func dtext(pg: i64, x: i64, y: i64, size: i64, txt: string) {
    if g_svg == 1 {
        table_push(g_svgparts, "<text x=\"" + pdf.f2s(x) + "\" y=\"" + pdf.f2s(y * 100) + "\" font-size=\"" + pdf.f2s(size * 100) + "\" font-family=\"TMathPreview\">" + xml_esc(txt) + "</text>\n")
        return
    }
    pdf.text_shaped(pg, x / 100, y, size * 100, pdf.shape(SLOT, SLOT, txt))
}

// 数学变量用合成斜体；数字、运算符、函数名保持直立。
func dtext_i(pg: i64, x: i64, y: i64, size: i64, txt: string) {
    if g_svg == 1 {
        table_push(g_svgparts, "<text x=\"" + pdf.f2s(x) + "\" y=\"" + pdf.f2s(y * 100) + "\" font-size=\"" + pdf.f2s(size * 100) + "\" font-family=\"TMathPreview\" font-style=\"italic\">" + xml_esc(txt) + "</text>\n")
        return
    }
    pdf.text_shaped_slant(pg, x / 100, y, size * 100, pdf.shape(SLOT, SLOT, txt))
}

func tw(txt: string, size: i64) -> i64 {
    return pdf.shape_width(pdf.shape(SLOT, SLOT, txt), size)
}

func dseg(pg: i64, x1: i64, y1: i64, x2: i64, y2: i64, w: i64) {
    if g_svg == 1 {
        table_push(g_svgparts, "<line x1=\"" + pdf.f2s(x1) + "\" y1=\"" + pdf.f2s(y1 * 100) + "\" x2=\"" + pdf.f2s(x2) + "\" y2=\"" + pdf.f2s(y2 * 100) + "\" stroke=\"black\" stroke-width=\"" + pdf.f2s(w) + "\"/>\n")
        return
    }
    pdf.seg(pg, x1 / 100, y1, x2 / 100, y2, w)
}

func dline(pg: i64, x1: i64, y: i64, x2: i64, w: i64) {
    if g_svg == 1 {
        table_push(g_svgparts, "<line x1=\"" + pdf.f2s(x1) + "\" y1=\"" + pdf.f2s(y * 100) + "\" x2=\"" + pdf.f2s(x2) + "\" y2=\"" + pdf.f2s(y * 100) + "\" stroke=\"black\" stroke-width=\"" + pdf.f2s(w) + "\"/>\n")
        return
    }
    pdf.hline(pg, x1 / 100, y, x2 / 100, w)
}

// ---------- 度量 ----------

pub func measure(id: i64, size: i64) -> (w: i64, asc: i64, desc: i64) {
    var k = tmath.kind_of(id)
    if k == "num" || k == "id" || k == "sym" || k == "text" {
        return (tw(tmath.pay_of(id), size), size * 72 / 100, size * 22 / 100)
    }
    if k == "add" || k == "subtract" || k == "rel" || k == "mul" || k == "slash" {
        var (aw, aa, ad) = measure(tmath.kid_a(id), size)
        var (bw, ba, bd) = measure(tmath.kid_b(id), size)
        var op = "+"
        if k == "subtract" {
            op = "−"
        } else if k == "rel" {
            op = tmath.pay_of(id)
        } else if k == "mul" {
            op = "·"
        } else if k == "slash" {
            op = "/"
        }
        var ow = tw(op, size) + size * 60 / 100
        var asc = aa
        if ba > asc {
            asc = ba
        }
        var desc = ad
        if bd > desc {
            desc = bd
        }
        return (aw + ow + bw, asc, desc)
    }
    if k == "neg" {
        var (nw, na, nd) = measure(tmath.kid_a(id), size)
        return (nw + tw("−", size), na, nd)
    }
    if k == "div" {
        var s2 = size - 1
        if s2 < 6 {
            s2 = 6
        }
        var (nw, na, nd) = measure(tmath.kid_a(id), s2)
        var (dw, da, dd) = measure(tmath.kid_b(id), s2)
        var w = nw
        if dw > w {
            w = dw
        }
        return (w + 500, 3 + nd + na, 3 + da + dd)
    }
    if k == "pow" {
        var (bw2, ba2, bd2) = measure(tmath.kid_a(id), size)
        var ss = size * 3 / 4
        if ss < 6 {
            ss = 6
        }
        var (sw, sa, sd) = measure(tmath.kid_b(id), ss)
        var asc = ba2
        var up = size * 45 / 100 + sa
        if up > asc {
            asc = up
        }
        return (bw2 + sw, asc, bd2)
    }
    if k == "sub" {
        var (bw3, ba3, bd3) = measure(tmath.kid_a(id), size)
        var ss2 = size * 3 / 4
        if ss2 < 6 {
            ss2 = 6
        }
        var (sw2, sa2, sd2) = measure(tmath.kid_b(id), ss2)
        var desc = bd3
        var dn = size * 25 / 100 + sd2
        if dn > desc {
            desc = dn
        }
        return (bw3 + sw2, ba3, desc)
    }
    if k == "sqrt" {
        var (iw, ia, id2) = measure(tmath.kid_a(id), size)
        var d0 = size / 4
        if id2 > d0 {
            d0 = id2
        }
        return (iw + size * 95 / 100 + 100, ia + 3, d0)
    }

    if k == "root" {
        var (iw2, ia2, id3) = measure(tmath.kid_b(id), size)
        var (dw2, da2, dd2) = measure(tmath.kid_a(id), 6)
        var d0b = size / 4
        if id3 > d0b {
            d0b = id3
        }
        return (dw2 + iw2 + size * 135 / 100 + 200, ia2 + 9, d0b)
    }

    if k == "abs" || k == "norm" {
        var (iw3, ia3, id4) = measure(tmath.kid_a(id), size)
        var bar = "|"
        if k == "norm" {
            bar = "‖"
        }
        return (iw3 + tw(bar, size) * 2, ia3, id4)
    }
    if k == "delim" {
        var (iw4, ia4, id5) = measure(tmath.kid_a(id), size)
        return (iw4 + tw("(", size) * 2, ia4, id5)
    }
    if k == "acc" {
        return measure(tmath.kid_a(id), size)
    }
    if k == "diff" {
        var (iw5, ia5, id6) = measure(tmath.kid_a(id), size)
        return (iw5 + tw("d", size), ia5, id6)
    }
    if k == "func" {
        var (aw, aa, ad) = measure(tmath.kid_a(id), size)
        var fw = tw(tmath.pay_of(id) + "(", size)
        var w = fw + aw + tw(")", size)
        var asc = aa
        var desc = ad
        if tmath.kid_b(id) >= 0 {
            var (bw, ba, bd) = measure(tmath.kid_b(id), size)
            w = w + tw(", ", size) + bw
            if ba > asc {
                asc = ba
            }
            if bd > desc {
                desc = bd
            }
        }
        return (w, asc, desc)
    }
    if k == "big" {
        var g = tmath.glyph(tmath.pay_of(id))
        var gw = tw(g, size + 4)
        var lw = 0
        var la = 0
        var ld = 0
        var uw = 0
        var ua = 0
        var ud = 0
        if tmath.kid_a(id) >= 0 {
            var (lw0, la0, ld0) = measure(tmath.kid_a(id), size * 3 / 4)
            lw = lw0
            la = la0
            ld = ld0
        }
        if tmath.kid_b(id) >= 0 {
            var (uw0, ua0, ud0) = measure(tmath.kid_b(id), size * 3 / 4)
            uw = uw0
            ua = ua0
            ud = ud0
        }
        var opw = gw
        if lw > opw {
            opw = lw
        }
        if uw > opw {
            opw = uw
        }
        var (bw2, ba2, bd2) = measure(tmath.kid_c(id), size)
        var asc2 = size * 100 / 100 + ua + ud
        if ba2 > asc2 {
            asc2 = ba2
        }
        var desc2 = size * 80 / 100 + la + ld
        if bd2 > desc2 {
            desc2 = bd2
        }
        return (opw + 300 + bw2, asc2, desc2)
    }
    if k == "mat" {
        var rows = tmath.mat_rows(id)
        var cols = tmath.mat_cols(id)
        var colw: table<i64> = table_new_i64()
        var rowh: table<i64> = table_new_i64()
        var i: i64 = 0
        while i < cols {
            table_push(colw, 0)
            i = i + 1
        }
        var r: i64 = 0
        while r < rows {
            table_push(rowh, size)
            r = r + 1
        }
        r = 0
        while r < rows {
            var c: i64 = 0
            while c < cols {
                var (cw, ca, cd) = measure(tmath.mat_cell(id, r, c), size)
                if cw > colw[c] {
                    colw[c] = cw
                }
                if ca + cd > rowh[r] {
                    rowh[r] = ca + cd
                }
                c = c + 1
            }
            r = r + 1
        }
        var h: i64 = 0
        var r2: i64 = 0
        while r2 < rows {
            h = h + rowh[r2] + 2
            r2 = r2 + 1
        }
        var bh0 = h * 13 / 10
        if bh0 < 10 {
            bh0 = 10
        }
        var bw0 = tw("(", bh0)
        var w2: i64 = bw0 * 2 + 200
        var c2: i64 = 0
        while c2 < cols {
            w2 = w2 + colw[c2] + 500
            c2 = c2 + 1
        }
        return (w2, h / 2, h / 2)
    }
    if k == "cases" {
        var rows3 = tmath.case_rows(id)
        var w1: i64 = 0
        var w2: i64 = 0
        var rh: i64 = 0
        var r3: i64 = 0
        while r3 < rows3 {
            var (a1, aa1, ad1) = measure(tmath.case_cell(id, r3, 0), size)
            var (a2, aa2, ad2) = measure(tmath.case_cell(id, r3, 1), size)
            if a1 > w1 {
                w1 = a1
            }
            if a2 > w2 {
                w2 = a2
            }
            if aa1 + ad1 > rh {
                rh = aa1 + ad1
            }
            if aa2 + ad2 > rh {
                rh = aa2 + ad2
            }
            r3 = r3 + 1
        }
        var hh = rows3 * (rh + 2)
        return (800 + w1 + 800 + w2 + 200, hh / 2, hh / 2)
    }
    return (tw(tmath.plain(id), size), size * 72 / 100, size * 22 / 100)
}

// ---------- 绘制 ----------

pub func draw(pg: i64, id: i64, x: i64, y: i64, size: i64) {
    var k = tmath.kind_of(id)
    if k == "num" || k == "id" || k == "sym" || k == "text" {
        if k == "id" {
            dtext_i(pg, x, y, size, tmath.pay_of(id))
        } else {
            dtext(pg, x, y, size, tmath.pay_of(id))
        }
        return
    }
    if k == "add" || k == "subtract" || k == "rel" || k == "mul" || k == "slash" {
        var (aw, aa, ad) = measure(tmath.kid_a(id), size)
        var op = "+"
        if k == "subtract" {
            op = "−"
        } else if k == "rel" {
            op = tmath.pay_of(id)
        } else if k == "mul" {
            op = "·"
        } else if k == "slash" {
            op = "/"
        }
        var ow = tw(op, size) + size * 60 / 100
        draw(pg, tmath.kid_a(id), x, y, size)
        dtext(pg, x + aw + size * 30 / 100, y, size, op)
        draw(pg, tmath.kid_b(id), x + aw + ow, y, size)
        return
    }
    if k == "neg" {
        dtext(pg, x, y, size, "−")
        draw(pg, tmath.kid_a(id), x + tw("−", size), y, size)
        return
    }
    if k == "div" {
        var s2 = size - 1
        if s2 < 6 {
            s2 = 6
        }
        var (nw, na, nd) = measure(tmath.kid_a(id), s2)
        var (dw, da, dd) = measure(tmath.kid_b(id), s2)
        var w = nw
        if dw > w {
            w = dw
        }
        var cx = x + (w + 500) / 2
        draw(pg, tmath.kid_a(id), cx - nw / 2, y + ysf(3 + nd), s2)
        dline(pg, x + 100, y, x + w + 400, 50)
        draw(pg, tmath.kid_b(id), cx - dw / 2, y - ysf(3 + da), s2)
        return
    }
    if k == "pow" {
        var (bw, ba, bd) = measure(tmath.kid_a(id), size)
        draw(pg, tmath.kid_a(id), x, y, size)
        var ss = size * 3 / 4
        if ss < 6 {
            ss = 6
        }
        draw(pg, tmath.kid_b(id), x + bw, y + ysf(size * 45 / 100), ss)
        return
    }
    if k == "sub" {
        var (bw2, ba2, bd2) = measure(tmath.kid_a(id), size)
        draw(pg, tmath.kid_a(id), x, y, size)
        var ss2 = size * 3 / 4
        if ss2 < 6 {
            ss2 = 6
        }
        draw(pg, tmath.kid_b(id), x + bw2, y - ysf(size * 25 / 100), ss2)
        return
    }
    if k == "sqrt" {
        var (iw, ia, id2) = measure(tmath.kid_a(id), size)
        var d0 = size / 4
        if id2 > d0 {
            d0 = id2
        }
        var w1 = size * 30
        var w2 = size * 45
        var hgt = ia + 3
        dseg(pg, x, y, x + w1, y - ysf(d0), 60)
        dseg(pg, x + w1, y - ysf(d0), x + w1 + w2, y + ysf(hgt), 60)
        dline(pg, x + w1 + w2, y + ysf(hgt), x + w1 + w2 + iw + 100, 45)
        draw(pg, tmath.kid_a(id), x + w1 + w2 + 100, y, size)
        return
    }

    if k == "root" {
        var (iw2, ia2, id3) = measure(tmath.kid_b(id), size)
        var (dw2, da2, dd2) = measure(tmath.kid_a(id), 6)
        var d0b = size / 4
        if id3 > d0b {
            d0b = id3
        }
        var w1 = size * 30
        var w2 = size * 45
        var hgt = ia2 + 3
        dtext(pg, x, y + ysf(hgt + 6), 6, tmath.plain(tmath.kid_a(id)))
        dseg(pg, x + dw2, y, x + dw2 + w1, y - ysf(d0b), 60)
        dseg(pg, x + dw2 + w1, y - ysf(d0b), x + dw2 + w1 + w2, y + ysf(hgt), 60)
        dline(pg, x + dw2 + w1 + w2, y + ysf(hgt), x + dw2 + w1 + w2 + iw2 + 100, 45)
        draw(pg, tmath.kid_b(id), x + dw2 + w1 + w2 + 100, y, size)
        return
    }

    if k == "abs" || k == "norm" {
        var bar = "|"
        if k == "norm" {
            bar = "‖"
        }
        var bw3 = tw(bar, size)
        dtext(pg, x, y, size, bar)
        draw(pg, tmath.kid_a(id), x + bw3, y, size)
        var (iw3, ia3, id4) = measure(tmath.kid_a(id), size)
        dtext(pg, x + bw3 + iw3, y, size, bar)
        return
    }
    if k == "delim" {
        var pw = tw("(", size)
        dtext(pg, x, y, size, "(")
        draw(pg, tmath.kid_a(id), x + pw, y, size)
        var (iw4, ia4, id5) = measure(tmath.kid_a(id), size)
        dtext(pg, x + pw + iw4, y, size, ")")
        return
    }
    if k == "acc" {
        draw(pg, tmath.kid_a(id), x, y, size)
        var (iw5, ia5, id6) = measure(tmath.kid_a(id), size)
        dline(pg, x, y + ysf(ia5 + 1), x + iw5, 40)
        return
    }
    if k == "diff" {
        dtext(pg, x, y, size, "d")
        draw(pg, tmath.kid_a(id), x + tw("d", size), y, size)
        return
    }
    if k == "func" {
        dtext(pg, x, y, size, tmath.pay_of(id) + "(")
        var fw = tw(tmath.pay_of(id) + "(", size)
        var (aw2, aa2, ad2) = measure(tmath.kid_a(id), size)
        draw(pg, tmath.kid_a(id), x + fw, y, size)
        var cx2 = x + fw + aw2
        if tmath.kid_b(id) >= 0 {
            dtext(pg, cx2, y, size, ", ")
            var cw = tw(", ", size)
            draw(pg, tmath.kid_b(id), cx2 + cw, y, size)
            cx2 = cx2 + cw + measure(tmath.kid_b(id), size).w
        }
        dtext(pg, cx2, y, size, ")")
        return
    }
    if k == "big" {
        var g = tmath.glyph(tmath.pay_of(id))
        var gw = tw(g, size + 4)
        var lw = 0
        var la = 0
        var ld = 0
        var uw = 0
        var ua = 0
        var ud = 0
        if tmath.kid_a(id) >= 0 {
            var (lw0, la0, ld0) = measure(tmath.kid_a(id), size * 3 / 4)
            lw = lw0
            la = la0
            ld = ld0
        }
        if tmath.kid_b(id) >= 0 {
            var (uw0, ua0, ud0) = measure(tmath.kid_b(id), size * 3 / 4)
            uw = uw0
            ua = ua0
            ud = ud0
        }
        var opw = gw
        if lw > opw {
            opw = lw
        }
        if uw > opw {
            opw = uw
        }
        var cxo = x + opw / 2
        if tmath.kid_b(id) >= 0 {
            draw(pg, tmath.kid_b(id), cxo - uw / 2, y + ysf(size * 95 / 100 + ud), size * 3 / 4)
        }
        if tmath.kid_a(id) >= 0 {
            draw(pg, tmath.kid_a(id), cxo - lw / 2, y - ysf(size * 62 / 100 + la), size * 3 / 4)
        }
        dtext(pg, cxo - gw / 2, y, size + 4, g)
        draw(pg, tmath.kid_c(id), x + opw + 300, y, size)
        return
    }
    if k == "mat" {
        var (mw, ma, md) = measure(id, size)
        var rows = tmath.mat_rows(id)
        var cols = tmath.mat_cols(id)
        var colw2: table<i64> = table_new_i64()
        var rowh2: table<i64> = table_new_i64()
        var i2: i64 = 0
        while i2 < cols {
            table_push(colw2, 0)
            i2 = i2 + 1
        }
        var r4: i64 = 0
        while r4 < rows {
            table_push(rowh2, size)
            r4 = r4 + 1
        }
        r4 = 0
        while r4 < rows {
            var c4: i64 = 0
            while c4 < cols {
                var (cw2, ca2, cd2) = measure(tmath.mat_cell(id, r4, c4), size)
                if cw2 > colw2[c4] {
                    colw2[c4] = cw2
                }
                if ca2 + cd2 > rowh2[r4] {
                    rowh2[r4] = ca2 + cd2
                }
                c4 = c4 + 1
            }
            r4 = r4 + 1
        }
        // 矩阵括号：字号按总高放大，基线对齐底边
        var bh = (ma + md) * 13 / 10
        if bh < 10 {
            bh = 10
        }
        var by = y - ysf(md + 1)
        var bw1 = tw("(", bh)
        dtext(pg, x, by, bh, "(")
        dtext(pg, x + mw - bw1, by, bh, ")")
        var top = y + ysf(ma)
        r4 = 0
        while r4 < rows {
            var cx3 = x + tw("(", (ma + md) * 13 / 10) + 100
            var c5: i64 = 0
            while c5 < cols {
                var (cw3, ca3, cd3) = measure(tmath.mat_cell(id, r4, c5), size)
                draw(pg, tmath.mat_cell(id, r4, c5), cx3 + (colw2[c5] - cw3) / 2, top - ysf(ca3), size)
                cx3 = cx3 + colw2[c5] + 500
                c5 = c5 + 1
            }
            top = top - ysf(rowh2[r4] + 2)
            r4 = r4 + 1
        }
        return
    }
    if k == "cases" {
        var (hw, ha, hd) = measure(id, size)
        var rows5 = tmath.case_rows(id)
        var brace = ha + hd
        if brace < 10 {
            brace = 10
        }
        if brace > 44 {
            brace = 30
        }
        dtext(pg, x, y + ysf(ha - brace * 3 / 4), brace, "{")
        var top2 = y + ysf(ha)
        var r5: i64 = 0
        while r5 < rows5 {
            var (w1, a1, d1) = measure(tmath.case_cell(id, r5, 0), size)
            var rowy = top2 - ysf(a1)
            draw(pg, tmath.case_cell(id, r5, 0), x + 800, rowy, size)
            draw(pg, tmath.case_cell(id, r5, 1), x + 800 + w1 + 800, rowy, size)
            top2 = top2 - ysf(a1 + d1 + 2)
            r5 = r5 + 1
        }
        return
    }
    dtext(pg, x, y, size, tmath.plain(id))
}


// ---------- 长公式自动断行（只按顶层 rel/add 链切分） ----------

var mp_item: table<i64>;
var mp_opt: table<string>;
var mp_isop: table<i64>;

func mp_reset() {
    table_trunc(mp_item, 0)
    table_trunc(mp_opt, 0)
    table_trunc(mp_isop, 0)
}

func mp_push(id: i64, opt: string, isop: i64) {
    table_push(mp_item, id)
    table_push(mp_opt, opt)
    table_push(mp_isop, isop)
}

func flatten_chain(cur: i64) {
    var k = tmath.kind_of(cur)
    if k == "rel" || k == "add" || k == "subtract" || k == "mul" {
        flatten_chain(tmath.kid_a(cur))
        var opt = tmath.pay_of(cur)
        if opt == "" {
            opt = " · "
        }
        mp_push(-1, opt, 1)
        flatten_chain(tmath.kid_b(cur))
    } else {
        mp_push(cur, "", 0)
    }
}

func mp_item_metrics(idx: i64, size: i64) -> (w: i64, asc: i64, desc: i64) {
    if mp_isop[idx] == 1 {
        return (tw(mp_opt[idx], size), size * 72 / 100, size * 22 / 100)
    }
    return measure(mp_item[idx], size)
}

pub func measure_wrapped(id: i64, size: i64, maxw: i64) -> (w: i64, asc: i64, desc: i64) {
    mp_reset()
    flatten_chain(id)
    var n = len(mp_item)
    if n == 0 {
        return measure(id, size)
    }
    var lines = 1
    var curw: i64 = 0
    var i: i64 = 0
    var firstasc: i64 = 0
    var firstdesc: i64 = 0
    var lastdesc: i64 = 0
    var maxw2: i64 = 0
    while i < n {
        var (iw, ia, id2) = mp_item_metrics(i, size)
        if curw + iw > maxw && curw > 0 {
            lines = lines + 1
            if maxw2 < curw {
                maxw2 = curw
            }
            curw = 0
        }
        if lines == 1 {
            firstasc = ia
            firstdesc = id2
        }
        lastdesc = id2
        curw = curw + iw
        i = i + 1
    }
    if maxw2 < curw {
        maxw2 = curw
    }
    var asc = firstasc
    if lines > 1 {
        asc = firstasc + (lines - 1) * (firstasc + firstdesc + 6)
    }
    var desc = firstdesc
    if lines > 1 {
        desc = lastdesc
    }
    return (maxw2, asc, desc)
}

pub func draw_wrapped(pg: i64, id: i64, x: i64, y: i64, size: i64, maxw: i64) {
    mp_reset()
    flatten_chain(id)
    var n = len(mp_item)
    var cx = x
    var ybase = y
    var first = true
    var i: i64 = 0
    while i < n {
        var (iw, ia, id2) = mp_item_metrics(i, size)
        if cx + iw - x > maxw && !first && mp_isop[i] == 1 {
            cx = x
            ybase = ybase - (size * 72 / 100 + size * 22 / 100 + 6)
        }
        if mp_isop[i] == 1 {
            dtext(pg, cx, ybase, size, mp_opt[i])
        } else {
            draw(pg, mp_item[i], cx, ybase, size)
        }
        cx = cx + iw
        first = false
        i = i + 1
    }
}


// 渲染公式为 SVG（预览/调试出口；与 PDF 共用同一份盒模型与度量）。
// 返回 <svg>…</svg> 文本；解析失败返回空串。
pub func svg(src: string, size: i64) -> string {
    var id = tmath.parse(src)
    if id < 0 {
        return ""
    }
    var (w, asc, desc) = measure(id, size)
    var margin: i64 = 600
    var W = w + margin * 2
    var H = (asc + desc) * 100 + margin * 2
    g_svgparts = table_new_string()
    g_svg = 1
    g_ysign = -1
    table_push(g_svgparts, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + pdf.f2s(W) + "\" height=\"" + pdf.f2s(H) + "\" viewBox=\"0 0 " + pdf.f2s(W) + " " + pdf.f2s(H) + "\">\n")
    table_push(g_svgparts, "<rect x=\"0\" y=\"0\" width=\"" + pdf.f2s(W) + "\" height=\"" + pdf.f2s(H) + "\" fill=\"white\"/>\n")
    draw(0, id, margin, margin / 100 + asc, size)
    g_svg = 0
    g_ysign = 1
    table_push(g_svgparts, "</svg>\n")
    var out = ""
    var i: i64 = 0
    while i < len(g_svgparts) {
        out = out + g_svgparts[i]
        i = i + 1
    }
    return out
}

}   // namespace mathpdf
