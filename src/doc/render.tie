type tie<class>
// ============================================================================
// doc/render.tie —— tdoc 块流 → 各格式渲染后端（tofflib 内部模块）
//
// 渲染器只消费扁平块流（model.tie 协议），不依赖 table<table>；
// 校验失败返回 false（错误定位用 doc.validate）。
// ============================================================================
import "../office/docx.tie" as dx
import "../xml/ooxml.tie" as ox
import "../office/xlsx.tie" as xs
import "../office/pptx.tie" as px
import "./pdfdoc.tie" as pdoc
import "./model.tie" as doc
import "../img/imgmeta.tie" as imgmeta

namespace render {

func to_i(s: string) -> i64 {
    return parse_int(s)
}

func is_heading(k: string) -> bool {
    return str_len(k) == 2 && str_byte(k, 0) == 104 && str_byte(k, 1) >= 49 && str_byte(k, 1) <= 57
}

// 代码块：按行拆开，每行一个等宽段落（行内换行在 OOXML run 里非法）。
func code_lines(sb: i64, src: string) -> void {
    var i: i64 = 0
    var n: i64 = str_len(src)
    var start: i64 = 0
    while i <= n {
        if i == n || str_byte(src, i) == 10 {
            var line: string = str_sub_bytes(src, start, i - start)
            var rr = table_new_string()
            table_push(rr, dx.run_font(line, "Consolas", 18, false))
            table_append_sb(sb, dx.paragraph_runs(rr))
            start = i + 1
        }
        i = i + 1
    }
}

func table_append_sb(sb: i64, s2: string) -> void {
    sb_append(sb, s2)
}

// 渲染 docx；t 为 model.tie 块流。成功写盘返回 true。
// run 编码："b|加粗" / "i|斜体" / "m|等宽" / "link|文本|URL"；无前缀=普通文本。
func run_parts(r: string) -> table<string> {
    var out = table_new_string()
    var n = str_len(r)
    var cur = ""
    var i: i64 = 0
    while i < n {
        var c = str_char(r, i)
        if c == "|" {
            table_push(out, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    table_push(out, cur)
    return out
}

func is_run_tag(t: string) -> bool {
    return t == "b" || t == "i" || t == "m" || t == "link"
}

func run_text(r: string) -> string {
    var ps = run_parts(r)
    if len(ps) >= 2 && is_run_tag(ps[0]) {
        return ps[1]
    }
    return r
}

func docx_run(r: string) -> string {
    var ps = run_parts(r)
    if len(ps) == 2 {
        if ps[0] == "b" {
            return dx.run_font(ps[1], "", 0, true)
        }
        if ps[0] == "m" {
            return dx.run_font(ps[1], "Consolas", 0, false)
        }
    }
    if len(ps) == 3 && ps[0] == "link" {
        return dx.link(ps[1], ps[2], "")
    }
    return dx.run(r)
}

// 页眉/页脚：按 {page} 占位切分（逐码点比对，占位为 ASCII）。
func hf_split(s: string) -> (head: string, tail: string, hit: bool) {
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i + 6 <= n {
        if str_char(s, i) == "{" && str_char(s, i + 1) == "p" && str_char(s, i + 2) == "a" &&
            str_char(s, i + 3) == "g" && str_char(s, i + 4) == "e" && str_char(s, i + 5) == "}" {
            var h: string = ""
            var j: i64 = 0
            while j < i {
                h = h + str_char(s, j)
                j = j + 1
            }
            var tl: string = ""
            var t2: i64 = i + 6
            while t2 < n {
                tl = tl + str_char(s, t2)
                t2 = t2 + 1
            }
            return (h, tl, true)
        }
        i = i + 1
    }
    return (s, "", false)
}

// 页眉/页脚文本 → docx run 列表：{page} 展开为 PAGE 域。
func hf_runs(s: string) -> table<string> {
    var out = table_new_string()
    var (a, b, hit) = hf_split(s)
    if hit {
        if str_len(a) > 0 {
            table_push(out, dx.run(a))
        }
        table_push(out, dx.page_field())
        if str_len(b) > 0 {
            table_push(out, dx.run(b))
        }
    } else if str_len(s) > 0 {
        table_push(out, dx.run(s))
    }
    return out
}

// 脚注 run（fn| 前缀）的正文：去掉前三个字节前缀，其余按码点拼接。
func fn_body(r: string) -> string {
    var out: string = ""
    var i: i64 = 3
    var n: i64 = str_len(r)
    while i < n {
        out = out + str_char(r, i)
        i = i + 1
    }
    return out
}

pub func docx(path: string, t: table<string>) -> bool {
    var verr: string = doc.validate(t)
    if str_len(verr) > 0 {
        return false
    }
    var has_cover: i64 = 0
    var ci: i64 = 0
    while ci < len(t) {
        if t[ci] == "cover" {
            has_cover = 1
        }
        ci = ci + 1
    }
    var sb = string_builder()
    var hdr: string = ""
    var ftr: string = ""
    var ftr_set: i64 = 0
    var fn_no: i64 = 0
    var notes = table_new_string()
    var media_exts = table_new_string()
    var media_datas = table_new_string()
    if has_cover == 0 {
        sb_append(sb, dx.heading(t[1], 1))
    }
    var n: i64 = len(t)
    var i: i64 = 2
    while i < n {
        var k: string = t[i]
        if is_heading(k) {
            sb_append(sb, dx.heading(t[i + 1], str_byte(k, 1) - 48))
            i = i + 2
        } else if k == "p" {
            sb_append(sb, dx.paragraph(t[i + 1]))
            i = i + 2
        } else if k == "b" {
            var rr = table_new_string()
            table_push(rr, dx.run_font(t[i + 1], "", 0, true))
            sb_append(sb, dx.paragraph_runs(rr))
            i = i + 2
        } else if k == "center" {
            var rr = table_new_string()
            table_push(rr, dx.run(t[i + 1]))
            sb_append(sb, dx.para_center(rr))
            i = i + 2
        } else if k == "note" {
            sb_append(sb, dx.callout_xml(t[i + 1]))
            i = i + 2
        } else if k == "quote" {
            sb_append(sb, dx.quote_xml(t[i + 1]))
            i = i + 2
        } else if k == "hr" {
            sb_append(sb, dx.hr_xml())
            i = i + 1
        } else if k == "cap" {
            sb_append(sb, dx.caption(t[i + 1], "表"))
            i = i + 2
        } else if k == "right" || k == "just" {
            var kids = table_new_string()
            table_push(kids, docx_run(t[i + 1]))
            var al: string = "right"
            if k == "just" {
                al = "both"
            }
            sb_append(sb, dx.para_ex(kids, al, 0, 0, 0))
            i = i + 2
        } else if k == "para" {
            var kids2 = table_new_string()
            i = i + 1
            while i < len(t) && !doc.is_block_kind(t[i]) {
                if doc.is_fn_token(t[i]) {
                    fn_no = fn_no + 1
                    table_push(notes, fn_body(t[i]))
                    table_push(kids2, dx.run("[" + to_string(fn_no) + "]"))
                    table_push(kids2, dx.footnote_ref(fn_no))
                } else {
                    table_push(kids2, docx_run(t[i]))
                }
                i = i + 1
            }
            sb_append(sb, dx.para_ex(kids2, "left", 0, 0, 0))
        } else if k == "header" {
            hdr = t[i + 1]
            i = i + 2
        } else if k == "footer" {
            ftr = t[i + 1]
            ftr_set = 1
            i = i + 2
        } else if k == "note_ref" {
            fn_no = fn_no + 1
            table_push(notes, t[i + 1])
            var nr = table_new_string()
            table_push(nr, dx.run("[" + to_string(fn_no) + "]"))
            table_push(nr, dx.footnote_ref(fn_no))
            sb_append(sb, dx.paragraph_runs(nr))
            i = i + 2
        } else if k == "ul" || k == "ol" {
            var cnt: i64 = to_i(t[i + 1])
            var items = table_new_string()
            var j: i64 = 0
            while j < cnt {
                table_push(items, t[i + 2 + j])
                j = j + 1
            }
            if k == "ul" {
                sb_append(sb, dx.bullets(items, 1))
            } else {
                sb_append(sb, dx.numbers(items, 1))
            }
            i = i + 2 + cnt
        } else if k == "tbl" {
            var cols: i64 = to_i(t[i + 1])
            var rows: i64 = to_i(t[i + 2])
            var cells = table_new_string()
            var total: i64 = cols * (rows + 1)
            var j: i64 = 0
            while j < total {
                table_push(cells, t[i + 3 + j])
                j = j + 1
            }
            sb_append(sb, dx.tbl_flat(cols, cells, 0))
            i = i + 3 + total
        } else if k == "tblw" {
            var cols: i64 = to_i(t[i + 1])
            var rows: i64 = to_i(t[i + 2])
            var wts = table_new_string()
            var wj: i64 = 0
            while wj < cols {
                table_push(wts, t[i + 3 + wj])
                wj = wj + 1
            }
            var cells = table_new_string()
            var total: i64 = cols * (rows + 1)
            var j: i64 = 0
            while j < total {
                table_push(cells, t[i + 3 + cols + j])
                j = j + 1
            }
            sb_append(sb, dx.tbl_flat_w(cols, cells, wts))
            i = i + 3 + cols + total
        } else if k == "code" {
            sb_append(sb, dx.codeblock_xml(t[i + 2], "F3F3F3"))
            i = i + 3
        } else if k == "page" {
            sb_append(sb, dx.page_break())
            i = i + 1
        } else if k == "sec" {
            sb_append(sb, dx.page_break())
            sb_append(sb, dx.heading(t[i + 1], 1))
            i = i + 2
        } else if k == "link" {
            sb_append(sb, dx.link(t[i + 1], t[i + 2], ""))
            i = i + 3
        } else if k == "img" {
            // 真嵌入：JPEG/PNG（GIF/BMP 也接受）写入 word/media/imageN.<ext>，
            // 正文用居中 drawing（wp:inline + a:blip r:embed=rId99+i）。
            var ipath: string = t[i + 1]
            var iwpt: i64 = to_i(t[i + 2])
            var icap: string = t[i + 3]
            var ik = imgmeta.kind(ipath)
            var (ipw, iph) = imgmeta.dims(ipath)
            if ik < 1 || ipw <= 0 || iph <= 0 {
                sb_append(sb, dx.paragraph("[图片: " + imgmeta.base_name(ipath) + "]"))
            } else {
                if iwpt <= 0 {
                    iwpt = ipw
                }
                if iwpt > 451 {
                    iwpt = 451
                }
                var ihpt: i64 = iph * iwpt / ipw
                if ihpt > 620 {
                    ihpt = 620
                    iwpt = ipw * ihpt / iph
                }
                var mi2: i64 = len(media_exts)
                sb_append(sb, dx.pic_para(99 + mi2, iwpt * 12700, ihpt * 12700, mi2 + 1))
                if str_len(icap) > 0 {
                    sb_append(sb, dx.pic_caption(icap))
                }
                table_push(media_exts, imgmeta.ext(ik))
                table_push(media_datas, ox.bytes_to_str(byte_read(ipath)))
            }
            i = i + 4
        } else if k == "cover" {
            var cr = table_new_string()
            table_push(cr, dx.run_font(t[i + 1], "", 48, true))
            sb_append(sb, dx.para_center(cr))
            var sr = table_new_string()
            table_push(sr, dx.run_color(t[i + 2], "606060"))
            sb_append(sb, dx.para_center(sr))
            sb_append(sb, dx.page_break())
            i = i + 3
        } else if k == "toc" {
            sb_append(sb, dx.toc(1, to_i(t[i + 1]), ""))
            i = i + 2
        } else {
            i = i + 1
        }
    }
    var hdr_xml: string = ""
    if str_len(hdr) > 0 {
        hdr_xml = dx.header_para(hf_runs(hdr))
    }
    var ftr_xml: string = ""
    if ftr_set == 0 {
        // 既有无头尾文档：保持居中页码页脚（向后兼容）。
        ftr_xml = dx.footer_para([dx.page_field()])
    } else if str_len(ftr) > 0 {
        ftr_xml = dx.footer_para(hf_runs(ftr))
    }
    var notes_xml: string = ""
    if len(notes) > 0 {
        notes_xml = dx.footnotes_xml(notes)
    }
    return ox.write_docx_hbfn_media(path, sb_build(sb), hdr_xml, ftr_xml, notes_xml, media_exts, media_datas)
}

func dx_run_tbl(s2: string) -> table<string> {
    var rr = table_new_string()
    table_push(rr, dx.run(s2))
    return rr
}

// ---------------------------------------------------------------- xlsx

func row_begin(sb: i64, r: i64) -> void {
    sb_append(sb, "<row r=\"")
    sb_append(sb, to_string(r))
    sb_append(sb, "\">")
}

func put_row(sb: i64, r: i64, txt: string, bold: bool) -> void {
    row_begin(sb, r)
    sb_append(sb, xs.text_cell(1, r, txt, bold))
    sb_append(sb, "</row>")
}

// 渲染 xlsx：标题行 + 每块按行展开；表格保留列结构（表头加粗）。
pub func xlsx(path: string, t: table<string>) -> bool {
    var verr: string = doc.validate(t)
    if str_len(verr) > 0 {
        return false
    }
    var sb = string_builder()
    var hdr: string = ""
    var ftr: string = ""
    var fn_no: i64 = 0
    var notes = table_new_string()
    sb_append(sb, "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>")
    sb_append(sb, "<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" ")
    sb_append(sb, "xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">")
    sb_append(sb, "<sheetViews><sheetView workbookViewId=\"0\"/></sheetViews>")
    sb_append(sb, "<sheetData>")
    var r: i64 = 1
    put_row(sb, r, t[1], true)
    r = r + 1
    var n: i64 = len(t)
    var i: i64 = 2
    while i < n {
        var k: string = t[i]
        if is_heading(k) {
            put_row(sb, r, t[i + 1], true)
            r = r + 1
            i = i + 2
        } else if k == "ul" || k == "ol" {
            var cnt: i64 = to_i(t[i + 1])
            var j: i64 = 0
            while j < cnt {
                put_row(sb, r, t[i + 2 + j], false)
                r = r + 1
                j = j + 1
            }
            i = i + 2 + cnt
        } else if k == "tbl" {
            var cols: i64 = to_i(t[i + 1])
            var rows: i64 = to_i(t[i + 2])
            var rr: i64 = 0
            while rr <= rows {
                row_begin(sb, r)
                var c: i64 = 0
                while c < cols {
                    var cell_txt: string = t[i + 3 + rr * cols + c]
                    sb_append(sb, xs.text_cell(c + 1, r, cell_txt, rr == 0))
                    c = c + 1
                }
                sb_append(sb, "</row>")
                r = r + 1
                rr = rr + 1
            }
            i = i + 3 + cols * (rows + 1)
        } else if k == "tblw" {
            var cols: i64 = to_i(t[i + 1])
            var rows: i64 = to_i(t[i + 2])
            var rr: i64 = 0
            while rr <= rows {
                row_begin(sb, r)
                var c: i64 = 0
                while c < cols {
                    var cell_txt: string = t[i + 3 + cols + rr * cols + c]
                    sb_append(sb, xs.text_cell(c + 1, r, cell_txt, rr == 0))
                    c = c + 1
                }
                sb_append(sb, "</row>")
                r = r + 1
                rr = rr + 1
            }
            i = i + 3 + cols + cols * (rows + 1)
        } else if k == "code" {
            var src: string = t[i + 2]
            var p: i64 = 0
            var nn: i64 = str_len(src)
            var start: i64 = 0
            while p <= nn {
                if p == nn || str_byte(src, p) == 10 {
                    put_row(sb, r, str_sub_bytes(src, start, p - start), false)
                    r = r + 1
                    start = p + 1
                }
                p = p + 1
            }
            i = i + 3
        } else if k == "link" {
            put_row(sb, r, t[i + 1] + "  " + t[i + 2], false)
            r = r + 1
            i = i + 3
        } else if k == "img" {
            // xlsx 降级：真实图片需 drawing1.xml + media + rels；此处写占位行 + 图注。
            put_row(sb, r, "[图片: " + imgmeta.base_name(t[i + 1]) + "]", false)
            r = r + 1
            if str_len(t[i + 3]) > 0 {
                put_row(sb, r, t[i + 3], false)
                r = r + 1
            }
            i = i + 4
        } else if k == "quote" {
            put_row(sb, r, "> " + t[i + 1], false)
            r = r + 1
            i = i + 2
        } else if k == "hr" {
            put_row(sb, r, "———", false)
            r = r + 1
            i = i + 1
        } else if k == "cap" {
            put_row(sb, r, "表：" + t[i + 1], false)
            r = r + 1
            i = i + 2
        } else if k == "right" || k == "just" {
            put_row(sb, r, t[i + 1], false)
            r = r + 1
            i = i + 2
        } else if k == "para" {
            var xtxt: string = ""
            i = i + 1
            while i < len(t) && !doc.is_block_kind(t[i]) {
                if doc.is_fn_token(t[i]) {
                    fn_no = fn_no + 1
                    table_push(notes, fn_body(t[i]))
                    xtxt = xtxt + "[" + to_string(fn_no) + "]"
                } else {
                    xtxt = xtxt + run_text(t[i])
                }
                i = i + 1
            }
            put_row(sb, r, xtxt, false)
            r = r + 1
        } else if k == "header" {
            hdr = t[i + 1]
            i = i + 2
        } else if k == "footer" {
            ftr = t[i + 1]
            i = i + 2
        } else if k == "note_ref" {
            fn_no = fn_no + 1
            table_push(notes, t[i + 1])
            i = i + 2
        } else if k == "page" || k == "sec" || k == "cover" || k == "toc" {
            // RCA：cover 是「kind + 标题 + 副标题」三 token，早期误当两 token 处理，
            // 导致其后所有块错位（xlsx/pptx 曾把后续 token 当正文行输出）。
            if k == "cover" {
                i = i + 3
            } else if k == "toc" || k == "sec" {
                i = i + 2
            } else {
                i = i + 1
            }
        } else {
            put_row(sb, r, t[i + 1], k == "b")
            r = r + 1
            i = i + 2
        }
    }
    // 脚注降级：文末「注释」行（单元格），正文锚点处已带 [n]。
    if len(notes) > 0 {
        put_row(sb, r, "注释", true)
        r = r + 1
        var ni: i64 = 0
        while ni < len(notes) {
            put_row(sb, r, "[" + to_string(ni + 1) + "] " + notes[ni], false)
            r = r + 1
            ni = ni + 1
        }
    }
    sb_append(sb, "</sheetData>")
    sb_append(sb, xs.header_footer(hdr, ftr))
    sb_append(sb, "</worksheet>")
    var docs = table_new_string()
    table_push(docs, sb_build(sb))
    var names = table_new_string()
    table_push(names, "Sheet1")
    return xs.write_xlsx(path, docs, names)
}

// ---------------------------------------------------------------- pptx

// 渲染 pptx：标题页 + 每级标题起一页，段落/列表/表格/代码转为项目符号。
pub func pptx(path: string, t: table<string>) -> bool {
    var verr: string = doc.validate(t)
    if str_len(verr) > 0 {
        return false
    }
    var slides = table_new_string()
    var bullets = table_new_string()
    var notes = table_new_string()
    var pic_exts = table_new_string()
    var pic_datas = table_new_string()
    var pic_cx = table_new_i64()
    var pic_cy = table_new_i64()
    var fn_no: i64 = 0
    var cur: string = t[1]
    var pushed: bool = false
    var n: i64 = len(t)
    var i: i64 = 2
    while i < n {
        var k: string = t[i]
        if is_heading(k) {
            if len(bullets) > 0 || !pushed {
                table_push(slides, px.slide_title_bullets(cur, bullets))
                pushed = true
            }
            bullets = table_new_string()
            cur = t[i + 1]
            i = i + 2
        } else if k == "ul" || k == "ol" {
            var cnt: i64 = to_i(t[i + 1])
            var j: i64 = 0
            while j < cnt {
                table_push(bullets, t[i + 2 + j])
                j = j + 1
            }
            i = i + 2 + cnt
        } else if k == "tbl" {
            var cols: i64 = to_i(t[i + 1])
            var rows: i64 = to_i(t[i + 2])
            var rr: i64 = 0
            while rr <= rows {
                var line: string = ""
                var c: i64 = 0
                while c < cols {
                    if c > 0 {
                        line = line + " | "
                    }
                    line = line + t[i + 3 + rr * cols + c]
                    c = c + 1
                }
                table_push(bullets, line)
                rr = rr + 1
            }
            i = i + 3 + cols * (rows + 1)
        } else if k == "tblw" {
            var cols: i64 = to_i(t[i + 1])
            var rows: i64 = to_i(t[i + 2])
            var rr: i64 = 0
            while rr <= rows {
                var line: string = ""
                var c: i64 = 0
                while c < cols {
                    if c > 0 {
                        line = line + " | "
                    }
                    line = line + t[i + 3 + cols + rr * cols + c]
                    c = c + 1
                }
                table_push(bullets, line)
                rr = rr + 1
            }
            i = i + 3 + cols + cols * (rows + 1)
        } else if k == "code" {
            var src: string = t[i + 2]
            var p: i64 = 0
            var nn: i64 = str_len(src)
            var start: i64 = 0
            while p <= nn {
                if p == nn || str_byte(src, p) == 10 {
                    table_push(bullets, str_sub_bytes(src, start, p - start))
                    start = p + 1
                }
                p = p + 1
            }
            i = i + 3
        } else if k == "link" {
            table_push(bullets, t[i + 1] + "  " + t[i + 2])
            i = i + 3
        } else if k == "quote" {
            table_push(bullets, "「" + t[i + 1] + "」")
            i = i + 2
        } else if k == "hr" {
            i = i + 1
        } else if k == "cap" {
            table_push(bullets, "表：" + t[i + 1])
            i = i + 2
        } else if k == "right" || k == "just" {
            table_push(bullets, t[i + 1])
            i = i + 2
        } else if k == "para" {
            var qtxt: string = ""
            i = i + 1
            while i < len(t) && !doc.is_block_kind(t[i]) {
                if doc.is_fn_token(t[i]) {
                    fn_no = fn_no + 1
                    table_push(notes, fn_body(t[i]))
                    qtxt = qtxt + "[" + to_string(fn_no) + "]"
                } else {
                    qtxt = qtxt + run_text(t[i])
                }
                i = i + 1
            }
            table_push(bullets, qtxt)
        } else if k == "img" {
            // pptx：真嵌入 ppt/media/imageN.<ext> + slide rels + p:pic；
            // 图片统一追加到**最后一张**幻灯片（README 已写明此限制）。
            var ipath2: string = t[i + 1]
            var ik2 = imgmeta.kind(ipath2)
            var (ipw2, iph2) = imgmeta.dims(ipath2)
            if ik2 >= 1 && ipw2 > 0 && iph2 > 0 {
                var wpt2: i64 = to_i(t[i + 2])
                if wpt2 <= 0 {
                    wpt2 = ipw2
                }
                if wpt2 > 400 {
                    wpt2 = 400
                }
                var hpt2: i64 = iph2 * wpt2 / ipw2
                if hpt2 > 400 {
                    hpt2 = 400
                    wpt2 = ipw2 * hpt2 / iph2
                }
                table_push(pic_exts, imgmeta.ext(ik2))
                table_push(pic_datas, ox.bytes_to_str(byte_read(ipath2)))
                table_push(pic_cx, wpt2 * 12700)
                table_push(pic_cy, hpt2 * 12700)
            }
            i = i + 4
        } else if k == "header" || k == "footer" {
            // pptx 无页眉/页脚部件：降级忽略（README 已注明）。
            i = i + 2
        } else if k == "note_ref" {
            fn_no = fn_no + 1
            table_push(notes, t[i + 1])
            i = i + 2
        } else if k == "page" || k == "sec" || k == "cover" || k == "toc" {
            // RCA：cover 是「kind + 标题 + 副标题」三 token，早期误当两 token 处理，
            // 导致其后所有块错位（xlsx/pptx 曾把后续 token 当正文行输出）。
            if k == "cover" {
                i = i + 3
            } else if k == "toc" || k == "sec" {
                i = i + 2
            } else {
                i = i + 1
            }
        } else {
            table_push(bullets, t[i + 1])
            i = i + 2
        }
    }
    if len(bullets) > 0 || !pushed {
        table_push(slides, px.slide_title_bullets(cur, bullets))
    }
    // 脚注降级：末尾「注释」幻灯片，按 [n] 列出。
    if len(notes) > 0 {
        var nb = table_new_string()
        var ni: i64 = 0
        while ni < len(notes) {
            table_push(nb, "[" + to_string(ni + 1) + "] " + notes[ni])
            ni = ni + 1
        }
        table_push(slides, px.slide_title_bullets("注释", nb))
    }
    // 图片追加到**最终末页**（注释页之后），与 pptx_parts_media 给末页写 rels 的顺序一致。
    var pj: i64 = 0
    while pj < len(pic_exts) {
        var last: i64 = len(slides) - 1
        if last >= 0 {
            slides[last] = px.slide_append_pic(slides[last], pj, pic_cx[pj], pic_cy[pj])
        }
        pj = pj + 1
    }
    return px.write_pptx_media(path, slides, pic_exts, pic_datas)
}

// ---------------------------------------------------------------- pdf
// PDF 后端只做「块流 → 排版层调用」的映射；分页、页眉页脚、表格换行、
// 代码块高亮、目录两遍收集全部由 doc/pdfdoc.tie 承担（同一份 896 行的
// 排版实现既服务语言规范，也服务 tdoc 文档，避免第二套分页逻辑漂移）。

// 块流里的 doc 标题是否已被 cover 块承载
var g_pdf_cover: i64 = 0;
// 当前页是否已写过正文（cover 前是否需要先翻页）
var g_pdf_wrote: i64 = 0;
// 脚注编号游标（每遍排版归零，保证两遍编号一致）
var g_fn_no: i64 = 0;

// 单块 → 下一次下标。collect=1 为目录收集干跑（此时 toc 块不落页）。
func pdf_one(t: table<string>, i: i64, collect: i64) -> i64 {
    var k: string = t[i]
    if k == "doc" {
        if g_pdf_cover == 0 {
            pdoc.h1(t[i + 1])
            g_pdf_wrote = 1
        }
        return i + 2
    }
    if k == "h1" {
        pdoc.h1(t[i + 1])
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "h2" {
        pdoc.h2(t[i + 1])
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "h3" || k == "h4" || k == "h5" || k == "h6" || k == "h7" || k == "h8" || k == "h9" {
        pdoc.h3(t[i + 1])
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "p" {
        pdoc.p(t[i + 1])
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "b" {
        pdoc.p_bold(t[i + 1])
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "center" {
        pdoc.center(t[i + 1])
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "note" {
        pdoc.note(t[i + 1])
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "quote" {
        pdoc.quote_block(t[i + 1])
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "hr" {
        pdoc.hr()
        g_pdf_wrote = 1
        return i + 1
    }
    if k == "cap" {
        pdoc.caption(t[i + 1])
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "img" {
        pdoc.img(t[i + 1], to_i(t[i + 2]), t[i + 3])
        g_pdf_wrote = 1
        return i + 4
    }
    if k == "right" || k == "just" {
        if k == "right" {
            pdoc.p_right(t[i + 1])
        } else {
            pdoc.p_just(t[i + 1])
        }
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "para" {
        var ptxt: string = ""
        var pj: i64 = i + 1
        while pj < len(t) && !doc.is_block_kind(t[pj]) {
            if doc.is_fn_token(t[pj]) {
                g_fn_no = g_fn_no + 1
                ptxt = ptxt + "[" + to_string(g_fn_no) + "]"
            } else {
                ptxt = ptxt + run_text(t[pj])
            }
            pj = pj + 1
        }
        pdoc.p(ptxt)
        g_pdf_wrote = 1
        return pj
    }
    if k == "ul" || k == "ol" {
        var n: i64 = to_i(t[i + 1])
        var items = table_new_string()
        var j: i64 = 0
        while j < n {
            var s2: string = t[i + 2 + j]
            if k == "ol" {
                s2 = to_string(j + 1) + ". " + s2
            }
            table_push(items, s2)
            j = j + 1
        }
        pdoc.bullet(items)
        g_pdf_wrote = 1
        return i + 2 + n
    }
    if k == "tblw" {
        var cols: i64 = to_i(t[i + 1])
        var rows_n: i64 = to_i(t[i + 2])
        var widths = table_new_i64()
        var wj: i64 = 0
        while wj < cols {
            table_push(widths, to_i(t[i + 3 + wj]))
            wj = wj + 1
        }
        var hdr = table_new_string()
        var c: i64 = 0
        while c < cols {
            table_push(hdr, t[i + 3 + cols + c])
            c = c + 1
        }
        var rows: table<table<string>> = []
        var r: i64 = 0
        while r < rows_n {
            var row = table_new_string()
            var cc: i64 = 0
            while cc < cols {
                table_push(row, t[i + 3 + cols + cols + r * cols + cc])
                cc = cc + 1
            }
            table_push(rows, row)
            r = r + 1
        }
        pdoc.tbl(hdr, rows, widths)
        g_pdf_wrote = 1
        return i + 3 + cols + cols * (rows_n + 1)
    }
    if k == "tbl" {
        var cols: i64 = to_i(t[i + 1])
        var rows_n: i64 = to_i(t[i + 2])
        var hdr = table_new_string()
        var c: i64 = 0
        while c < cols {
            table_push(hdr, t[i + 3 + c])
            c = c + 1
        }
        var rows: table<table<string>> = []
        var r: i64 = 0
        while r < rows_n {
            var row = table_new_string()
            var cc: i64 = 0
            while cc < cols {
                table_push(row, t[i + 3 + cols + r * cols + cc])
                cc = cc + 1
            }
            table_push(rows, row)
            r = r + 1
        }
        var widths = table_new_i64()
        var avail: i64 = pdoc.avail_width()
        var wcol: i64 = avail / cols
        var wi: i64 = 0
        while wi < cols {
            table_push(widths, wcol)
            wi = wi + 1
        }
        pdoc.tbl(hdr, rows, widths)
        g_pdf_wrote = 1
        return i + 3 + cols + cols * rows_n
    }
    if k == "code" {
        pdoc.codeblock(t[i + 2])
        g_pdf_wrote = 1
        return i + 3
    }
    if k == "link" {
        pdoc.p(t[i + 1] + "（" + t[i + 2] + "）")
        g_pdf_wrote = 1
        return i + 3
    }
    if k == "header" || k == "footer" {
        // header/footer 在 pdf() 预扫描后统一设置；此处仅推进下标。
        return i + 2
    }
    if k == "note_ref" {
        g_fn_no = g_fn_no + 1
        pdoc.p(t[i + 1] + " [" + to_string(g_fn_no) + "]")
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "page" {
        pdoc.pagebreak()
        g_pdf_wrote = 0
        return i + 1
    }
    if k == "sec" {
        pdoc.pagebreak()
        pdoc.h2(t[i + 1])
        g_pdf_wrote = 1
        return i + 2
    }
    if k == "cover" {
        if g_pdf_wrote == 1 {
            pdoc.pagebreak()
        }
        pdoc.cover(t[i + 1], t[i + 2], "")
        pdoc.pagebreak()
        g_pdf_wrote = 0
        return i + 3
    }
    if k == "toc" {
        if collect == 0 {
            pdoc.toc_page()
            pdoc.pagebreak()
            g_pdf_wrote = 0
        }
        return i + 2
    }
    // 未知块：校验层已拦下；此处防御性跳过
    return i + 1
}

func pdf_pass(t: table<string>, collect: i64) {
    var i: i64 = 0
    while i < len(t) {
        i = pdf_one(t, i, collect)
    }
}

// 渲染 PDF：块流 → pdfdoc（两遍排版：先收集目录页码，再正式出页）。
// 预扫描：按出现顺序收集脚注正文（para 内 fn| run 与 note_ref 块）。
func collect_notes(t: table<string>) -> table<string> {
    var out = table_new_string()
    var n: i64 = len(t)
    var i: i64 = 0
    while i < n {
        var k: string = t[i]
        if k == "note_ref" {
            table_push(out, t[i + 1])
            i = i + 2
        } else if k == "para" {
            i = i + 1
            while i < n && !doc.is_block_kind(t[i]) {
                if doc.is_fn_token(t[i]) {
                    table_push(out, fn_body(t[i]))
                }
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return out
}

pub func pdf(path: string, t: table<string>, body_font: string, mono_font: string) -> bool {
    if str_len(doc.validate(t)) > 0 {
        return false
    }
    g_pdf_cover = 0
    g_pdf_wrote = 0
    var ci: i64 = 0
    while ci < len(t) {
        if t[ci] == "cover" {
            g_pdf_cover = 1
        }
        ci = ci + 1
    }
    var hdr: string = ""
    var ftr: string = ""
    var si: i64 = 0
    while si + 1 < len(t) {
        if t[si] == "header" {
            hdr = t[si + 1]
        }
        if t[si] == "footer" {
            ftr = t[si + 1]
        }
        si = si + 1
    }
    pdoc.set_header(hdr)
    pdoc.set_footer(ftr)
    var notes = collect_notes(t)
    pdoc.init_fonts(body_font, mono_font)
    pdoc.toc_clear()
    // 收集遍：只推进分页并记录标题页码
    pdoc.reset_doc()
    pdoc.toc_on()
    pdoc.dry_on()
    g_fn_no = 0
    pdf_pass(t, 1)
    pdoc.dry_off()
    var tpages = pdoc.toc_pages()
    pdoc.toc_set_off(tpages)
    // 正式遍
    pdoc.reset_doc()
    pdoc.toc_off()
    g_pdf_wrote = 0
    g_fn_no = 0
    pdf_pass(t, 0)
    pdoc.notes_section(notes)
    return pdoc.end(path)
}
}