type tie<class>
// ============================================================================
// doc/load.tie —— td 文档 → tdoc 块流（tofflib 内部模块）
//
// 文档源（.tdoc，tie:data 语法）：
//   [
//       "title": "文档标题",
//       "blocks": [
//           ["h1", "第 1 章"],
//           ["p", "正文段落"],
//           ["ul", ["条目一", "条目二"]],
//           ["tbl", ["项", "值"], ["版本", "2026.2"], ["协议", "TPL-2.3"]],
//           ["code", "tie", "func main() {}"],
//           ["page"],
//       ],
//   ]
//
// 块形状（与 model.tie 协议一一对应）：
//   ["h1".."h9", text] / ["p"|"b"|"center"|"note", text]
//   ["ul"|"ol", [item...]] / ["code", lang, text] / ["link", text, url]
//   ["tbl", [表头...], [行...], ...] / ["page"] / ["sec", title]
//   ["cover", title, subtitle] / ["toc", depth]
//   ["quote", text] / ["hr"] / ["cap", text]
//   ["header", text] / ["footer", text] / ["note_ref", text]
//   ["img", path] / ["img", path, width_pt] / ["img", path, width_pt, caption]
//   ["para", run...]（run 可为普通文本或 b| i| m| link| fn| 前缀）
//
// 入口：load_td(root, out) / load_file(path, out)；返回错误消息（空串=成功），
// 错误带块下标（blocks[i]）与原因。
// ============================================================================
import "./td.tie" as td
import "./model.tie" as doc

namespace doc {

// 块参数 i（0 起）的字符串值（非字符串 → 空串）。
func arg_str(blk: i64, i: i64) -> string {
    if i < 0 || i >= td.arr_len(blk) {
        return ""
    }
    return td.str_val(td.arr_at(blk, i))
}

// 块参数 i（0 起）的节点 id（越界 → -1）。
func arg_node(blk: i64, i: i64) -> i64 {
    if i < 0 || i >= td.arr_len(blk) {
        return -1
    }
    return td.arr_at(blk, i)
}

// 块参数个数是否恰好为 n。
func arity_is(blk: i64, n: i64) -> bool {
    return td.arr_len(blk) == n
}

// 取字符串数组节点（如 ul 的条目、tbl 的表头）为 token 追加；
// 非数组或含非字符串元素 → 错误串。
func push_str_array(arr: i64, out: ref table<string>, what: string) -> string {
    if td.type_of(arr) != 5 {
        return what + " 必须是字符串数组"
    }
    var n: i64 = td.arr_len(arr)
    var i: i64 = 0
    while i < n {
        var e: i64 = td.arr_at(arr, i)
        if td.type_of(e) != 4 {
            return what + " 第 " + to_string(i) + " 项不是字符串"
        }
        table_push(out, td.str_val(e))
        i = i + 1
    }
    return ""
}

// 代码块：内容**逐字保留**，只去掉 here-doc 的边界换行。
// 约定：开引号后立即换行（该换行丢弃）；收尾引号独占一行时，其前的换行与行首
// 缩进一并丢弃。内容行不做任何缩进剥离——写什么就是什么，缩进即排版。
func trim_heredoc(t: string) -> string {
    var n = len(t)
    if n == 0 {
        return t
    }
    var st: i64 = 0
    if str_byte(t, 0) == 10 {
        st = 1
    }
    // 结尾：若从某个换行起到字符串末尾只有空格/制表，则截到该换行处
    var en = n
    var i = n - 1
    var nl: i64 = -1
    var ws = 1
    while i >= st {
        var b = str_byte(t, i)
        if b == 10 {
            nl = i
            break
        }
        if b != 32 && b != 9 {
            ws = 0
            break
        }
        i = i - 1
    }
    if ws == 1 && nl >= 0 {
        en = nl
    }
    if st == 0 && en == n {
        return t
    }
    var out = string_builder()
    var k = st
    while k < en {
        sb_append_byte(out, str_byte(t, k))
        k = k + 1
    }
    return sb_build(out)
}

// 追加一个块的 token；返回错误串（空=成功）。bi 仅用于报错定位。
func load_block(blk: i64, bi: i64, out: ref table<string>) -> string {
    var where: string = "blocks[" + to_string(bi) + "]: "
    if td.type_of(blk) != 5 {
        return where + "块必须是数组"
    }
    var n: i64 = td.arr_len(blk)
    if n < 1 {
        return where + "空块"
    }
    var k: i64 = td.arr_at(blk, 0)
    if td.type_of(k) != 4 {
        return where + "块类型必须是字符串"
    }
    var kind: string = td.str_val(k)
    // include：先写占位标记，整文件装载完成后统一展开（td 解析器有全局状态，
    // 不能在遍历父文件 AST 的同时再解析子文件）。
    if kind == "include" {
        if !arity_is(blk, 2) {
            return where + "include 需要 2 个元素（路径）"
        }
        if str_len(arg_str(blk, 1)) == 0 {
            return where + "include 路径不能为空"
        }
        table_push(out, "__include")
        table_push(out, arg_str(blk, 1))
        return ""
    }
    if str_len(kind) == 2 && str_byte(kind, 0) == 104 {
        var d: i64 = str_byte(kind, 1)
        if d >= 49 && d <= 57 {
            if !arity_is(blk, 2) {
                return where + kind + " 需要 2 个元素"
            }
            table_push(out, kind)
            table_push(out, arg_str(blk, 1))
            return ""
        }
    }
    if kind == "p" || kind == "b" || kind == "center" || kind == "note" {
        if !arity_is(blk, 2) {
            return where + kind + " 需要 2 个元素"
        }
        table_push(out, kind)
        table_push(out, arg_str(blk, 1))
        return ""
    }
    if kind == "right" || kind == "just" {
        if !arity_is(blk, 2) {
            return where + kind + " 需要 2 个元素"
        }
        table_push(out, kind)
        table_push(out, arg_str(blk, 1))
        return ""
    }
    if kind == "header" || kind == "footer" || kind == "note_ref" {
        if !arity_is(blk, 2) {
            return where + kind + " 需要 2 个元素"
        }
        table_push(out, kind)
        table_push(out, arg_str(blk, 1))
        return ""
    }
    if kind == "img" {
        var cnt: i64 = td.arr_len(blk)
        if cnt < 2 || cnt > 4 {
            return where + "img 需要 2~4 个元素（path[, width_pt[, caption]]）"
        }
        if td.type_of(arg_node(blk, 1)) != 4 {
            return where + "img 路径必须是字符串"
        }
        var path: string = arg_str(blk, 1)
        if str_len(path) == 0 {
            return where + "img 路径不能为空"
        }
        var wpt: i64 = 0
        var cap: string = ""
        if cnt >= 3 {
            if td.type_of(arg_node(blk, 2)) != 2 {
                return where + "img 宽度必须是整数（pt，0 = 按像素自动）"
            }
            wpt = td.int_val(arg_node(blk, 2))
        }
        if cnt == 4 {
            if td.type_of(arg_node(blk, 3)) != 4 {
                return where + "img caption 必须是字符串"
            }
            cap = arg_str(blk, 3)
        }
        table_push(out, "img")
        table_push(out, path)
        table_push(out, to_string(wpt))
        table_push(out, cap)
        return ""
    }
    if kind == "para" {
        var rn: i64 = td.arr_len(blk)
        if rn < 2 {
            return where + "para 至少需要一个 run"
        }
        table_push(out, "para")
        var ri: i64 = 1
        while ri < rn {
            table_push(out, arg_str(blk, ri))
            ri = ri + 1
        }
        return ""
    }
    if kind == "quote" || kind == "cap" {
        if !arity_is(blk, 2) {
            return where + kind + " 需要 2 个元素"
        }
        table_push(out, kind)
        table_push(out, arg_str(blk, 1))
        return ""
    }
    if kind == "hr" {
        if !arity_is(blk, 1) {
            return where + "hr 不需要参数"
        }
        table_push(out, "hr")
        return ""
    }
    if kind == "ul" || kind == "ol" {
        if !arity_is(blk, 2) {
            return where + kind + " 需要 2 个元素（条目数组）"
        }
        var items: i64 = arg_node(blk, 1)
        var cnt: i64 = td.arr_len(items)
        table_push(out, kind)
        table_push(out, to_string(cnt))
        return push_str_array(items, out, where + kind)
    }
    if kind == "tbl" {
        if n < 2 {
            return where + "tbl 需要表头数组与至少一行"
        }
        var header: i64 = arg_node(blk, 1)
        if td.type_of(header) != 5 {
            return where + "tbl 表头必须是数组"
        }
        var cols: i64 = td.arr_len(header)
        if cols < 1 {
            return where + "tbl 表头不能为空"
        }
        var nrows: i64 = n - 2
        table_push(out, "tbl")
        table_push(out, to_string(cols))
        table_push(out, to_string(nrows))
        var eh: string = push_str_array(header, out, where + "tbl 表头")
        if str_len(eh) > 0 {
            return eh
        }
        var r: i64 = 2
        while r < n {
            var row: i64 = arg_node(blk, r)
            if td.type_of(row) != 5 {
                return where + "tbl 第 " + to_string(r - 1) + " 行必须是数组"
            }
            if td.arr_len(row) != cols {
                return where + "tbl 第 " + to_string(r - 1) + " 行有 " + to_string(td.arr_len(row)) + " 列（表头 " + to_string(cols) + "）"
            }
            var er: string = push_str_array(row, out, where + "tbl 行")
            if str_len(er) > 0 {
                return er
            }
            r = r + 1
        }
        return ""
    }
    if kind == "tblw" {
        if n < 3 {
            return where + "tblw 需要表头、至少一行与列宽数组"
        }
        var header: i64 = arg_node(blk, 1)
        if td.type_of(header) != 5 {
            return where + "tblw 表头必须是数组"
        }
        var cols: i64 = td.arr_len(header)
        if cols < 1 {
            return where + "tblw 表头不能为空"
        }
        var wn: i64 = arg_node(blk, n - 1)
        if td.type_of(wn) != 5 {
            return where + "tblw 最后一个元素必须是列宽数组"
        }
        if td.arr_len(wn) != cols {
            return where + "tblw 列宽有 " + to_string(td.arr_len(wn)) + " 个（表头 " + to_string(cols) + " 列）"
        }
        table_push(out, "tblw")
        table_push(out, to_string(cols))
        table_push(out, to_string(n - 3))
        var wc: i64 = 0
        while wc < cols {
            var wnode: i64 = td.arr_at(wn, wc)
            if td.type_of(wnode) != 2 {
                return where + "tblw 列宽必须是整数"
            }
            table_push(out, to_string(td.int_val(wnode)))
            wc = wc + 1
        }
        var eh: string = push_str_array(header, out, where + "tblw 表头")
        if str_len(eh) > 0 {
            return eh
        }
        var r: i64 = 2
        while r < n - 1 {
            var row: i64 = arg_node(blk, r)
            if td.type_of(row) != 5 {
                return where + "tblw 第 " + to_string(r - 1) + " 行必须是数组"
            }
            if td.arr_len(row) != cols {
                return where + "tblw 第 " + to_string(r - 1) + " 行有 " + to_string(td.arr_len(row)) + " 列（表头 " + to_string(cols) + "）"
            }
            var er: string = push_str_array(row, out, where + "tblw 行")
            if str_len(er) > 0 {
                return er
            }
            r = r + 1
        }
        return ""
    }
    if kind == "code" {
        if !arity_is(blk, 3) {
            return where + "code 需要 3 个元素（语言、文本）"
        }
        table_push(out, "code")
        table_push(out, arg_str(blk, 1))
        table_push(out, trim_heredoc(arg_str(blk, 2)))
        return ""
    }
    if kind == "link" {
        if !arity_is(blk, 3) {
            return where + "link 需要 3 个元素（文本、地址）"
        }
        table_push(out, "link")
        table_push(out, arg_str(blk, 1))
        table_push(out, arg_str(blk, 2))
        return ""
    }
    if kind == "page" {
        if !arity_is(blk, 1) {
            return where + "page 不带参数"
        }
        table_push(out, "page")
        return ""
    }
    if kind == "sec" {
        if !arity_is(blk, 2) {
            return where + "sec 需要 2 个元素"
        }
        table_push(out, "sec")
        table_push(out, arg_str(blk, 1))
        return ""
    }
    if kind == "cover" {
        if !arity_is(blk, 3) {
            return where + "cover 需要 3 个元素（标题、副标题）"
        }
        table_push(out, "cover")
        table_push(out, arg_str(blk, 1))
        table_push(out, arg_str(blk, 2))
        return ""
    }
    if kind == "toc" {
        if !arity_is(blk, 2) {
            return where + "toc 需要深度"
        }
        var dn: i64 = arg_node(blk, 1)
        if td.type_of(dn) != 2 {
            return where + "toc 深度必须是整数"
        }
        table_push(out, "toc")
        table_push(out, to_string(td.int_val(dn)))
        return ""
    }
    return where + "未知块类型 " + kind
}

// td 根节点 → 块流；返回错误串（空=成功）。out 须由调用方 table_new_string() 创建。
func load_td(root: i64, out: ref table<string>, base: string, seen: ref table<string>, depth: i64) -> string {
    if td.type_of(root) != 6 {
        return "文档根节点必须是表（[ ... ]）"
    }
    var title: string = td.get_str(root, "title")
    table_push(out, "doc")
    table_push(out, title)
    var blocks: i64 = td.map_get(root, "blocks")
    if blocks < 0 {
        return "缺少 blocks 数组"
    }
    if td.type_of(blocks) != 5 {
        return "blocks 必须是数组"
    }
    var n: i64 = td.arr_len(blocks)
    var i: i64 = 0
    while i < n {
        var err: string = load_block(td.arr_at(blocks, i), i, out)
        if str_len(err) > 0 {
            return err
        }
        i = i + 1
    }
    var ierr: string = expand_includes(out, base, seen, depth)
    if str_len(ierr) > 0 {
        return "include 展开失败: " + ierr
    }
    var verr: string = doc.validate(out)
    if str_len(verr) > 0 {
        return "块流校验失败: " + verr
    }
    return ""
}

// 读 .tdoc 文件并转为块流；返回错误串（空=成功）。
pub func load_file(path: string, out: ref table<string>) -> string {
    var root: i64 = td.parse_data(path)
    if root < 0 {
        return "td 解析失败: " + td.err_msg()
    }
    var seen: table<string> = table_new_string()
    table_push(seen, path)
    return load_td(root, out, dir_of(path), seen, 0)
}

// ---------- include 支持 ----------

// 目录部分（不含末尾分隔符）。
func dir_of(p: string) -> string {
    var i: i64 = len(p) - 1
    while i >= 0 {
        var b = str_byte(p, i)
        if b == 47 || b == 92 {
            return sub_str(p, 0, i)
        }
        i = i - 1
    }
    return ""
}

// 拼接路径：a 为空返回 b；a 末尾已有分隔符则直接接。
func join_path(a: string, b: string) -> string {
    if str_len(a) == 0 {
        return b
    }
    var last = str_byte(a, len(a) - 1)
    if last == 47 || last == 92 {
        return a + b
    }
    return a + "/" + b
}

// 绝对路径：盘符（C:）或以分隔符开头。
func is_abs_path(p: string) -> bool {
    var n = len(p)
    if n >= 2 && str_byte(p, 1) == 58 {
        return true
    }
    if n >= 1 && (str_byte(p, 0) == 47 || str_byte(p, 0) == 92) {
        return true
    }
    return false
}

// 字节切片 [a, b)。
func sub_str(s: string, a: i64, b: i64) -> string {
    var sb = string_builder()
    var i = a
    while i < b && i < len(s) {
        sb_append_byte(sb, str_byte(s, i))
        i = i + 1
    }
    return sb_build(sb)
}

// 展开一个 include：目标可以是 blocks 数组，或含 blocks 的文档表。
// 子文件先完整装载成 token（含嵌套占位），再递归展开，避免嵌套解析。
func load_include(p: string, out: ref table<string>, seen: ref table<string>, depth: i64) -> string {
    if depth >= 16 {
        return "include 嵌套过深（上限 16 层）：" + p
    }
    var i: i64 = 0
    while i < len(seen) {
        if seen[i] == p {
            return "include 成环：" + p
        }
        i = i + 1
    }
    table_push(seen, p)
    var root: i64 = td.parse_data(p)
    if root < 0 {
        return "include 解析失败（" + p + "）：" + td.err_msg()
    }
    var blocks: i64 = -1
    if td.type_of(root) == 6 {
        blocks = td.map_get(root, "blocks")
    } else if td.type_of(root) == 5 {
        blocks = root
    }
    if blocks < 0 || td.type_of(blocks) != 5 {
        return "include 目标必须是 blocks 数组，或含 blocks 的文档表：" + p
    }
    var tmp: table<string> = table_new_string()
    var n = td.arr_len(blocks)
    var j: i64 = 0
    while j < n {
        var err = load_block(td.arr_at(blocks, j), j, tmp)
        if str_len(err) > 0 {
            return p + ": " + err
        }
        j = j + 1
    }
    var e2 = expand_includes(tmp, dir_of(p), seen, depth + 1)
    if str_len(e2) > 0 {
        return p + ": " + e2
    }
    var k: i64 = 0
    while k < len(tmp) {
        table_push(out, tmp[k])
        k = k + 1
    }
    return ""
}

// 把 token 流里的 "__include"+路径 就地替换为子文件展开后的 token。
func expand_includes(items: ref table<string>, base: string, seen: ref table<string>, depth: i64) -> string {
    var out2: table<string> = table_new_string()
    var i: i64 = 0
    while i < len(items) {
        if items[i] == "__include" {
            if i + 1 >= len(items) {
                return "include 缺少路径"
            }
            var p = items[i + 1]
            if !is_abs_path(p) {
                p = join_path(base, p)
            }
            var err = load_include(p, out2, seen, depth)
            if str_len(err) > 0 {
                return err
            }
            i = i + 2
        } else {
            table_push(out2, items[i])
            i = i + 1
        }
    }
    table_trunc(items, 0)
    var j: i64 = 0
    while j < len(out2) {
        table_push(items, out2[j])
        j = j + 1
    }
    return ""
}

// td 解析入口（文档源为 td 数据；实现见 td.tie，对外只经 doc 命名空间）。
func parse(s: string) -> i64 {
    return td.parse(s)
}

// td 解析错误消息。
func err_msg() -> string {
    return td.err_msg()
}
}
