type tie<class>
// ============================================================================
// img/imgmeta.tie —— 图片元信息（tofflib 内部模块，纯 tie）
//
// 只做三件事：按文件头识别格式、读像素尺寸、给 OOXML 部件用的扩展名/内容类型。
// 不依赖文件扩展名（.jpg 里放 PNG 也能识别），不做解码、不做缩放——像素交给
// 各后端（docx 的 a:blip、pdf 的 DCTDecode XObject、pptx 的 p:pic）。
//
// 格式码：0 未知 / 1 JPEG / 2 PNG / 3 GIF / 4 BMP。未知格式由各后端退化为
// 占位文字（真实能力见 README 保真度表）。
//
// JPEG：顺序段扫描（FF marker + 大端长度），遇 SOF0..SOF15（去掉 DHT=C4、
//       JPG=C8、DAC=CC）取高=b[i+5..6]、宽=b[i+7..8]；遇 SOS(DA)/EOI(D9) 停。
// PNG ：8 字节签名后 IHDR：宽 = 16..19，高 = 20..23（大端）。
// GIF ：逻辑屏宽 = 6..7，高 = 8..9（小端）。
// BMP ：宽 = 18..21，高 = 22..25（小端，高可为负 = 自上而下，取绝对值）。
//
// 为什么自己解析而不用现成库：tofflib 零外部依赖，且后端只需像素宽高，
// 两段几十行的字节解析比引入解码器代价小得多。

namespace imgmeta {

func byte_at(b: table<i64>, i: i64) -> i64 {
    if i < 0 || i >= len(b) {
        return 0
    }
    return b[i]
}

func u32be(b: table<i64>, i: i64) -> i64 {
    return byte_at(b, i) * 16777216 + byte_at(b, i + 1) * 65536 + byte_at(b, i + 2) * 256 + byte_at(b, i + 3)
}

func i32le(b: table<i64>, i: i64) -> i64 {
    var v = byte_at(b, i) + byte_at(b, i + 1) * 256 + byte_at(b, i + 2) * 65536 + byte_at(b, i + 3) * 16777216
    if v > 2147483647 {
        v = v - 4294967296
    }
    return v
}

func u16le(b: table<i64>, i: i64) -> i64 {
    return byte_at(b, i) + byte_at(b, i + 1) * 256
}

// 文件头识别：1=JPEG 2=PNG 3=GIF 4=BMP 0=未知。
pub func kind_bytes(b: table<i64>) -> i64 {
    var n = len(b)
    if n >= 3 && byte_at(b, 0) == 255 && byte_at(b, 1) == 216 && byte_at(b, 2) == 255 {
        return 1
    }
    if n >= 8 && byte_at(b, 0) == 137 && byte_at(b, 1) == 80 && byte_at(b, 2) == 78 && byte_at(b, 3) == 71 &&
       byte_at(b, 4) == 13 && byte_at(b, 5) == 10 && byte_at(b, 6) == 26 && byte_at(b, 7) == 10 {
        return 2
    }
    if n >= 6 && byte_at(b, 0) == 71 && byte_at(b, 1) == 73 && byte_at(b, 2) == 70 && byte_at(b, 3) == 56 {
        return 3
    }
    if n >= 26 && byte_at(b, 0) == 66 && byte_at(b, 1) == 77 {
        return 4
    }
    return 0
}

func jpeg_dims(b: table<i64>) -> (w: i64, h: i64) {
    var n = len(b)
    var i = 2
    while i + 3 < n {
        if byte_at(b, i) != 255 {
            i = i + 1
            continue
        }
        var m = byte_at(b, i + 1)
        if m == 255 {
            i = i + 1
            continue
        }
        if m == 216 || m == 1 || (m >= 208 && m <= 215) {
            i = i + 2
            continue
        }
        if m == 218 || m == 217 {
            return (0, 0)
        }
        if i + 4 >= n {
            return (0, 0)
        }
        var seglen = byte_at(b, i + 2) * 256 + byte_at(b, i + 3)
        if seglen < 2 {
            return (0, 0)
        }
        if m >= 192 && m <= 207 && m != 196 && m != 200 && m != 204 {
            if i + 8 >= n {
                return (0, 0)
            }
            var hgt = byte_at(b, i + 5) * 256 + byte_at(b, i + 6)
            var wid = byte_at(b, i + 7) * 256 + byte_at(b, i + 8)
            return (wid, hgt)
        }
        i = i + 2 + seglen
    }
    return (0, 0)
}

func png_dims(b: table<i64>) -> (w: i64, h: i64) {
    if len(b) < 24 {
        return (0, 0)
    }
    return (u32be(b, 16), u32be(b, 20))
}

func gif_dims(b: table<i64>) -> (w: i64, h: i64) {
    if len(b) < 10 {
        return (0, 0)
    }
    return (u16le(b, 6), u16le(b, 8))
}

func bmp_dims(b: table<i64>) -> (w: i64, h: i64) {
    if len(b) < 26 {
        return (0, 0)
    }
    var w = i32le(b, 18)
    var h = i32le(b, 22)
    if w < 0 {
        w = -w
    }
    if h < 0 {
        h = -h
    }
    return (w, h)
}

// 像素宽高（按文件头自动分派；未知格式返回 0,0）。
pub func dims_bytes(b: table<i64>) -> (w: i64, h: i64) {
    var k = kind_bytes(b)
    if k == 1 {
        return jpeg_dims(b)
    }
    if k == 2 {
        return png_dims(b)
    }
    if k == 3 {
        return gif_dims(b)
    }
    if k == 4 {
        return bmp_dims(b)
    }
    return (0, 0)
}

pub func kind(path: string) -> i64 {
    if !file_exists(path) {
        return 0
    }
    return kind_bytes(byte_read(path))
}

pub func dims(path: string) -> (w: i64, h: i64) {
    if !file_exists(path) {
        return (0, 0)
    }
    return dims_bytes(byte_read(path))
}

// OOXML 部件扩展名（[Content_Types].xml Default Extension 与 word/media/image1.<ext>）。
pub func ext(k: i64) -> string {
    if k == 1 {
        return "jpeg"
    }
    if k == 2 {
        return "png"
    }
    if k == 3 {
        return "gif"
    }
    if k == 4 {
        return "bmp"
    }
    return ""
}

pub func content_type(k: i64) -> string {
    if k == 1 {
        return "image/jpeg"
    }
    if k == 2 {
        return "image/png"
    }
    if k == 3 {
        return "image/gif"
    }
    if k == 4 {
        return "image/bmp"
    }
    return ""
}

// 文件名（最后一个 '/' 或 '\\' 之后），用于占位文字与部件命名。
pub func base_name(path: string) -> string {
    var n = len(path)
    var start = 0
    var i = 0
    while i < n {
        var c = str_byte(path, i)
        if c == 47 || c == 92 {
            start = i + 1
        }
        i = i + 1
    }
    if start <= 0 {
        return path
    }
    return str_sub_bytes(path, start, n)
}

}
