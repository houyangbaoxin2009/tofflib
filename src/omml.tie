type tie<class>
// ============================================================================
// omml.tie：tofflib——用 tie 办公的工具库 / Word 公式 OMML 生成
//
// 本模块生成 OfficeMath (OMML) 结构 XML 片段，供嵌入 word/document.xml 的
// <w:p> 段落中显示公式。命名空间：
//   m: http://schemas.openxmlformats.org/officeDocument/2006/math
//   w: 同上（w:r 用于公式内文本 run，实际 OMML 支持 m:r）——本模块统一 m:r。
//
// 提供基础数学结构生成器（所有结构接受"已组装的子片段字符串"，可无限嵌套）：
//   - 文本/标识 run：r()；行内公式：inline()；整段公式：omath_para()
//   - 下标/上标：ssub() / ssup()；分数：frac()
//   - 定界符：delimit()（括号包裹）；求和/积分等：nary()
//   - 文本净化：escape()（& < >）——OMML 沿用通用 XML 转义。
//
// 纯函数、零 unsafe、无外部依赖，只依赖底座原语 + StringBuilder。
// 调用方式（class 库，编译为 omml.a）：
//   import "./omml.tie" as mm
//   var e = mm.frac(mm.r("a") + mm.r("b"), mm.r("c"))
//   var s = mm.delimit(mm.ssup(mm.r("x"), mm.r("2")), "(", ")")
//
// 错误约定：escape 对非法/超界字符安静跳过。
// ============================================================================

namespace omml {

// XML 安全转义（& < >）——OMML 内容文本沿用通用 XML 规则。
pub func escape(txt: string) -> string {
    var sb = string_builder()
    var n: i64 = str_len(txt)
    var i: i64 = 0
    while i < n {
        var c = str_char(txt, i)
        if c == "&" {
            sb_append(sb, "&amp;")
        } else if c == "<" {
            sb_append(sb, "&lt;")
        } else if c == ">" {
            sb_append(sb, "&gt;")
        } else {
            sb_append(sb, c)
        }
        i = i + 1
    }
    return sb_build(sb)
}

// 数学文本 run：<m:r><m:t>text</m:t></m:r>（文本经 escape）。
pub func r(txt: string) -> string {
    return "<m:r><m:t>" + escape(txt) + "</m:t></m:r>"
}

// 在数学上下文中插入普通片段（不转义，供已组装的子结构拼接）；等价 ID。
pub func raw(frag: string) -> string {
    return frag
}

// 行内公式：<m:oMath>parts</m:oMath>（将一组 run/结构片段包成一个公式）。
pub func inline(parts: table<string>) -> string {
    var sb = string_builder()
    sb_append(sb, "<m:oMath>")
    append_all(sb, parts)
    sb_append(sb, "</m:oMath>")
    return sb_build(sb)
}

// 整段（显示）公式：<m:oMathPara><m:oMath>…</m:oMath></m:oMathPara>。
pub func omath_para(parts: table<string>) -> string {
    return "<m:oMathPara>" + inline(parts) + "</m:oMathPara>"
}

// 分数 a/b：<m:f><m:num>a</m:num><m:den>b</m:den></m:f>。
pub func frac(numerator: string, den: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<m:f>")
    sb_append(sb, "<m:num>")
    sb_append(sb, numerator)
    sb_append(sb, "</m:num>")
    sb_append(sb, "<m:den>")
    sb_append(sb, den)
    sb_append(sb, "</m:den>")
    sb_append(sb, "</m:f>")
    return sb_build(sb)
}

// 下标 base_sub：<m:sSub><m:e>base</m:e><m:sub>sub</m:sub></m:sSub>。
pub func ssub(base: string, sub: string) -> string {
    return "<m:sSub>" + math_e(base) + math_sub(sub) + "</m:sSub>"
}

// 上标 base^sup：<m:sSup><m:e>base</m:e><m:sup>sup</m:sup></m:sSup>。
pub func ssup(base: string, sup: string) -> string {
    return "<m:sSup>" + math_e(base) + math_sup(sup) + "</m:sSup>"
}

// 定界符（括号包裹）inner，beg/end 为左右括号字符（默认圆括号）。
pub func delimit(inner: string, beg: string, end: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<m:d>")
    sb_append(sb, "<m:dPr>")
    sb_append(sb, "<m:begChr m:val=\"")
    sb_append(sb, beg)
    sb_append(sb, "\"/>")
    sb_append(sb, "<m:endChr m:val=\"")
    sb_append(sb, end)
    sb_append(sb, "\"/>")
    sb_append(sb, "</m:dPr>")
    sb_append(sb, math_e(inner))
    sb_append(sb, "</m:d>")
    return sb_build(sb)
}

// 求和/积分/累加等 n-ary 算子：<m:nary>+<m:naryPr><m:chr m:val="op"/></m:naryPr>
// +<m:sub>sub</m:sub><m:sup>sup</m:sup><m:e>inner</m:e></m:nary>。
// op 为算子字符（如 "∑" "∫" "∏"）。
pub func nary(op: string, sub: string, sup: string, inner: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<m:nary>")
    sb_append(sb, "<m:naryPr>")
    sb_append(sb, "<m:chr m:val=\"")
    sb_append(sb, op)
    sb_append(sb, "\"/>")
    sb_append(sb, "<m:limLoc m:val=\"undOvr\"/>")
    sb_append(sb, "</m:naryPr>")
    if sub != "" {
        sb_append(sb, math_sub(sub))
    }
    if sup != "" {
        sb_append(sb, math_sup(sup))
    }
    sb_append(sb, math_e(inner))
    sb_append(sb, "</m:nary>")
    return sb_build(sb)
}

// ---- 扩展数学结构（矩阵/根号/组合/快捷算子/上下标/上划线）----

// 求和快捷：∑_{sub}^{sup} inner。
pub func sum(sub: string, sup: string, inner: string) -> string {
    return nary("∑", sub, sup, inner)
}

// 连乘快捷：∏_{sub}^{sup} inner。
pub func prod(sub: string, sup: string, inner: string) -> string {
    return nary("∏", sub, sup, inner)
}

// 积分快捷：∫_{sub}^{sup} inner。
pub func integral(sub: string, sup: string, inner: string) -> string {
    return nary("∫", sub, sup, inner)
}

// 极限：lim_{sub} inner（lim 下标位于算子正下方）。
pub func lim(sub: string, inner: string) -> string {
    return nary("lim", sub, "", inner)
}

// 平方根：√inner（度数隐藏）。
pub func sqrt(inner: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<m:rad><m:radPr><m:degHide m:val=\"on\"/></m:radPr><m:deg/>")
    sb_append(sb, math_e(inner))
    sb_append(sb, "</m:rad>")
    return sb_build(sb)
}

// n 次根：root(deg, inner)（如 cube root）。
pub func root(deg: string, inner: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<m:rad>")
    sb_append(sb, "<m:deg>")
    sb_append(sb, deg)
    sb_append(sb, "</m:deg>")
    sb_append(sb, math_e(inner))
    sb_append(sb, "</m:rad>")
    return sb_build(sb)
}

// 组合数 (n¦k)：无横线堆叠（frac type=noBar），配合 delimit() 加括号。
pub func binom(top: string, bottom: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<m:f><m:fPr><m:type m:val=\"noBar\"/></m:fPr>")
    sb_append(sb, "<m:num>")
    sb_append(sb, top)
    sb_append(sb, "</m:num>")
    sb_append(sb, "<m:den>")
    sb_append(sb, bottom)
    sb_append(sb, "</m:den>")
    sb_append(sb, "</m:f>")
    return sb_build(sb)
}

// 矩阵：rows 为二维行表，<m:m> 内含 <m:mr><m:e>…</m:e></m:mr> 行；
// m:mcs 的 count 取各行最大列数（列居中对齐）。
pub func matrix(rows: table<table<string>>) -> string {
    var ncols: i64 = 0
    var r: i64 = 0
    while r < len(rows) {
        if len(rows[r]) > ncols {
            ncols = len(rows[r])
        }
        r = r + 1
    }
    if ncols == 0 {
        ncols = 1
    }
    var sb = string_builder()
    sb_append(sb, "<m:m><m:mPr><m:mcs><m:mc><m:mcPr>")
    sb_append(sb, "<m:count m:val=\"")
    sb_append(sb, i2s(ncols))
    sb_append(sb, "\"/><m:mcJc m:val=\"center\"/>")
    sb_append(sb, "</m:mcPr></m:mc></m:mcs></m:mPr>")
    r = 0
    while r < len(rows) {
        sb_append(sb, "<m:mr>")
        var c: i64 = 0
        while c < ncols {
            var cell: string = " "
            if c < len(rows[r]) {
                cell = rows[r][c]
            }
            sb_append(sb, "<m:e>")
            sb_append(sb, cell)
            sb_append(sb, "</m:e>")
            c = c + 1
        }
        sb_append(sb, "</m:mr>")
        r = r + 1
    }
    sb_append(sb, "</m:m>")
    return sb_build(sb)
}

// 同时上下标：base_sub^sup（m:sSubSup）。
pub func ssubsup(base: string, sub: string, sup: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<m:sSubSup>")
    sb_append(sb, math_e(base))
    sb_append(sb, math_sub(sub))
    sb_append(sb, math_sup(sup))
    sb_append(sb, "</m:sSubSup>")
    return sb_build(sb)
}

// 上划线（共轭/均值）：<m:bar> pos=top。
pub func bar(inner: string) -> string {
    var sb = string_builder()
    sb_append(sb, "<m:bar><m:barPr><m:pos m:val=\"top\"/></m:barPr>")
    sb_append(sb, math_e(inner))
    sb_append(sb, "</m:bar>")
    return sb_build(sb)
}

// ---- 内部私有辅助 ----

// <m:e> 基础元素包裹（分数/上下标/定界符的"主体"）。
func math_e(frag: string) -> string {
    return "<m:e>" + frag + "</m:e>"
}

func math_sub(frag: string) -> string {
    return "<m:sub>" + frag + "</m:sub>"
}

func math_sup(frag: string) -> string {
    return "<m:sup>" + frag + "</m:sup>"
}

// 把多个片段（子结构）顺序 sb_append 进去。
func append_all(sb: i64, parts: table<string>) -> void {
    var i: i64 = 0
    while i < len(parts) {
        sb_append(sb, parts[i])
        i = i + 1
    }
}

// i64 → 十进制字符串（矩阵 count 等数值拼装；模块自包含）。
func i2s(v: i64) -> string {
    if v == 0 {
        return "0"
    }
    var sb = string_builder()
    var neg = false
    var x: i64 = v
    if x < 0 {
        neg = true
        x = 0 - x
    }
    var digs = table_new_i64()
    while x > 0 {
        table_push(digs, x % 10)
        x = x / 10
    }
    if neg {
        sb_append(sb, "-")
    }
    var i: i64 = len(digs) - 1
    while i >= 0 {
        sb_append_byte(sb, 48 + digs[i])
        i = i - 1
    }
    return sb_build(sb)
}

}   // namespace omml