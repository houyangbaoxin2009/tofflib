// tofflib 门面示例：hello.tdoc
// 文档即数据：块流由 load_file 装载，四个后端渲染同一份内容。
[
    "title": "tofflib 示例",
    "blocks": [
        ["cover", "tofflib 示例", "tdoc 文档源 · 四后端渲染"],
        ["toc", 2],
        ["h1", "第一章 入门"],
        ["p", "这份文档来自 td 文档源，而不是 tie 源码。"],
        ["b", "一个文档源，四种产物。"],
        ["ul", ["docx：Office 办公文档", "xlsx：表格", "pptx：演示稿", "pdf：印刷用排版"]],
        ["h2", "表格"],
        ["tblw", ["能力", "状态"], ["表格", "已支持"], ["代码块", "已支持"], ["页脚页码", "PDF 支持"], [1800, 7560]],
        ["h2", "代码"],
        ["code", "tie", "pub func main() -> i64 {\n    return 0\n}"],
        ["note", "示例覆盖了正文、列表、表格、代码与分页。"],
        ["quote", "统一格式的价值在于：一份数据源，四处呈现。"],
        ["hr"],
        ["cap", "表：能力覆盖"],
        ["para", "混排：", "b|加粗", " + ", "m|等宽", " + ", "link|项目主页|https://github.com/tie-lang/tie", " + 普通文本。"],
        ["right", "右对齐：2026-10-25 · tofflib"],
        ["just", "两端对齐演示：这是一段用于验证中文两端对齐的样例文本，行首与行尾都应贴齐栏宽边界，末行保持自然结束不做拉伸处理，便于观察对齐效果是否稳定。"],
        ["page"],
        ["h1", "第二章 结构"],
        ["p", "块流是扁平 table<string>，一行一块。"],
        ["link", "项目主页", "https://github.com/tie-lang/tie"],
    ],
]
