type tie<logic>
// ============================================================================
// gen_docx.tie：tofflib 端到端示例——一份完整 .docx
// （目录/标题/列表/高级表格/链接/分节/页眉页码）
// 运行：tiec examples\gen_docx.tie -o examples\gen_docx.exe
//      examples\gen_docx.exe    # 在仓库根生成 demo.docx，双击可用 Word 打开
// ============================================================================

import "../docx.tie" as dx
import "../officeutil.tie" as ou
import "../ooxml.tie" as ox

// 表格：表头合并跨列 + 主题底纹 + 对齐的列数据。
func demo_table() -> string {
    var hdr_row = table_new_string()
    table_push(hdr_row, dx.tchead("进度汇总", 2, dx.theme("accent1"), "center"))
    var r1 = table_new_string()
    table_push(r1, dx.tc("写文档", 1, "", "left"))
    table_push(r1, dx.tc("完成", 1, "", "center"))
    var r2 = table_new_string()
    table_push(r2, dx.tc("打包验证", 1, "", "left"))
    table_push(r2, dx.tc("进行中", 1, "", "center"))
    var rows = [r1, r2]
    var gw = table_new_i64()
    table_push(gw, 3400)
    table_push(gw, 1600)
    return dx.tbl_full(rows, hdr_row, gw, 5000)
}

func main() {
    var body = dx.toc(1, 3, "") +
        dx.heading("周报", 1) +
        dx.paragraph_runs([dx.run_font("你好，tie 办公——端到端 docx", "宋体", 22, true)]) +
        dx.para_ex([dx.run_color("要点用主题色标注：", dx.theme("accent6"))], "", 0, 0, 0) +
        dx.bullets(["写文档", "跑测试", "打包验证"], 0) +
        dx.numbers(["第一步", "第二步", "第三步"], 0) +
        demo_table() +
        dx.link("tie 语言官网", "https://github.com/tie-lang", "打开 tie-lang") +
        dx.sect_page(0, 0, 1440, 1800, 1440, 1800) +
        dx.heading("第二页", 2) +
        dx.paragraph("新节由 sect_page() 分段；页眉/页脚作用于全文，目录在 Word 中右键更新。")

    var hdr = dx.header_para([dx.run_font("盘点周报", "宋体", 18, false)])
    var ftr = dx.footer_para([dx.page_field()])

    if ox.write_docx_hbf("demo.docx", body, hdr, ftr) {
        println("已生成 demo.docx（目录/高级表格/链接/分节/页眉页码）")
    } else {
        println("写入失败")
    }
}