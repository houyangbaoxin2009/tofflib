type tie<logic>
// ============================================================================
// gen_docx.tie：tofflib 门面端到端示例——一份完整 .docx
// （目录 / 标题 / 加粗 / 提示 / 列表 / 表格 / 代码块 / 链接 / 分节 / 分页）
// 运行：tiec examples\gen_docx.tie -o target\gen_docx.exe
//      target\gen_docx.exe    # 在仓库根生成 demo.docx，双击可用 Word 打开
// ============================================================================

import "../src/tofflib.tie" as tl

func main() {
    var d = tl.new_doc("tofflib 端到端示例")
    tl.toc(d, 2)
    tl.h1(d, "周报")
    tl.p(d, "tie 办公文档——同一份块流可导出 docx / xlsx / pptx / pdf。")
    tl.bold(d, "要点：块流是唯一中间表示，后端只负责各自格式的落地。")
    tl.note(d, "提示：目录在 Word 中右键「更新域」后展开。")
    tl.h2(d, "本周进展")
    var items: table<string> = []
    table_push(items, "块流模型与 td 文档源")
    table_push(items, "四后端渲染")
    table_push(items, "字体内嵌子集化")
    tl.ul(d, items)
    var steps: table<string> = []
    table_push(steps, "写文档")
    table_push(steps, "跑测试")
    table_push(steps, "打包验证")
    tl.ol(d, steps)
    tl.h2(d, "进度表")
    var hdr: table<string> = []
    table_push(hdr, "任务")
    table_push(hdr, "状态")
    var rows: table<string> = []
    table_push(rows, "写文档")
    table_push(rows, "完成")
    table_push(rows, "打包验证")
    table_push(rows, "进行中")
    tl.tbl(d, hdr, rows)
    tl.h2(d, "代码")
    tl.codeblock(d, "tie", "var d = tl.new_doc(\"示例\")\ntl.p(d, \"hello\")\ntl.docx(\"demo.docx\", d)")
    tl.link(d, "tie 语言官网", "https://github.com/tie-lang")
    tl.page(d)
    tl.sec(d, "第二页")
    tl.p(d, "新节由 sec() 分段；页眉/页脚作用于全文。")

    if tl.docx("demo.docx", d) {
        println("已生成 demo.docx（目录/列表/表格/代码块/链接/分节）")
    } else {
        println("写入失败")
    }
}
