type tie<logic>
// ============================================================================
// probe.tie：tofflib 冒烟验证（logic 可执行入口，仅本地验证用，不入库语义核心）
// 覆盖 4 个模块的全部 pub 接口（精确断言 + 子串断言）。
// 运行：tiec probe.tie -o probe.exe && probe.exe；任一断言不符即 panic（非零退出）。
// ============================================================================

import "../docx.tie" as dx
import "../omml.tie" as mm
import "../vml.tie" as vm
import "../officeutil.tie" as ou
import "../ooxml.tie" as ox
import "../xlsx.tie" as xs
import "../tiedoc.tie" as td
import "../pptx.tie" as ppx

// 断言 helper：got != want 时 panic 并指出模块/用例。
func check(name: string, got: string, want: string) {
    if got != want {
        panic("FAIL " + name + ": got <" + got + "> want <" + want + ">")
    }
    println("OK " + name)
}

func main() {
    // ================= docx：全部 8 个 pub 接口 =================
    check("dx.escape", dx.escape("a&b<c>d"), "a&amp;b&lt;c&gt;d")
    check("dx.run", dx.run("你好"), "<w:r><w:t xml:space=\"preserve\">你好</w:t></w:r>")
    check("dx.run_font",
        dx.run_font("加粗", "宋体", 22, true),
        "<w:r><w:rPr><w:rFonts w:ascii=\"宋体\" w:hAnsi=\"宋体\" w:eastAsia=\"宋体\"/><w:sz w:val=\"22\"/><w:b/></w:rPr>" +
        "<w:t xml:space=\"preserve\">加粗</w:t></w:r>")
    check("dx.run_font-none",
        dx.run_font("x", "", 0, false),
        "<w:r><w:rPr></w:rPr><w:t xml:space=\"preserve\">x</w:t></w:r>")
    check("dx.paragraph",
        dx.paragraph("z"),
        "<w:p><w:r><w:t xml:space=\"preserve\">z</w:t></w:r></w:p>")
    var pr = table_new_string()
    table_push(pr, dx.run("a"))
    table_push(pr, dx.run("b"))
    check("dx.paragraph_runs",
        dx.paragraph_runs(pr),
        "<w:p><w:r><w:t xml:space=\"preserve\">a</w:t></w:r><w:r><w:t xml:space=\"preserve\">b</w:t></w:r></w:p>")
    check("dx.root_open",
        dx.root_open(),
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" +
        "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\" " +
        "xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">" +
        "<w:body>")
    check("dx.root_close", dx.root_close(), "</w:body></w:document>")

    var h = table_new_string()
    table_push(h, "列A")
    table_push(h, "列B")
    var r1 = table_new_string()
    table_push(r1, "1")
    table_push(r1, "甲")
    var r2 = table_new_string()
    table_push(r2, "2")
    table_push(r2, "乙")
    var rows = [r1, r2]
    var txml = dx.tbl(rows, h, 100)
    check("dx.tbl-width", has(txml, "<w:tblW w:w=\"100\""), "true")
    check("dx.tbl-border", has(txml, "<w:tblBorders><w:top w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/>"), "true")
    check("dx.tbl-boldheader", has(txml, "<w:b/>"), "true")
    var empty_h = table_new_string()
    var tplain = dx.tbl(rows, empty_h, 0)
    check("dx.tbl-defaultwidth", has(tplain, "<w:tblW w:w=\"9360\""), "true")
    check("dx.tbl-nobold", has(tplain, "<w:b/>"), "false")

    // ---- docx blocks（t3 扩展）----
    check("dx.heading", dx.heading("章标题", 1),
        "<w:p><w:pPr><w:pStyle w:val=\"Heading1\"/></w:pPr><w:r><w:t xml:space=\"preserve\">章标题</w:t></w:r></w:p>")
    check("dx.heading-clamp", has(dx.heading("x", 15), "w:val=\"Heading9\""), "true")
    check("dx.bullet", dx.bullet("事项", 0),
        "<w:p><w:pPr><w:numPr><w:ilvl w:val=\"0\"/><w:numId w:val=\"1\"/></w:numPr></w:pPr><w:r><w:t xml:space=\"preserve\">事项</w:t></w:r></w:p>")
    check("dx.number", dx.number("第一", 0),
        "<w:p><w:pPr><w:numPr><w:ilvl w:val=\"0\"/><w:numId w:val=\"2\"/></w:numPr></w:pPr><w:r><w:t xml:space=\"preserve\">第一</w:t></w:r></w:p>")
    var litems = table_new_string()
    table_push(litems, "a")
    table_push(litems, "b")
    check("dx.bullets", dx.bullets(litems, 1),
        "<w:p><w:pPr><w:numPr><w:ilvl w:val=\"1\"/><w:numId w:val=\"1\"/></w:numPr></w:pPr><w:r><w:t xml:space=\"preserve\">a</w:t></w:r></w:p>" +
        "<w:p><w:pPr><w:numPr><w:ilvl w:val=\"1\"/><w:numId w:val=\"1\"/></w:numPr></w:pPr><w:r><w:t xml:space=\"preserve\">b</w:t></w:r></w:p>")
    check("dx.numbers", dx.numbers(litems, 0),
        "<w:p><w:pPr><w:numPr><w:ilvl w:val=\"0\"/><w:numId w:val=\"2\"/></w:numPr></w:pPr><w:r><w:t xml:space=\"preserve\">a</w:t></w:r></w:p>" +
        "<w:p><w:pPr><w:numPr><w:ilvl w:val=\"0\"/><w:numId w:val=\"2\"/></w:numPr></w:pPr><w:r><w:t xml:space=\"preserve\">b</w:t></w:r></w:p>")
    check("dx.page_break", dx.page_break(), "<w:p><w:r><w:br w:type=\"page\"/></w:r></w:p>")
    check("dx.page_field", dx.page_field(),
        "<w:r><w:fldChar w:fldCharType=\"begin\"/></w:r><w:r><w:instrText xml:space=\"preserve\"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType=\"end\"/></w:r>")
    var pf = table_new_string()
    table_push(pf, dx.page_field())
    check("dx.para_center", dx.para_center(pf),
        "<w:p><w:pPr><w:jc w:val=\"center\"/></w:pPr>" +
        "<w:r><w:fldChar w:fldCharType=\"begin\"/></w:r><w:r><w:instrText xml:space=\"preserve\"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType=\"end\"/></w:r></w:p>")
    check("dx.para_right", has(dx.para_right(pf), "w:jc w:val=\"right\""), "true")
    check("dx.sect_a4", dx.sect_a4(),
        "<w:sectPr><w:pgSz w:w=\"11906\" w:h=\"16838\"/><w:pgMar w:top=\"1440\" w:right=\"1800\" w:bottom=\"1440\" w:left=\"1800\" w:header=\"720\" w:footer=\"720\" w:gutter=\"0\"/></w:sectPr>")
    check("dx.sect_page-default", has(dx.sect_page(0, 0, 1, 2, 3, 4), "w:pgSz w:w=\"11906\" w:h=\"16838\""), "true")
    check("dx.tbl_borders-red",
        has(dx.tbl_borders(8, "FF0000"), "<w:top w:val=\"single\" w:sz=\"8\" w:space=\"0\" w:color=\"FF0000\"/>"), "true")

    // ---- docx 表格高级（tc/tchead/tc_w/tbl_full）----
    check("dx.tc-plain", dx.tc("x", 1, "", ""),
        "<w:tc><w:p><w:r><w:t xml:space=\"preserve\">x</w:t></w:r></w:p></w:tc>")
    check("dx.tc-merge", has(dx.tc("标题", 2, "", ""), "<w:gridSpan w:val=\"2\"/>"), "true")
    check("dx.tc-shade", has(dx.tc("备注", 1, "D9E2F3", ""), "<w:shd w:val=\"clear\" w:fill=\"D9E2F3\"/>"), "true")
    check("dx.tc-align", has(dx.tc("值", 1, "", "center"), "<w:pPr><w:jc w:val=\"center\"/>"), "true")
    check("dx.tchead-bold", has(dx.tchead("合计", 1, "", ""), "<w:b/>"), "true")
    check("dx.tc_w-width", has(dx.tc_w("列", 1000), "<w:tcW w:w=\"1000\" w:type=\"dxa\"/>"), "true")
    var hdr_row = table_new_string()
    table_push(hdr_row, dx.tchead("事项", 2, "D9E2F3", "center"))
    var td1 = table_new_string()
    table_push(td1, dx.tc("写文档", 1, "", ""))
    table_push(td1, dx.tc("完成", 1, "", "center"))
    var td2 = table_new_string()
    table_push(td2, dx.tc("打包验证", 1, "", ""))
    table_push(td2, dx.tc("进行中", 1, "", "center"))
    var adv_rows = [td1, td2]
    var gw = table_new_i64()
    table_push(gw, 3200)
    table_push(gw, 1800)
    var ftbl = dx.tbl_full(adv_rows, hdr_row, gw, 5000)
    check("dx.tbl_full-grid", has(ftbl, "<w:tblGrid><w:gridCol w:w=\"3200\"/><w:gridCol w:w=\"1800\"/>"), "true")
    check("dx.tbl_full-repeat", has(ftbl, "<w:trPr><w:tblHeader/>"), "true")
    check("dx.tbl_full-cells", has(ftbl, "<w:tc><w:tcPr><w:gridSpan w:val=\"2\"/>"), "true")

    // ---- docx 域：目录 / 题注 / 交叉引用 / 书签 ----
    check("dx.toc-instr", has(dx.toc(1, 3, ""), "<w:instrText xml:space=\"preserve\"> TOC \\o \"1-3\" \\h \\z \\u "), "true")
    check("dx.toc-fld", has(dx.toc(1, 1, "占位"), "<w:fldChar w:fldCharType=\"begin\"/>"), "true")
    check("dx.toc-placeholder", has(dx.toc(1, 2, "占位"), "占位"), "true")
    check("dx.caption-seq", has(dx.caption("图例", "图"), " SEQ 图 \\* ARABIC "), "true")
    check("dx.caption-para", has(dx.caption("图例", "图"), "<w:p>"), "true")
    check("dx.xref-instr", has(dx.xref("fig1", "第1章"), " REF fig1 \\h "), "true")
    check("dx.bookmark", dx.bookmark_start("fig1", 1) + dx.bookmark_end(1),
        "<w:bookmarkStart w:id=\"1\" w:name=\"fig1\"/><w:bookmarkEnd w:id=\"1\"/>")

    // ---- docx 样式与主题（para_ex/link/run_color/theme）----
    var pp = table_new_string()
    table_push(pp, dx.run("正文"))
    check("dx.para_ex-spacing",
        dx.para_ex(pp, "right", 240, 120, 0),
        "<w:p><w:pPr><w:jc w:val=\"right\"/><w:spacing w:before=\"240\" w:after=\"120\"/></w:pPr>" +
        "<w:r><w:t xml:space=\"preserve\">正文</w:t></w:r></w:p>")
    check("dx.para_ex-indent",
        has(dx.para_ex(pp, "", 0, 0, 720), "<w:ind w:left=\"720\"/>"), "true")
    check("dx.para_ex-plain", dx.para_ex(pp, "", 0, 0, 0),
        "<w:p><w:r><w:t xml:space=\"preserve\">正文</w:t></w:r></w:p>")
    check("dx.link-instr",
        has(dx.link("tie 官网", "https://tie-lang.org", "打开"), " HYPERLINK &quot;https://tie-lang.org&quot; \\o &quot;打开&quot; "), "true")
    check("dx.link-color", has(dx.link("tie 官网", "https://tie-lang.org", ""), "<w:color w:val=\"0563C1\"/><w:u w:val=\"single\"/>"), "true")
    check("dx.run_color", dx.run_color("红", "C00000"),
        "<w:r><w:rPr><w:color w:val=\"C00000\"/></w:rPr><w:t xml:space=\"preserve\">红</w:t></w:r>")
    check("dx.theme-accent1", dx.theme("accent1"), "4472C4")
    check("dx.theme-accent4", dx.theme("accent4"), "FFC000")
    check("dx.theme-dark2", dx.theme("dark2"), "44546A")
    check("dx.theme-unknown", dx.theme("nope"), "000000")

    // ================= omml：全部 10 个 pub 接口 =================
    check("mm.escape", mm.escape("a&b<c"), "a&amp;b&lt;c")
    check("mm.r", mm.r("x"), "<m:r><m:t>x</m:t></m:r>")
    check("mm.raw", mm.raw("<x/>"), "<x/>")
    var ip = table_new_string()
    table_push(ip, mm.r("a"))
    table_push(ip, mm.r("b"))
    check("mm.inline",
        mm.inline(ip),
        "<m:oMath><m:r><m:t>a</m:t></m:r><m:r><m:t>b</m:t></m:r></m:oMath>")
    check("mm.omath_para",
        mm.omath_para(ip),
        "<m:oMathPara><m:oMath><m:r><m:t>a</m:t></m:r><m:r><m:t>b</m:t></m:r></m:oMath></m:oMathPara>")
    check("mm.frac", mm.frac("num", "den"), "<m:f><m:num>num</m:num><m:den>den</m:den></m:f>")
    check("mm.ssub", mm.ssub(mm.r("x"), mm.r("i")),
        "<m:sSub><m:e><m:r><m:t>x</m:t></m:r></m:e><m:sub><m:r><m:t>i</m:t></m:r></m:sub></m:sSub>")
    check("mm.ssup", mm.ssup(mm.r("x"), mm.r("2")),
        "<m:sSup><m:e><m:r><m:t>x</m:t></m:r></m:e><m:sup><m:r><m:t>2</m:t></m:r></m:sup></m:sSup>")
    check("mm.delimit", mm.delimit("in", "(", ")"),
        "<m:d><m:dPr><m:begChr m:val=\"(\"/><m:endChr m:val=\")\"/></m:dPr><m:e>in</m:e></m:d>")
    var nary = mm.nary("∑", "sub", "sup", "in")
    check("mm.nary-op", has(nary, "<m:chr m:val=\"∑\"/>"), "true")
    check("mm.nary-limloc", has(nary, "<m:limLoc m:val=\"undOvr\"/>"), "true")
    check("mm.nary-bounds", has(nary, "<m:sub>sub</m:sub><m:sup>sup</m:sup>"), "true")

    // ---- omml 扩展（根号/矩阵/组合/快捷算子/上下标/上划线）----
    check("mm.sqrt", mm.sqrt(mm.r("x")),
        "<m:rad><m:radPr><m:degHide m:val=\"on\"/></m:radPr><m:deg/><m:e><m:r><m:t>x</m:t></m:r></m:e></m:rad>")
    check("mm.root", mm.root(mm.r("3"), mm.r("x")),
        "<m:rad><m:deg><m:r><m:t>3</m:t></m:r></m:deg><m:e><m:r><m:t>x</m:t></m:r></m:e></m:rad>")
    check("mm.binom", mm.binom("n", "k"),
        "<m:f><m:fPr><m:type m:val=\"noBar\"/></m:fPr><m:num>n</m:num><m:den>k</m:den></m:f>")
    check("mm.sum-op", has(mm.sum("i", "n", "a"), "<m:chr m:val=\"∑\"/>"), "true")
    check("mm.sum-bounds", has(mm.sum("i", "n", "a"), "<m:sub>i</m:sub><m:sup>n</m:sup>"), "true")
    check("mm.prod-op", has(mm.prod("j", "m", "b"), "<m:chr m:val=\"∏\"/>"), "true")
    check("mm.integral-op", has(mm.integral("0", "1", "f"), "<m:chr m:val=\"∫\"/>"), "true")
    check("mm.lim-op", has(mm.lim("x->0", "f"), "<m:chr m:val=\"lim\"/>"), "true")
    check("mm.lim-nosup", has(mm.lim("x->0", "f"), "<m:sup>"), "false")
    check("mm.ssubsup", mm.ssubsup(mm.r("x"), "i", "n"),
        "<m:sSubSup><m:e><m:r><m:t>x</m:t></m:r></m:e><m:sub>i</m:sub><m:sup>n</m:sup></m:sSubSup>")
    check("mm.bar", mm.bar("z"),
        "<m:bar><m:barPr><m:pos m:val=\"top\"/></m:barPr><m:e>z</m:e></m:bar>")
    var mr1 = table_new_string()
    table_push(mr1, "a")
    table_push(mr1, "b")
    var mr2 = table_new_string()
    table_push(mr2, "c")
    table_push(mr2, "d")
    var mrows = [mr1, mr2]
    var mtx = mm.matrix(mrows)
    check("mm.matrix-count", has(mtx, "<m:count m:val=\"2\"/>"), "true")
    check("mm.matrix-rows", has(mtx, "<m:mr><m:e>a</m:e><m:e>b</m:e></m:mr>"), "true")
    check("mm.matrix-rows2", has(mtx, "<m:mr><m:e>c</m:e><m:e>d</m:e></m:mr>"), "true")

    // ================= vml：全部 5 个 pub 接口 =================
    check("vm.escape", vm.escape("a&b"), "a&amp;b")
    var rect = vm.rect(10, 10, 120, 40, "标题&备注")
    check("vm.rect-pos", has(rect,
        "<v:rect style=\"position:absolute;left:pt(10);top:pt(10);width:pt(120);height:pt(40)\""), "true")
    check("vm.rect-esc", has(rect, "标题&amp;备注"), "true")
    check("vm.rect-textbox", has(rect, "<w:txbxContent>"), "true")
    var line = vm.line(10, 60, 130, 60, "classic", 2)
    check("vm.line-fromto", has(line, "from=\"10,60\" to=\"130,60\""), "true")
    check("vm.line-arrow", has(line, "endarrow=\"classic\""), "true")
    check("vm.line-strokew", has(line, "strokeweight=\"2pt\""), "true")
    var line2 = vm.line(1, 2, 3, 4, "", 0)
    check("vm.line-noarrow", has(line2, "endarrow"), "false")
    check("vm.line-nostrokew", has(line2, "strokeweight"), "false")
    var grp = vm.group([rect, line], 200, 100)
    check("vm.group-open",
        has(grp, "<v:group style=\"position:relative;width:pt(200);height:pt(100)\" coordorigin=\"0,0\" coordsize=\"200,100\">"),
        "true")
    check("vm.group-children", has(grp, "</v:group>"), "true")
    var tb = vm.textbox(5, 5, 80, 30, "备注")
    check("vm.textbox-fill", has(tb, "fill=\"f\""), "true")
    check("vm.textbox-body", has(tb, "<v:textbox><w:txbxContent>"), "true")

    // ================= officeutil：全部 10 个 pub 接口 =================
    check("ou.pad2-7", ou.pad2(7), "07")
    check("ou.pad2-10", ou.pad2(10), "10")
    check("ou.pad2-999", ou.pad2(999), "999")
    check("ou.pad2-neg", ou.pad2(-1), "00")
    check("ou.fmt_date", ou.fmt_date(2026, 8, 5), "2026-08-05")
    check("ou.fmt_datetime", ou.fmt_datetime(2026, 8, 30, 9, 5, 7), "2026-08-30 09:05:07")
    check("ou.csv_cell-plain", ou.csv_cell("x", ","), "x")
    check("ou.csv_cell-sep", ou.csv_cell("b,c", ","), "\"b,c\"")
    check("ou.csv_cell-quote", ou.csv_cell("a\"b", ","), "\"a\"\"b\"")
    var l1 = table_new_string()
    table_push(l1, "a")
    table_push(l1, "b,c")
    table_push(l1, "x")
    check("ou.csv_line-quote", ou.csv_line(l1, ","), "a,\"b,c\",x")
    var c1 = table_new_string()
    table_push(c1, "a")
    table_push(c1, "b")
    var c2 = table_new_string()
    table_push(c2, "c")
    table_push(c2, "d")
    var crow = [c1, c2]
    check("ou.csv_text", ou.csv_text(crow, ","), "a,b\nc,d")
    var hd = table_new_string()
    table_push(hd, "a")
    table_push(hd, "bb")
    var rd = table_new_string()
    table_push(rd, "1")
    table_push(rd, "2")
    var rd2 = table_new_string()
    table_push(rd2, "3")
    table_push(rd2, "4")
    var rrows = [rd, rd2]
    check("ou.render_table",
        ou.render_table(hd, rrows, " | ", 1),
        "a  | bb \n--------\n1  | 2  \n3  | 4  \n")
    check("ou.todo", ou.todo("", ["写报告"]), "- [ ] 写报告\n")
    check("ou.todo-title", ou.todo("标题", ["a", "b"]), "标题\n- [ ] a\n- [ ] b\n")
    check("ou.todo_done", ou.todo_done("", ["准备"]), "- [x] 准备\n")
    check("ou.list_items", ou.list_items("", ["准备"]), "1. 准备\n")
    check("ou.list_items-title", ou.list_items("标题", ["a", "b"]), "标题\n1. a\n2. b\n")

    // ================= ooxml：CRC32 / zip / 装配 / 写出 =================
    check_i64("ox.crc32-empty", ox.crc32(""), 0)
    check_i64("ox.crc32-abc", ox.crc32("abc"), 0x352441C2)
    check_i64("ox.crc32-123456789", ox.crc32("123456789"), 0xCBF43926)
    var zn = table_new_string()
    table_push(zn, "a.txt")
    var zd = table_new_string()
    table_push(zd, "hello")
    var zbin = ox.zip_store(zn, zd)
    check("ox.zip-local-sig", byte_eq(zbin, 0, 0x50), "true")
    check("ox.zip-local-sig3", byte_eq(zbin, 3, 0x04), "true")
    check("ox.zip-name-off", byte_eq(zbin, 30, 97), "true")
    check("ox.zip-data-off", byte_eq(zbin, 35, 104), "true")
    check("ox.zip-eocd-sig", byte_eq(zbin, len(zbin) - 22, 0x50), "true")
    check("ox.zip-eocd-sig3", byte_eq(zbin, len(zbin) - 19, 0x06), "true")
    var oxbody = dx.paragraph("打包测试")
    var (pnames, pdatas) = ox.docx_parts(oxbody, false)
    check_i64("ox.parts-count", len(pnames), 6)
    check("ox.parts-name0", pnames[0], "[Content_Types].xml")
    check("ox.parts-ct", has(pdatas[0], "wordprocessingml.document.main+xml"), "true")
    check("ox.parts-noftrref", has(pdatas[2], "<w:footerReference"), "false")
    check("ox.parts-numbering", has(pdatas[4], "<w:num w:numId=\"1\">"), "true")
    var (pn2, pd2) = ox.docx_parts(oxbody, true)
    check_i64("ox.parts-ftr-count", len(pn2), 7)
    check("ox.parts-ftr-ref", has(pd2[2], "<w:footerReference w:type=\"default\" r:id=\"rId3\"/>"), "true")
    check("ox.parts-ftr-part", has(pd2[6], "<w:ftr"), "true")
    var wrote = ox.write_docx("demo_out.docx", oxbody, true)
    var exists: string = "false"
    if wrote {
        if file_exists("demo_out.docx") {
            exists = "true"
        }
    }
    check("ox.write_docx-exists", exists, "true")
    check("ox.write_docx-pk", file_pk("demo_out.docx"), "true")

    // ---- ooxml 页眉页脚（docx_parts_hbf / write_docx_hbf）----
    var hdr = dx.header_para([dx.run("tofflib 演示")])
    check("dx.header_para", hdr,
        "<w:hdr xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">" +
        "<w:p><w:r><w:t xml:space=\"preserve\">tofflib 演示</w:t></w:r></w:p></w:hdr>")
    var ftr = dx.footer_para([dx.page_field()])
    check("dx.footer_para", has(ftr, "<w:ftr xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\"><w:p>"), "true")
    check("dx.footer_para-page", has(ftr, "PAGE"), "true")
    var (pn3, pd3) = ox.docx_parts_hbf(oxbody, hdr, ftr)
    check_i64("ox.hbf-count", len(pn3), 8)
    check("ox.hbf-header-part", pn3[6], "word/header1.xml")
    check("ox.hbf-footer-part", pn3[7], "word/footer1.xml")
    check("ox.hbf-hdr-ref", has(pd3[2], "<w:headerReference w:type=\"default\" r:id=\"rId4\"/>"), "true")
    check("ox.hbf-ftr-ref", has(pd3[2], "<w:footerReference w:type=\"default\" r:id=\"rId3\"/>"), "true")
    check("ox.hbf-ct", has(pd3[0], "wordprocessingml.header+xml"), "true")
    var wrote_hbf = ox.write_docx_hbf("demo_hbf.docx", oxbody, hdr, ftr)
    var exists_hbf: string = "false"
    if wrote_hbf {
        if file_exists("demo_hbf.docx") {
            exists_hbf = "true"
        }
    }
    check("ox.hbf-write-exists", exists_hbf, "true")
    check("ox.hbf-write-pk", file_pk("demo_hbf.docx"), "true")

    // ================= xlsx：列号/单元格/工作表/装配/写出 =================
    check("xs.col_letter-a", xs.col_letter(1), "A")
    check("xs.col_letter-z", xs.col_letter(26), "Z")
    check("xs.col_letter-aa", xs.col_letter(27), "AA")
    check("xs.col_letter-az", xs.col_letter(52), "AZ")
    check("xs.cell_ref", xs.cell_ref(3, 2), "C2")
    check("xs.text_cell", xs.text_cell(1, 1, "你好", false),
        "<c r=\"A1\" t=\"inlineStr\"><is><r><t>你好</t></r></is></c>")
    check("xs.text_cell-bold", has(xs.text_cell(1, 1, "表头", true), "<r><rPr><b/></rPr>"), "true")
    check("xs.num_cell", xs.num_cell(1, 2, 42), "<c r=\"A2\"><v>42</v></c>")
    check("xs.formula_cell", has(xs.formula_cell(1, 3, "SUM(B1:B3)"), "<f>SUM(B1:B3)</f>"), "true")
    var xh = table_new_string()
    table_push(xh, "项目")
    table_push(xh, "分")
    var xr1 = table_new_string()
    table_push(xr1, "甲")
    table_push(xr1, "88")
    var xr2 = table_new_string()
    table_push(xr2, "乙")
    table_push(xr2, "92")
    var xrows = [xr1, xr2]
    var sdata = xs.sheet_text_rows(xrows, xh)
    check("xs.sheet_text_rows-header", has(sdata, "<row r=\"1\"><c r=\"A1\""), "true")
    check("xs.sheet_text_rows-bold", has(sdata, "<c r=\"A1\" t=\"inlineStr\"><is><r><rPr><b/></rPr>"), "true")
    check("xs.sheet_text_rows-data", has(sdata, "<row r=\"2\">"), "true")
    var xw = table_new_i64()
    table_push(xw, 18)
    table_push(xw, 10)
    var xsheet = xs.sheet_doc("数据", sdata, xw, true)
    check("xs.sheet_doc-freeze", has(xsheet, "state=\"frozen\""), "true")
    check("xs.sheet_doc-cols", has(xsheet, "<col min=\"1\" max=\"1\" width=\"18\" customWidth=\"1\"/>"), "true")
    var xsn = table_new_string()
    table_push(xsn, "数据")
    var (xn1, xd1) = xs.xlsx_parts([xsheet], xsn)
    check_i64("xs.xlsx_parts-count", len(xn1), 5)
    check("xs.xlsx_parts-wb", xn1[2], "xl/workbook.xml")
    check("xs.xlsx_parts-sheet", xn1[4], "xl/worksheets/sheet1.xml")
    check("xs.xlsx_parts-ct", has(xd1[0], "spreadsheetml.worksheet+xml"), "true")
    var wrote_x = xs.write_xlsx("demo_out.xlsx", [xsheet], xsn)
    var exists_x: string = "false"
    if wrote_x {
        if file_exists("demo_out.xlsx") {
            exists_x = "true"
        }
    }
    check("xs.write_xlsx-exists", exists_x, "true")
    check("xs.write_xlsx-pk", file_pk("demo_out.xlsx"), "true")

    // ================= tiedoc：tdoc 块协议构建 =================
    var tb0 = td.h(2, "节标题")
    check_i64("td.h-len", len(tb0), 2)
    check("td.h-kind", tb0[0], "h2")
    check("td.h-text", tb0[1], "节标题")
    check("td.h1", td.h1("x")[0], "h1")
    check("td.h9", td.h9("x")[0], "h9")
    check("td.h-clamp", td.h(99, "x")[0], "h9")
    check("td.p-kind", td.p("你好")[0], "p")
    check("td.b-text", td.b("x")[1], "x")
    check("td.center-kind", td.center("x")[0], "center")
    var tul = td.ul(["a", "b"])
    check_i64("td.ul-len", len(tul), 3)
    check("td.ul-1", tul[1], "a")
    check("td.ul-2", tul[2], "b")
    check("td.ol-kind", td.ol(["a"])[0], "ol")
    var tt = td.tbl("项目,状态", ["文档,进行中"])
    check_i64("td.tbl-len", len(tt), 3)
    check("td.tbl-hdr", tt[1], "项目,状态")
    check("td.tbl-row", tt[2], "文档,进行中")
    check("td.page-kind", td.page()[0], "page")
    check("td.sec-kind", td.sec()[0], "sec")
    check_i64("td.link-len", len(td.link("t", "u")), 3)
    check("td.raw-xml", td.raw("<x/>")[1], "<x/>")
    var trows: table<table<string>> = [td.h1("a"), td.p("b")]
    check_i64("td.rows-build", len(trows), 2)

    // ---- tiedoc 渲染 docx（CSV 解析 + 块路由）----
    var csv0 = td.csv_split("a,\"b,c\",d")
    check_i64("td.csv_split-q-len", len(csv0), 3)
    check("td.csv_split-q-1", csv0[1], "b,c")
    check_i64("td.csv_split-basic", len(td.csv_split("x,y,z")), 3)
    check("td.csv_split-esc", td.csv_split("\"a\"\"b\"")[0], "a\"b")
    var rblocks: table<table<string>> = [td.h1("章一"), td.p("正文"), td.ul(["a", "b"]), td.tbl("项目,状态", ["文档,进行中"])]
    check_i64("td.blocks-len", len(rblocks), 4)
    var drew = td.render_docx("demo_tdoc.docx", "标题", rblocks)
    var exists_d: string = "false"
    if drew {
        if file_exists("demo_tdoc.docx") {
            exists_d = "true"
        }
    }
    check("td.render_docx-exists", exists_d, "true")
    check("td.render_docx-pk", file_pk("demo_tdoc.docx"), "true")
    var rx = td.render_xlsx("demo_tdoc.xlsx", "标题", rblocks)
    var exists_rx: string = "false"
    if rx {
        if file_exists("demo_tdoc.xlsx") {
            exists_rx = "true"
        }
    }
    check("td.render_xlsx-exists", exists_rx, "true")
    check("td.render_xlsx-pk", file_pk("demo_tdoc.xlsx"), "true")

    // ================= pptx：幻灯片/主题/母版/装配/写出 =================
    var pl1 = table_new_string()
    table_push(pl1, "买牛奶")
    table_push(pl1, "写周报")
    var pslide = ppx.slide_title_bullets("周报", pl1)
    check("ppx.slide-title", has(pslide, "<p:ph type=\"title\"/>"), "true")
    check("ppx.slide-text", has(pslide, "周报"), "true")
    check("ppx.slide-bullet", has(pslide, "<a:buChar char=\"•\"/>"), "true")
    check("ppx.slide-bullet2", has(pslide, "写周报"), "true")
    var psl = table_new_string()
    table_push(psl, pslide)
    var (pn1, pd1) = ppx.pptx_parts(psl)
    check_i64("ppx.pptx_parts-count", len(pn1), 14)
    check("ppx.pptx_parts-theme", has(pd1[11], "<a:accent1><a:srgbClr val=\"4472C4\"/>"), "true")
    check("ppx.pptx_parts-master", has(pd1[7], "<p:sldMaster"), "true")
    check("ppx.pptx_parts-layoutrels", has(pd1[10], "slideMaster"), "true")
    check("ppx.pptx_parts-ct", has(pd1[0], "presentationml.slide+xml"), "true")
    var wrote_p = ppx.write_pptx("demo_out.pptx", psl)
    var exists_p: string = "false"
    if wrote_p {
        if file_exists("demo_out.pptx") {
            exists_p = "true"
        }
    }
    check("ppx.write_pptx-exists", exists_p, "true")
    check("ppx.write_pptx-pk", file_pk("demo_out.pptx"), "true")

    // ---- tiedoc → pptx 渲染（块→幻灯片映射）----
    var rp = td.render_pptx("demo_tdoc.pptx", "标题", rblocks)
    var exists_rp: string = "false"
    if rp {
        if file_exists("demo_tdoc.pptx") {
            exists_rp = "true"
        }
    }
    check("td.render_pptx-exists", exists_rp, "true")
    check("td.render_pptx-pk", file_pk("demo_tdoc.pptx"), "true")

    // 打印组装出的整段 docx 文档片段，供人工核对
    println("---- 组装示例 ----")
    println(dx.root_open() + dx.paragraph("你好，tie 办公") + txml +
        mm.omath_para(ip) + grp + dx.root_close())
    println("---- 结束 ----")
}

// 整数断言 helper（如 CRC32 向量）。
func check_i64(name: string, got: i64, want: i64) {
    if got != want {
        panic("FAIL " + name)
    }
    println("OK " + name)
}

// 取字符串第 i 字节是否等于 v（二进制断言）。
func byte_eq(s: string, i: i64, v: i64) -> string {
    if str_byte(s, i) == v {
        return "true"
    }
    return "false"
}

// 读文件并校验 ZIP 魔数 PK\x03\x04（probe 内二进制自检；byte_read 底座二进制安全）。
func file_pk(path: string) -> string {
    var t = byte_read(path)
    if len(t) > 4 && t[0] == 0x50 && t[1] == 0x4B &&
        t[2] == 0x03 && t[3] == 0x04 {
        return "true"
    }
    return "false"
}

// 子串包含判断（供 probe 断言；模块内部不含此 helper）。
func has(s: string, sub: string) -> string {
    var n: i64 = str_len(s)
    var m: i64 = str_len(sub)
    if m > n {
        return "false"
    }
    var i: i64 = 0
    while i + m <= n {
        var j: i64 = 0
        var ok = true
        while j < m {
            if str_char(s, i + j) != str_char(sub, j) {
                ok = false
                j = m
            } else {
                j = j + 1
            }
        }
        if ok {
            return "true"
        }
        i = i + 1
    }
    return "false"
}